	file.0000000000000001.title: "&6The Illustrious MFPack"
	quest.0013FD56165BCB86.quest_desc: [
		"You can also switch the look of your &6Water Wheel&r by right-clicking it with pretty much any &awood plank&r (including ones from other mods)"
	]
	quest.0013FD56165BCB86.title: "Water Wheel"
	quest.0013FD56165BCB86.quest_subtitle: "A kinetic source that uses the flow of &9water&r as its source of energy. It will generate the same amount of &6SU&r at the same &6RPM&r as long as one block of flowing &9water&r is adjacent"
	quest.002E6872C7B7AF76.quest_desc: [
		"Heated mix of two sugar and a slimeball makes four canes."
		"Compact four of those into a block for the candy tools and the music disc."
	]
	quest.002E6872C7B7AF76.quest_subtitle: "Heated mix of two sugar and a slimeball makes four canes."
	quest.002E6872C7B7AF76.title: "&eCandy Cane"
	quest.006C2440BE69D73B.quest_desc: [
		"Mix Farmer's Delight &eOrganic Compost&r with water, or Create &eTree Fertilizer&r with water, in a mixer — no heat needed."
		"Pipe the fluid into the sprinkler to bonemeal everything in the spray."
	]
	quest.006C2440BE69D73B.quest_subtitle: "Liquid Fertilizer, a new fluid that applies a bonemeal effect to blocks"
	quest.006C2440BE69D73B.title: "&aLiquid Fertilizer"
	quest.00F10FDD120BC630.quest_desc: [
		"Simply right click the &6Item Drain&r with a &6Mechanical Grindstone&r and then place another on top of it and you'll be able to grind away the enchantments into &aliquid experience&r."
	]
	quest.00F10FDD120BC630.quest_subtitle: "Stations to clean your &atools and weapons&r of their enchantments or &epolish some quartz&r"
	quest.00F10FDD120BC630.title: "&8Grindstone and Item Drain"
	quest.0145DD635CA8F16F.quest_desc: [
		"Lets through one polarization and eats the rest. Use it after a splitter when you only want one of the two beams."
	]
	quest.0145DD635CA8F16F.quest_subtitle: "Receives the incoming beam and &bpolarizes it&r "
	quest.0145DD635CA8F16F.title: "&dAbsorption Polarizing Filter"
	quest.014BDCB9922886EF.quest_desc: [
		"Heated mix of two sugar makes caramel fluid; compact it in a press and basin for the bar."
		"You can also spout caramel over berries the same way you glaze marshmallows."
	]
	quest.014BDCB9922886EF.quest_subtitle: "Heated mix of two sugar makes caramel fluid; compact it in a press and basin for the bar."
	quest.014BDCB9922886EF.title: "&eBar of Caramel"
	quest.01725D55B19D3E0F.quest_desc: [
		"Small and large. Chain them to a distant cog without the teeth meshing with everything in between — isolation for crowded gearboxes."
	]
	quest.01725D55B19D3E0F.quest_subtitle: "These blocks allow you to connect &aCogwheels with chains&r inside complex systems where you don't want some Cogwheels to interact with others"
	quest.01725D55B19D3E0F.title: "&6Flanged Cogwheels"
	quest.01AAA5D33720CE80.quest_desc: [
		"Smith &eBlaze Burners&r into a smart enchanting table and a smart anvil. One enchants, the other combines and repairs, both sipping liquid experience."
		"Hold &eW&r over them in EMI to see their Ponder."
	]
	quest.01AAA5D33720CE80.quest_subtitle: "The &6Blaze Enchanter&r is a smart enchanting table&r and the &6Blaze Forger&r functions as a smart anvil. "
	quest.01AAA5D33720CE80.title: "&6Craft Blaze Enchanter and Blaze Forger"
	quest.0229FB3DD542C731.quest_desc: [
		"Wire a &eRedstone Relay&r into an energy line when you want the current gated. No signal, no FE through it — the clutch of electricity."
	]
	quest.0229FB3DD542C731.title: "Redstone Relay"
	quest.0229FB3DD542C731.quest_subtitle: "A &cRedstone Relay&r only allows &6Energy&r to flow when it is receiving a &credstone&r signal"
	quest.02B0448DA14595B0.quest_desc: [
		"Attach it to a Simulated assembly and it draws the force arrows: gravity, drag, lift, balloon lift, propulsion, levitation, magnets."
		"Wear it when a ship won't climb or a cart keeps flipping — the diagram shows which force is winning."
	]
	quest.02B0448DA14595B0.title: "Contraption Diagram"
	quest.02B0448DA14595B0.quest_subtitle: "The &6Contraption Diagram&r lets you visualize the forces acting on an attached simulated contraption, including &9Gravity&r, &8Drag&r, &bLevitation&r, &eBalloon Lift&r, &6Propulsion&r, &aLift&r, and &dMagnetic&r forces"
	quest.02C47B1CE17E8DD5.quest_desc: [
		"A hand crank with a large cog built in. Crank a gearbox directly in a corner too tight for a separate cog."
	]
	quest.02C47B1CE17E8DD5.quest_subtitle: "Hand cranks with a cogwheel installed. Handy for gear ratios and tight spaces"
	quest.02C47B1CE17E8DD5.title: "&6Large Crank Wheel"
	quest.02D5439ACE50EC34.quest_desc: [
		"Obtained by Blasting or Bulk-Blasting a piece of Coal Coke"
		""
		"You need &6Refined Coal Coke&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.02D5439ACE50EC34.quest_subtitle: "An even better upgrade"
	quest.02D5439ACE50EC34.title: "&7Refined Coal Coke"
	quest.0335A87D46B28982.quest_desc: [
		"Run a Golden Sheet down a belt through five loops of cogwheel, large cogwheel, then iron nugget. Most sheets become a &ePrecision Mechanism&r; a few fail and spit junk."
		"Spend them on Mechanical Crafters, arms, and the rest of brass-age gadgets."
	]
	quest.0335A87D46B28982.title: "Precision Mechanism"
	quest.0335A87D46B28982.quest_subtitle: "An item used to craft more advanced mechanical items"
	quest.0360911A620C6613.quest_desc: [
		"The high-end coil off Andesite Alloy. You'll need it for the Beam Condenser that merges beams."
	]
	quest.0360911A620C6613.quest_subtitle: "The high-end coil off Andesite Alloy. You'll need it for the Beam Condenser that merges beams."
	quest.0360911A620C6613.title: "&cRose Quartz Catalyst Coil"
	quest.03795968E7FA18BA.quest_desc: [
		"Place it. &eRight-click&r"
		"You can now see every shop on the server, price history, trends, and the most active traders"
		""
		"The mod scans the world for &6Table Cloth&r and &6Tradeworks Shelves&r and turns them into a live market interface similar to a stock exchange with the &6Market Terminal&r block"
	]
	quest.03795968E7FA18BA.title: "Market Terminal"
	quest.03795968E7FA18BA.quest_subtitle: "&6&lCreate: Stock Market&r turns your server economy into a live, player-driven stock exchange"
	quest.04CE5B960FE826CA.quest_desc: [
		"Soul fire in front of an &eEncased Fan&r haunts items instead of smoking them. That is the usual way to turn cobble into blackstone and make soul sand."
	]
	quest.04CE5B960FE826CA.title: "Soul Campfire"
	quest.04CE5B960FE826CA.quest_subtitle: "When placed in front of the &6Encased Fan&r, a &bSoul Fire&r allows it to haunt items"
	quest.04CEE0CA932DF671.quest_desc: [
		"&eBlaze Burner Fuels&r. Complete it by obtaining &6Blaze Burner Fuels&r."
		""
		"Opens after Blaze Burner (Brass Age)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.04CEE0CA932DF671.quest_subtitle: "This Create addon adds a variety of items and recipes, introducing new &afuel sources for Blaze Burners&r and giving players unique ways to build Steam Boiler&r setups. Ever wanted a &brenewable alternative to Blaze Cakes&r? Now you have one!"
	quest.04CEE0CA932DF671.title: "&2Blaze Burner Fuels"
	quest.0512ADDB7E6659CA.quest_desc: [
		"Obtained by compacting some &aCoal&r,&a a Clay Ball &rand&a a piece of Wheat&r with a &6Mechanical Press&r"
	]
	quest.0512ADDB7E6659CA.quest_subtitle: "To craft Briquettes "
	quest.0512ADDB7E6659CA.title: "&eObtain Materials"
	quest.05352FD080D95A2F.quest_desc: [
		"You can press U on the Straw to see what liquids it accepts, as well as their burn times"
		""
		"You need &6Straw&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.05352FD080D95A2F.title: "Straw"
	quest.05352FD080D95A2F.quest_subtitle: "Ever wanted to pipe liquids into your &6Blaze Burners&r? Just hand them a &fStraw&r and they'll slurp it straight from the pipe!"
	quest.053A085A1D02EEF0.quest_desc: [
		"&eCopper Diving Boots&r cancel buoyancy and ignore moving belts, so you plant your feet underwater and on running conveyors."
		"Take them off before you need to swim up in a hurry."
	]
	quest.053A085A1D02EEF0.title: "Copper Diving Boots"
	quest.053A085A1D02EEF0.quest_subtitle: "&6Diving Boots&r allow you to walk underwater like you do on land, as well as walk on belts without them moving you around. Be careful when jumping into the ocean, you won't float!"
	quest.05422CBF447A8BB8.quest_desc: [
		"Obtained by dropping a Shaft on top of a Mechanical Saw"
		""
		"You need &6Shear Pin&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.05422CBF447A8BB8.quest_subtitle: "An early-game, single-use connector that breaks when the network is overstressed"
	quest.05422CBF447A8BB8.title: "&6Shear Pin"
	quest.05C16E90B3E6304E.quest_desc: [
		"Needs to rotate at at least 30 RPM to function."
		""
		"You need &6Mechanical Mixer&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.05C16E90B3E6304E.title: "Mechanical Mixer"
	quest.05C16E90B3E6304E.quest_subtitle: "A &6Mechanical Mixer&r can autocraft shapeless recipes as well as mix things like potions"
	quest.0609D97DEB6E48BF.quest_desc: [
		"Line up &eEncased Chain Drives&r when you want several parallel shafts, or to turn rotation 90 degrees once without a full gearbox."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.0609D97DEB6E48BF.title: "Encased Chain Drive"
	quest.0609D97DEB6E48BF.quest_subtitle: "An &6Encased Chain Drive&r allows for multiple parallel rotational outputs, and to change the axis of the rotational output once"
	quest.06E1BE9BBC046094.quest_desc: [
		"A &eMechanical Harvester&r on a spinning bearing cuts mature crops and leaves the farmland intact. Mount several around one axle for a circle farm."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.06E1BE9BBC046094.title: "Mechanical Harvester"
	quest.06E1BE9BBC046094.quest_subtitle: "&6Mechanical Harvesters&r allow contraptions to harvest crops"
	quest.06F20283C76C1D82.quest_desc: [
		"Mill sugar cane, or craft it from the cane by hand. Almost every recipe in this chapter wants some."
		"Keep a millstone (or crushing wheels) on cane if you plan to automate candy."
	]
	quest.06F20283C76C1D82.title: "Sugar"
	quest.06F20283C76C1D82.quest_subtitle: "Mill sugar cane, or craft it from the cane by hand. Almost every recipe in this chapter wants some."
	quest.071F9DA863D5E146.quest_desc: [
		"Slice bread on a cutting board, put a slice on the station, then add cooked chicken and whatever else you like."
		"Potions layered in carry their effect. Break the sandwich to take it with you."
	]
	quest.071F9DA863D5E146.quest_subtitle: "Start by making bread slices with Farmer’s Delight’s cutting board, or craft a burger bun. Place a Sandwich Station, put a bread slice or bun on top, and begin adding ingredients of your choice. Along with food, potions can also be added. When you’re done, break the sandwich to collect it. You can place sandwiches anywhere by shift-right-clicking"
	quest.071F9DA863D5E146.title: "&eMake a &2Chicken Sandwich"
	quest.07B2E02E2328F4C2.quest_desc: [
		"A directional thruster that can yaw and pitch. Platinum-tier, so smelt the ingot first."
		"This is the steering nozzle for ships that already have straight-line ion or turpentine thrust. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.07B2E02E2328F4C2.title: "Vector Thruster"
	quest.07B2E02E2328F4C2.quest_subtitle: "A &bVector Thruster&r is a directional thruster that can also yaw and pitch for vectored &6Propulsion&r control"
	quest.07EC5E450BA9712D.quest_desc: [
		"A &eDepot&r holds one stack still so a press, spout, or fan can work on it. Funnels still pull items on and off."
		"The &eWeighted Ejector&r is the depot that throws. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.07EC5E450BA9712D.title: "Depot"
	quest.07EC5E450BA9712D.quest_subtitle: "A &6Depot&r is really just a belt that doesn't move"
	quest.081BC6F954D95C8A.quest_desc: [
		"Glue &eSails&r (or wool) onto a structure attached to a &eWindmill Bearing&r, then assemble it. More sail area means more stress from that bearing."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.081BC6F954D95C8A.quest_subtitle: "A kinetic source that uses the power of the wind to generate rotational force. The amount of &6SU&r generated depends on the number of sails connected to the &6Windmill&r and maxes out at 8,192 per bearing"
	quest.081BC6F954D95C8A.title: "Windmill Bearing"
	quest.08D5EBEEC4FCBCD2.quest_desc: [
		"Picks up items off the track and from containers it passes under, then dumps them into hoppers below."
		"On a loop with &eController Rails&r it's a cheap item bus."
	]
	quest.08D5EBEEC4FCBCD2.quest_subtitle: "Picks up items off the track and from containers it passes under, then dumps them into hoppers below."
	quest.08D5EBEEC4FCBCD2.title: "&eMinecart with Hopper"
	quest.08EA1AEF6AB1C266.quest_desc: [
		"Any colour of &eSeat&r works. Glue at least one onto the train so you can ride it after assembly."
		"Mobs and &eBlaze Burners&r can sit too — that's how scheduled trains get a driver later."
	]
	quest.08EA1AEF6AB1C266.quest_subtitle: "It's just a &6Seat&r, nothing more, nothing less. But if you're in a moving contraption, you might as well glue it to the contraption so you can sit and move along with it"
	quest.08EA1AEF6AB1C266.title: "&dSeats"
	quest.092494276E7FD582.quest_desc: [
		"Powered, it kicks riders out, ignites TNT carts, and triggers hopper and dispenser carts."
		"That's the 'do the thing' rail at the end of a line."
	]
	quest.092494276E7FD582.quest_subtitle: "Powered, it kicks riders out, ignites TNT carts, and triggers hopper and dispenser carts."
	quest.092494276E7FD582.title: "&cActivator Rail"
	quest.094A700254F965DE.quest_desc: [
		"Point an &eEncased Fan&r at campfire, soul fire, water, or lava and items blown through that air get smoked, haunted, washed, or blasted."
		"It also shoves entities around. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.094A700254F965DE.title: "Encased Fan"
	quest.094A700254F965DE.quest_subtitle: "A &6Encased Fan&r is a very versatile machine that can pull and push entities, as well as wash, haunt, blast, and smoke items"
	quest.09C716DA6553249A.quest_desc: [
		"You'll need honey as a fluid. Empty bottles into a basin, then a &eSpout&r can put that honey onto an iron sheet."
		"That's the filling recipe for &eHoney Glue&r, next door."
	]
	quest.09C716DA6553249A.title: "Honey Bottle"
	quest.09C716DA6553249A.quest_subtitle: "You'll need honey as a fluid. Empty bottles into a basin, then a &eSpout&r can put that honey onto an iron sheet."
	quest.0A4F6414C91AF6CD.quest_desc: [
		"Four &eRubber Sheet Blocks&r around a shaft. The huge all-terrain wheel."
		"For the tallest Off-Road frames. Same mount as the little tires — the spring stretches to fit."
	]
	quest.0A4F6414C91AF6CD.title: "Monstrous Tire"
	quest.0A4F6414C91AF6CD.quest_subtitle: "Four &eRubber Sheet Blocks&r around a shaft. The huge all-terrain wheel."
	quest.0AC8942A131FCC34.quest_desc: [
		"Merges up to three incoming beams into one, combining their properties. Needs a &eRose Quartz Catalyst Coil&r."
	]
	quest.0AC8942A131FCC34.quest_subtitle: "Condenses up to &athree beams into one&r combining its properties"
	quest.0AC8942A131FCC34.title: "&cBeam Condenser"
	quest.0B75860976DB9B43.quest_desc: [
		"A &eRadial Chassis&r grabs every block in a radius when you Super Glue it, which is faster than painting glue on each piece of a windmill or wheel."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.0B75860976DB9B43.title: "Radial Chassis"
	quest.0B75860976DB9B43.quest_subtitle: "A &6Radial Chassis&r is a useful block for building contraptions"
	quest.0BCAAE3D64E3FF14.quest_desc: [
		"Put a &eSchedule&r in a train's conductor slot — a seated mob or a &eBlaze Burner&r can drive. Add stations and wait conditions so the train runs without you."
	]
	quest.0BCAAE3D64E3FF14.title: "Schedule"
	quest.0BCAAE3D64E3FF14.quest_subtitle: "A &6Schedule&r lets you schedule trains so that mobs or &6Blaze Burners&r can drive them"
	quest.0C15B829B4F22CF0.quest_desc: [
		"Obtained by putting through some Magma Blocks through a pair of Crushing Wheels"
		""
		"You need &6Blazing Rocks&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.0C15B829B4F22CF0.quest_subtitle: "Perfect fuel for very cheap"
	quest.0C15B829B4F22CF0.title: "&cBlazing Rocks"
	quest.0C29CEB04D73AB53.quest_desc: [
		"Glue the blocks, hold right-click, and pull the lever. Diagonal neighbours come along; after that any assembler can take it back apart."
		"Disconnected chunks split off; a slimeball merges two assemblies. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.0C29CEB04D73AB53.title: "Physics Assembler"
	quest.0C29CEB04D73AB53.quest_subtitle: "The &6Physics Assembler&r is used to assemble and disassemble simulated contraptions"
	quest.0C59E0866E7EFBF3.quest_desc: [
		"Glue a &ePortable Fluid Interface&r onto a contraption and park it against a matching one on the dock. Fluids transfer while the two faces stay aligned."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.0C59E0866E7EFBF3.title: "Portable Fluid Interface"
	quest.0C59E0866E7EFBF3.quest_subtitle: "A &6Portable Fluid Interface&r allows contraptions to transfer fluids to blocks"
	quest.0D04B64A3C45F2B6.quest_desc: [
		"The Simulated &eSwivel Bearing&r again: glue a cluster, power the cog, and it pivots as its own physics assembly."
		"Gadgets uses it as the base for the servo and aileron bearings that follow. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.0D04B64A3C45F2B6.quest_subtitle: "The Simulated &eSwivel Bearing&r again: glue a cluster, power the cog, and it pivots as its own physics assembly."
	quest.0D04B64A3C45F2B6.title: "Craft Swivel Bearing"
	quest.0D49595D9B86A794.quest_desc: [
		"You will want plenty of Lava Buckets to make sure you never run out of superheat fuel"
		""
		"You need &6Lava Bucket&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.0D49595D9B86A794.quest_subtitle: "Tastes like Dr. Pepper"
	quest.0D49595D9B86A794.title: "&aFilling up the tank"
	quest.0DDA8D279FA3A0DE.quest_desc: [
		"A &eTrack Buffer&r marks a hard stop on the rail. Put it on dead-end tracks so scheduled trains do not overshoot the platform."
	]
	quest.0DDA8D279FA3A0DE.title: "Train Stop"
	quest.0DDA8D279FA3A0DE.quest_subtitle: "A &eTrack Buffer&r marks a hard stop on the rail. Put it on dead-end tracks so scheduled trains do not overshoot the platform."
	quest.0E4AC2D4FA50A4E2.quest_desc: [
		"Two smooth stone on two planks. Right-click a bread slice or bun onto the &eSandwiching Station&r, then pile on ingredients."
		"Food and potions both layer in. Break the sandwich to pick it up; shift-right-click places it in the world."
	]
	quest.0E4AC2D4FA50A4E2.quest_subtitle: "A Create add-on for crafting custom sandwiches. Compatible with Farmer’s Delight. Build a Sandwich Station to begin"
	quest.0E4AC2D4FA50A4E2.title: "&eCraft the &2Sandwich Station"
	quest.0EC563188254E0A6.quest_desc: [
		"Give it rotation and it reels rope in or pays it out, so you can hoist, tow, or lower another Simulated assembly."
		"Pair it with a connector and a coupling. Right-click the rope with a wrench to slide down. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.0EC563188254E0A6.title: "Rope Winch"
	quest.0EC563188254E0A6.quest_subtitle: "Give it rotation and it reels rope in or pays it out, so you can hoist, tow, or lower another Simulated assembly."
	quest.0ECF6A73AFA16B0D.quest_desc: [
		"Mesh small and large &eCogwheels&r to turn corners and step speed up or down. Wrench them until the teeth actually touch."
		"Once a network corners cleanly, a &eGearbox&r will save you a lot of cobble-cog spaghetti."
	]
	quest.0ECF6A73AFA16B0D.quest_subtitle: "&6Cogwheels&r are used to either increase rotational speed or extend contraptions depending on the way they're facing. Play around with the sizes of the cogwheels and see what you can make out of them"
	quest.0ECF6A73AFA16B0D.title: "Cogwheels"
	quest.0F1D3205FB83E2D3.quest_desc: [
		"A vanilla &eConduit&r is a Heart of the Sea ringed with Nautilus Shells. You'll cage it next so it can process items instead of only buffing you underwater."
	]
	quest.0F1D3205FB83E2D3.quest_subtitle: "Can be found in Treasure Hunts."
	quest.0F1D3205FB83E2D3.title: "&aGather Materials and craft a &3Conduit"
	quest.0F2F0A538E65B228.quest_desc: [
		"Aim a &eSmart Observer&r at an inventory, belt, or block. It outputs redstone when it sees the item (or attribute) you filtered for."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.0F2F0A538E65B228.title: "Content Observer"
	quest.0F2F0A538E65B228.quest_subtitle: "A &cSmart Observer&r can look for specific items in the world or in inventories"
	quest.0F315FD3B94735A5.quest_desc: [
		"Assemble and disassemble trains at a &eTrain Station&r, then name it so schedules can find it. This is the block to ponder if train assembly still looks like magic."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.0F315FD3B94735A5.title: "Track Station"
	quest.0F315FD3B94735A5.quest_subtitle: "A &6Train Station&r is the block that deals with train assembly and disassembly"
	quest.0F76470B53D09466.quest_desc: [
		"Heated mix of two sugar, wheat flour and honey. Four candies per mix."
		"Caramel is next if you keep that heated mixer running on sugar alone."
	]
	quest.0F76470B53D09466.quest_subtitle: "Heated mix of two sugar, wheat flour and honey. Four candies per mix."
	quest.0F76470B53D09466.title: "&eHoney Candy"
	quest.0F7DF9F8B161AD3F.quest_desc: [
		"Fill the empty catalyst with water. Same bulk washing as a waterlogged fan, contained in the block."
	]
	quest.0F7DF9F8B161AD3F.title: "Fan Splashing Catalyst"
	quest.0F7DF9F8B161AD3F.quest_subtitle: "Fill the empty catalyst with water. Same bulk washing as a waterlogged fan, contained in the block."
	quest.0FCA9B992F6FC084.quest_desc: [
		"This chapter is Create Simulated: contraptions that keep real physics after you assemble them, instead of locking to a bearing."
		"Glue a hull, pull the assembler, then hang engines, sails, ropes, and sensors on it. Aeronautics, Off-Road, and Propulsion all build on this."
	]
	quest.0FCA9B992F6FC084.quest_subtitle: "&7Opens after &eBlaze Burner&7 (Brass Age)"
	quest.0FCA9B992F6FC084.title: "Simulated"
	quest.0FD8D9454B234451.quest_desc: [
		"Ferment sugar, apples, potatoes, and the like with bone meal under a Basin Lid. Pump the ethanol out and bucket it — another engine fuel."
	]
	quest.0FD8D9454B234451.title: "Ethanol Bucket"
	quest.0FD8D9454B234451.quest_subtitle: "Ferment sugar, apples, potatoes, and the like with bone meal under a Basin Lid. Pump the ethanol out and bucket it — another engine fuel."
	quest.1042F8DDE3975030.quest_desc: [
		"Same trick as flint: glowstone dust on a depot in front of the Cage. Channeling turns it into &ePrismarine Crystals&r."
	]
	quest.1042F8DDE3975030.quest_subtitle: "The Conduit Cage will gradually turn it into Prismarine Crystals"
	quest.1042F8DDE3975030.title: "&aObtain &eGlow Dust"
	quest.1045354B831EAA6B.quest_desc: [
		"A storm boss. She drops Lacrima and Essence of the Storm. That is the last of the eight."
		""
		"You need &6Scylla&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.1045354B831EAA6B.quest_subtitle: "A storm boss. She drops Lacrima and Essence of the Storm. That is the last of the eight."
	quest.1045354B831EAA6B.title: "&c&lScylla"
	quest.1077202C28DA7BFD.quest_desc: [
		"Press &eRubber&r in a &eMechanical Press&r to flatten it into &eRubber Sheets&r. Three in a row make a &eMechanical Belt&r — that is the next unlock."
	]
	quest.1077202C28DA7BFD.title: "Rubber Sheet"
	quest.1077202C28DA7BFD.quest_subtitle: "Press &eRubber&r in a &eMechanical Press&r to flatten it into &eRubber Sheets&r. Three in a row make a &eMechanical Belt&r — that is the ..."
	quest.1087DA469F3A10E8.quest_desc: [
		"Look up &eSweet Berry Cream Cake&r in EMI — Create: Food mixes and layers it."
		"The heated mixer you just built can handle the cooking steps."
	]
	quest.1087DA469F3A10E8.quest_subtitle: "Look up &eSweet Berry Cream Cake&r in EMI — Create: Food mixes and layers it."
	quest.1087DA469F3A10E8.title: "&eMake a &dSweet Berry Cake"
	quest.109DED9EC2176A5F.quest_desc: [
		"Sits between inventories and shoves items across. It will not pull from another Transporter, so you can't daisy-chain them into a loop."
	]
	quest.109DED9EC2176A5F.quest_subtitle: "&aTransfer&r items from one container to another seamlessly"
	quest.109DED9EC2176A5F.title: "&6Transporter"
	quest.10A093ED9B5B1207.quest_desc: [
		"A bigger Encased Fan that reads Catalyst Sails instead of a block in front. Craft it once the Hydraulic Press path is open."
	]
	quest.10A093ED9B5B1207.quest_subtitle: "A bigger, stronger fan that takes catalyst sails."
	quest.10A093ED9B5B1207.title: "&eIndustrial Fan"
	quest.10A822934956DF48.quest_desc: [
		"Crafted with tinted glass. Feed it into the Absorption Polarizing Filter next."
		""
		"You need &6Polarizing Filter&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.10A822934956DF48.quest_subtitle: "Used to craft our &dAbsorption Polarizing Filter"
	quest.10A822934956DF48.title: "&aPolarizing Filter"
	quest.10C57B245C83B5AA.quest_desc: [
		"A music disc: four candy canes around a bar of dark chocolate."
		"You'll need dark chocolate from the cocoa branch as well as the candy cane block."
	]
	quest.10C57B245C83B5AA.quest_subtitle: "A music disc: four candy canes around a bar of dark chocolate."
	quest.10C57B245C83B5AA.title: "&5The Bright Side"
	quest.10D15D74A09CBFBD.quest_desc: [
		"Heated compacting: one titanium ingot, raw martian iron and volcanic ash makes two ingots. You need it for the tougher space suit, electrolysis, and the rest of this chapter."
	]
	quest.10D15D74A09CBFBD.quest_subtitle: "Compact titanium, martian iron and volcanic ash."
	quest.10D15D74A09CBFBD.title: "&cMartian Steel"
	quest.10D7C5874FF7E693.quest_desc: [
		"Sit a &eTrain Observer&r next to the track and it pulses redstone when a train passes. You can filter which trains (or cargo) count."
		"Wire it to lights, doors or a crossing gate. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.10D7C5874FF7E693.quest_subtitle: "A &6Train Observer&r gives off a &credstone signal&r when detecting a train"
	quest.10D7C5874FF7E693.title: "&dTrain Observer"
	quest.110855C63B483132.quest_desc: [
		"Craft two Brass Train Hulls from four brass plates around a Block of Brass, or stonecut one from the block."
		"A brass-block hull piece from Create Deco, sitting next to Railway Casing on this chapter."
	]
	quest.110855C63B483132.quest_subtitle: "Sheets on a brass block"
	quest.110855C63B483132.title: "&6Brass Train Hull"
	quest.112437DD45C811FB.quest_desc: [
		"Hot, crushing and acidic. Wear the Martian Steel suit, land, and look for titanium ore. Mercury is next, once you have liquid hydrogen."
	]
	quest.112437DD45C811FB.quest_subtitle: "Hot, crushing and acidic. Bring a good suit."
	quest.112437DD45C811FB.title: "&6Venus"
	quest.112FABB815D42A2F.quest_desc: [
		"An IDAS castle in the overworld. Clear it, then look for the Haunted Manor, Labyrinth and Tinker's Citadel."
	]
	quest.112FABB815D42A2F.quest_subtitle: "An IDAS castle in the overworld. Clear it, then look for the Haunted Manor, Labyrinth and Tinker's Citadel."
	quest.112FABB815D42A2F.title: "&cCastle"
	quest.113F18929B1DA320.quest_desc: [
		"Mix Create Big Cannons nitropowder into a fluid the same way. Heavy rounds and the 40mm grenades want this instead of ordinary gunpowder."
	]
	quest.113F18929B1DA320.quest_subtitle: "A stronger propellant for the heavier rounds."
	quest.113F18929B1DA320.title: "&6Nitropowder"
	quest.11E658C9A9E7663E.quest_desc: [
		"Sits on a heat source and turns temperature into rotation. A compact kinetic generator when you already have blaze heat."
	]
	quest.11E658C9A9E7663E.quest_subtitle: "Generates rotation from heat."
	quest.11E658C9A9E7663E.title: "&cStirling Engine"
	quest.11EAA6665DE956FF.quest_desc: [
		"&eChutes&r drop items straight down into inventories. Point an &eEncased Fan&r up the column if you need them to travel the other way."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.11EAA6665DE956FF.title: "Chute"
	quest.11EAA6665DE956FF.quest_subtitle: "&6Chutes&r are used to transfer items between inventories vertically, either with gravity downwards or Encased Fan airflow upwards"
	quest.11EC157FEDD4E98D.quest_desc: [
		"Iron or gold, both cosmetic. They do not change thrust, armor, or battery."
		"Wear them if you want the look; Aviator's Goggles are the ones that actually show flight data."
	]
	quest.11EC157FEDD4E98D.quest_subtitle: "Keeps the wind out of your eyes. Purely for looks."
	quest.11EC157FEDD4E98D.title: "&7Pilot Goggles"
	quest.1209EAFCD7457303.quest_desc: [
		"&eOil Scanner&r. Complete it by obtaining &6Oil Scanner&r."
		""
		"Opens after Fluid Pipes (Copper Age)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.1209EAFCD7457303.title: "Oil Scanner"
	quest.1209EAFCD7457303.quest_subtitle: "Use an &fOil Scanner&r to check for &8Crude Oil Deposits&r from &6Create Diesel Generators&r"
	quest.122F42FFB82A0758.quest_desc: [
		"Mix gunpowder in a basin into a fluid. A Spout uses it to fill primers and, later, cartridges. This is the Create Armorer ammo path, not the Ammo Workbench."
	]
	quest.122F42FFB82A0758.quest_subtitle: "Mix gunpowder into a fluid. It fills cartridges in a spout."
	quest.122F42FFB82A0758.title: "&6Liquid Gunpowder"
	quest.12A9A76829860E9B.quest_desc: [
		"A heated Mechanical Mixer with a glass bottle and milk makes Heavy Cream. You can also mix a bucket of milk (no heat) into Heavy Cream fluid and Skim Milk, then spout the cream into bottles."
		""
		"Hold &eW&r over the Mixer in EMI to see its Ponder. The Sweet Berry Cake quest already covers one Create: Food dessert; this branch is the dairy line."
	]
	quest.12A9A76829860E9B.quest_subtitle: "Milk, a bottle, a heated mixer"
	quest.12A9A76829860E9B.title: "&eHeavy Cream"
	quest.12D0B21E10AEEDB4.quest_desc: [
		"The &cKinetic Battery&r stores &6Stress Units&r for later use. This way it allows you to have a source of a limited amount of &6Stress Units&r whenever necessary without the need for a new setup each time. But to use this block for your needs first you will need to &ccharge&r it"
		""
		"The &cKinetic Battery&r charges itself by consuming &6SU&r from the grid it is connected to whenever it &l&4is not&r powered on, and uses that charge to provide &6SU&r to the connected grid whenever &2&lit is&r powered on "
	]
	quest.12D0B21E10AEEDB4.quest_subtitle: "The &cKinetic Battery&r stores &6Stress Units&r for later use. This way it allows you to have a source of a limited amount of &6Stress Un..."
	quest.12D0B21E10AEEDB4.title: "&5How to charge the Kinetic Battery"
	quest.12E775AF8E963543.quest_desc: [
		"Spin an &eAndesite&r or &eWooden Propeller&r and it pushes the assembly. Mount it on a bearing so the blades can turn on a larger ship."
		"Wood is the cheap first prop; andesite is the sturdier everyday one. Hold &eW&r over them in EMI to see their Ponder."
	]
	quest.12E775AF8E963543.title: "Andesite Propeller"
	quest.12E775AF8E963543.quest_subtitle: "An &7Propeller&r provides &6Propulsion&r when powered"
	quest.1345100D26859FB0.quest_desc: [
		"Shape casting sand around an end, sliding breech or screw breech mould. Pour molten metal in, then bore the casting on the &eCannon Drill&r."
	]
	quest.1345100D26859FB0.quest_subtitle: "Shape the casting sand around a mould to cast that part."
	quest.1345100D26859FB0.title: "&6Cast Moulds"
	quest.134EAF88A6838F60.quest_desc: [
		"Craft a &eHeadlight&r and a brass &ePilot&r, then glue them on. Steps and grab rails from the same mod finish the walkways."
		"Platforms come next if you want the station to match."
	]
	quest.134EAF88A6838F60.quest_subtitle: "Headlights, pilots (cowcatchers), steps and grab rails from &eBells and Whistles&r."
	quest.134EAF88A6838F60.title: "&7Bells and Whistles"
	quest.137BE86F5D7383CC.quest_desc: [
		"Sit here once the station has assembled the rocket. Mechanical-crafted with circuits, titanium sheets and industrial iron. You still need thrusters, fuel and a suit before Lift-off."
	]
	quest.137BE86F5D7383CC.quest_subtitle: "Somewhere to sit and fly from."
	quest.137BE86F5D7383CC.title: "&9Rocket Controls"
	quest.13889EE66A1C8259.quest_desc: [
		"A solid iron projectile with no fuze, good against wood and thin walls. Load a powder charge behind it, then fire from the mount."
	]
	quest.13889EE66A1C8259.quest_subtitle: "The simplest projectile: a lump of iron."
	quest.13889EE66A1C8259.title: "&eSolid Shot"
	quest.139DAA6E8CF4267A.quest_desc: [
		"At the bottom of the inventory, you may have noticed a search bar"
		""
		"That is &dEMI&r (&dExactly Enough Items&r) — the recipe viewer this pack uses"
		""
		"Type \"Wood\" and the item list on the right shows everything with Wood in the name"
		""
		"Start a search with @ to filter by mod, for example &e@Create&r or &e@createlanterns&r"
		""
		"Bookmark favourites from the EMI list (Controls → EMI → Favorite). They stay on the left until you remove them"
	]
	quest.139DAA6E8CF4267A.quest_subtitle: "Read my description!"
	quest.139DAA6E8CF4267A.title: "&bEMI (Exactly Enough Items)"
	quest.13AA0C0A7426F78C.quest_desc: [
		"Mechanical-crafted from polished lunar sapphire, a Targeting Computer, circuits and titanium. Fit it on the rocket when you are ready for Mars."
	]
	quest.13AA0C0A7426F78C.quest_subtitle: "Plots courses beyond the Moon."
	quest.13AA0C0A7426F78C.title: "&bInterplanetary Navigator"
	quest.13CB1A4A82D3D3C4.quest_desc: [
		"Craft oak narrow track (or any other wood) and pick a narrow bogey from the casing's bogey menu (default &eAlt&r)."
		"Tight tunnels and decorative tramways are what this is for."
	]
	quest.13CB1A4A82D3D3C4.quest_subtitle: "Narrow track for small trains and tight tunnels. Narrow trains need narrow bogeys."
	quest.13CB1A4A82D3D3C4.title: "&6Narrow Gauge"
	quest.13D833C11A71B131.quest_desc: [
		"Nine nuggets make a block. Park it next to a &eBlaze Enchanter&r or &eForger&r as bottled XP, or convert it toward Super Experience with lightning."
	]
	quest.13D833C11A71B131.quest_subtitle: "Can be used to feed the &6Blaze Forger&r and the &6Blaze Enchanter&r"
	quest.13D833C11A71B131.title: "&2Block of Experience"
	quest.13E4B74A690CC783.quest_desc: [
		"Look at a Ribbit. Their villages are a separate structure."
		""
		"You need &6Ribbit&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.13E4B74A690CC783.quest_subtitle: "A frog that trades and plays"
	quest.13E4B74A690CC783.title: "&eRibbit"
	quest.142E9D954338769C.quest_desc: [
		"Craft a base bangle from a Ring of Potential, gold blocks, a source block and an end crystal, then attune it with essences. Fire, water, earth, air, anima or summon."
	]
	quest.142E9D954338769C.quest_subtitle: "A Ring of Potential, gold blocks, a source block and an end crystal make the base bangle; essences attune it."
	quest.142E9D954338769C.title: "&eElemental Bangles"
	quest.1498C78F14A0F91B.quest_desc: [
		"Right-click any tire onto the mount and the spring sizes itself to that wheel."
		"You need a mount per corner before the small, standard, large, or monstrous tires will sit on the chassis. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.1498C78F14A0F91B.title: "Wheel Mount"
	quest.1498C78F14A0F91B.quest_subtitle: "A &8Wheel Mount&r is required for mounting wheels. To use it, &eRight-click&r it with any wheel and the spring will automatically adjust its size to fit"
	quest.14CC5DA693F41777.quest_desc: [
		"An auto-loaded cannon or an autocannon on a mount, firing on its own. Tick this off when the loader, not you, puts a round down range."
	]
	quest.14CC5DA693F41777.quest_subtitle: "Defend a base, or arm an airship, with an automatically loaded cannon. Tick this off when it fires on its own."
	quest.14CC5DA693F41777.title: "&c&lFortress"
	quest.14F9238BF932A5EB.quest_desc: [
		"Right-click an empty &eRoost&r on a chicken (or the chicken on the roost) to get a &eChicken Roost&r."
		"It starts producing on its own; eggs are the next quest."
	]
	quest.14F9238BF932A5EB.quest_subtitle: "Right-click an empty &eRoost&r on a chicken (or the chicken on the roost) to get a &eChicken Roost&r."
	quest.14F9238BF932A5EB.title: "&eCapture a Chicken by using the &bRoost"
	quest.1524E0F8D079A605.quest_desc: [
		"Run supported fuels through a &eFuel Oxidizer&r so the thruster keeps full thrust even when air pressure drops with altitude."
		"Without it, high-altitude burns get weaker. Pair it with the thrusters you just made."
	]
	quest.1524E0F8D079A605.quest_subtitle: "Run supported fuels through a &eFuel Oxidizer&r so the thruster keeps full thrust even when air pressure drops with altitude."
	quest.1524E0F8D079A605.title: "Craft Fuel Oxidizer"
	quest.156DC76AB7CD1065.quest_desc: [
		"&eShafts&r are the wire of Create: a straight line of rotation from a water wheel or windmill into every machine that needs to spin."
		"Place a few, then branch into cogwheels, belts, and your first power sources."
	]
	quest.156DC76AB7CD1065.quest_subtitle: "A &6Shaft&r is another basic but important machinery part that is required to make anything move with rotation. You can also extend the shaft to make it longer and affect more than one contraption that requires rotation"
	quest.156DC76AB7CD1065.title: "Rod of Constant Rotation"
	quest.157DAE6EC4155F82.quest_desc: [
		"Create's &eLimestone&r turns up in caves. Bring a stack home; the millstone wants a steady supply."
	]
	quest.157DAE6EC4155F82.quest_subtitle: "Can be found in &6caves&r."
	quest.157DAE6EC4155F82.title: "&aObtain Limestone"
	quest.15BA3485720ECF3F.quest_desc: [
		"Equip the &eRemote Lens&r to look through a conductor's eyes while they drive or wait at a station."
		"Handy for checking a far platform without riding out there."
	]
	quest.15BA3485720ECF3F.quest_subtitle: "See what your Conductors see."
	quest.15BA3485720ECF3F.title: "&bRemote Lens"
	quest.160E4D26B4D8A901.quest_desc: [
		"Andesite, brass, and railway casings plus an Item Vault. Each crate tier is a compact inventory dressed in that casing."
	]
	quest.160E4D26B4D8A901.quest_subtitle: "Andesite, brass, and railway casings plus an Item Vault. Each crate tier is a compact inventory dressed in that casing."
	quest.160E4D26B4D8A901.title: "Materials for &3Crates"
	quest.161E1812428DF7F0.quest_desc: [
		"Freeze hydrogen gas in an &eIce Box&r once it is cold enough. It is the best rocket fuel in the pack, and Mercury's trip expects it."
	]
	quest.161E1812428DF7F0.quest_subtitle: "Freeze hydrogen into the best rocket fuel."
	quest.161E1812428DF7F0.title: "&eLiquid Hydrogen"
	quest.163364A51A8AC02E.quest_desc: [
		"Unlike a Create drill, these break a volume around themselves and snap to each other without glue."
		"More wheels on one bearing slow it down; extra bearings share the work. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.163364A51A8AC02E.title: "Rockcutting Wheel"
	quest.163364A51A8AC02E.quest_subtitle: "A &8Rockcutting Wheel&r mines blocks at rapid speeds when rotated by a &8Borehead Bearing&r"
	quest.163D0CE9361628FA.quest_desc: [
		"Off-Road vehicles are Simulated chassis with tires and drills. They still want a &ePortable Engine&r on board for rotation."
		"Craft one, then hang wheel mounts or a borehead off the frame."
	]
	quest.163D0CE9361628FA.quest_subtitle: "Off-Road vehicles are Simulated chassis with tires and drills. They still want a &ePortable Engine&r on board for rotation."
	quest.163D0CE9361628FA.title: "Engine"
	quest.1642807AAAD12029.quest_desc: [
		"Stonecut iron blocks into riveted and other &eLocometal&r, then dye them if you want a livery."
		"Next is the rounded boiler and the smokestacks that finish a steam engine's look."
	]
	quest.1642807AAAD12029.quest_subtitle: "Stonecut iron blocks into Locometal for proper-looking train bodies. It comes in many colours."
	quest.1642807AAAD12029.title: "&7Locometal"
	quest.16C3B2565C2A6C14.quest_desc: [
		"Press an ingot on a &eMechanical Press&r. Northstar machines, rocket parts and the &eCircuit Engraver&r all ask for these in place of iron sheets."
	]
	quest.16C3B2565C2A6C14.quest_subtitle: "Press titanium into sheets. Northstar uses them where Create would use iron sheets."
	quest.16C3B2565C2A6C14.title: "&fTitanium Sheets"
	quest.16C3EC6AE3C3F7C9.quest_desc: [
		"Now that we have crafted everything necessary we can finally make our &3Echo armor set&r, a powerful set that grants it's user with infinite &aResistance&r and &aStrength&r"
	]
	quest.16C3EC6AE3C3F7C9.quest_subtitle: "Now that we have crafted everything necessary we can finally make our &3Echo armor set&r, a powerful set that grants it's user with infin..."
	quest.16C3EC6AE3C3F7C9.title: "&bEcho Armor Set"
	quest.16F16A332CFCE4DE.quest_desc: [
		"A mobile mount you can tow. It cannot be automated like a Cannon Mount, but it goes where the fight is."
	]
	quest.16F16A332CFCE4DE.quest_subtitle: "A field cannon you can tow around."
	quest.16F16A332CFCE4DE.title: "&6Cannon Carriage"
	quest.1723E7E4747593A3.quest_desc: [
		"Shop inventory, Packager and Stock Link at the back; Stock Ticker and a seated keeper at the counter; Table Cloths or Tradeworks shelves with prices on the front. Checkout packs the purchase and stores payment in the ticker."
		"List it on the Market Terminal or Remote so the rest of the server can find you. Tick this when a player can walk up and buy."
	]
	quest.1723E7E4747593A3.quest_subtitle: "A shop other players can actually use"
	quest.1723E7E4747593A3.title: "&aOpen for Business"
	quest.175099CF5696829E.quest_desc: [
		"&9Tasks &rare things that need to be done to complete a quest. If a task is an item, clicking on it will show its recipe"
		""
		"&6Rewards &rare what you get after completing all &9Tasks&r. Click to claim"
		""
		"The pin icon at the top left will pin a quest to your screen"
	]
	quest.175099CF5696829E.quest_subtitle: "Read my description!"
	quest.175099CF5696829E.title: "&6Quests"
	quest.17E6DCDBEEBAEEAD.quest_desc: [
		"The empty cart is the chassis. Chest, hopper, furnace, TNT and dispenser variants all start from this."
		"Ride it, couple it, or park it on a &eCart Assembler&r to turn it into a contraption."
	]
	quest.17E6DCDBEEBAEEAD.quest_subtitle: "The empty cart is the chassis. Chest, hopper, furnace, TNT and dispenser variants all start from this."
	quest.17E6DCDBEEBAEEAD.title: "&aMinecart"
	quest.17F265C8D8A9D31D.quest_desc: [
		"A Warp Stone is reusable; Return and Warp Scrolls are single-use. Open the waystone list from wherever you are standing."
	]
	quest.17F265C8D8A9D31D.quest_subtitle: "Teleport to a waystone from wherever you are."
	quest.17F265C8D8A9D31D.title: "&bWarp Stone and Scrolls"
	quest.1855A40693AE0CFA.quest_desc: [
		"Grow grapes, press them for pomace, then mix the pomace with sugar for &eGrape Juice&r."
		"Wine doesn't happen in the mixer — that's what the cellar is for."
	]
	quest.1855A40693AE0CFA.quest_subtitle: "Press grapes into pomace, then mix it with sugar for juice."
	quest.1855A40693AE0CFA.title: "&5Create Winery"
	quest.190FD2DF12D222C0.quest_desc: [
		"Heated mix of sugar, dragon's breath, cocoa beans and milk, then compact the fluid."
		"The bar gives a brief Saturation effect, and it's the glaze for ruby marshmallows."
	]
	quest.190FD2DF12D222C0.quest_subtitle: "Heated mix of sugar, dragon's breath, cocoa beans and milk, then compact the fluid."
	quest.190FD2DF12D222C0.title: "&dBar of Ruby Chocolate"
	quest.192F3EF7093B1E89.quest_desc: [
		"One-piece propellant for quick-firing guns. Single-use per shot, then refill. Fit a Quick-Firing Mechanism to a sliding breech to use them by hand."
	]
	quest.192F3EF7093B1E89.quest_subtitle: "Quick-firing cannons load a cartridge in one go."
	quest.192F3EF7093B1E89.title: "&eBig Cartridges"
	quest.193D30AAA50152FA.quest_desc: [
		"Kill the Ender Dragon. That opens the outer End islands, including the Ruined Citadel and the rest of the End's loot."
	]
	quest.193D30AAA50152FA.quest_subtitle: "Kill the Ender Dragon. That opens the outer End islands, including the Ruined Citadel and the rest of the End's loot."
	quest.193D30AAA50152FA.title: "&5&lFree the End"
	quest.196BAC5655C17935.quest_desc: [
		"A compact ratio in one block. Follows the tiny cogs and worm gear when you need even more reduction or speedup."
	]
	quest.196BAC5655C17935.quest_subtitle: "A compact ratio in one block. Follows the tiny cogs and worm gear when you need even more reduction or speedup."
	quest.196BAC5655C17935.title: "&6Planetary Gear"
	quest.1970F0B8CFF70E5B.quest_desc: [
		"Milling &eLimestone&r is how you get &eSuspicious Rock&r — a rare extra besides calcium powder."
		"Hold &eW&r over the &eMillstone&r in EMI to see its Ponder."
	]
	quest.1970F0B8CFF70E5B.quest_subtitle: "Use the &6millstone&r to process &alimestone&r into &aSuspicious Rocks&r."
	quest.1970F0B8CFF70E5B.title: "&6Craft a Millstone"
	quest.19C5853C695A22A7.quest_desc: [
		"Keep a &eWrench&r in the hotbar. It is how you pick up Create blocks without a pickaxe, flip cogwheels, and reconnect belts after a rebuild."
		"Craft it alongside the goggles, then head into Andesite Age."
	]
	quest.19C5853C695A22A7.title: "Wrench"
	quest.19C5853C695A22A7.quest_subtitle: "A &6Wrench&r lets you instantly break most &6&lCreate&r blocks by &eShift + Right-clicking&r. And rotate them by &eRight-clicking&r. Your all-purpose friend you'll never leave home without again"
	quest.19D25E21CB4DD55C.quest_desc: [
		"Direct mode maps analog redstone straight to the output ratio. Incremental mode nudges a stored shift up or down from the two sides."
		"Switch modes on the value panel. Use it as a throttle or gear for engines and adapters. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.19D25E21CB4DD55C.title: "Redstone Transmission"
	quest.19D25E21CB4DD55C.quest_subtitle: "Direct mode maps analog redstone straight to the output ratio. Incremental mode nudges a stored shift up or down from the two sides."
	quest.1A030F9EF7768F15.quest_desc: [
		"Pipe oxygen in the back and kinetic power in from below. It only fills a sealed room, so goggle the machine and check the seal. Build this on the Moon so you can work without the suit."
	]
	quest.1A030F9EF7768F15.quest_subtitle: "Fill a sealed room with breathable air, so you can build a base without the suit. Its Ponder scene shows how to check the seal."
	quest.1A030F9EF7768F15.title: "&bOxygen Sealer"
	quest.1A2583C4031F9F8D.quest_desc: [
		"Upgrade Battlemage pieces with a Mark of Mastery, netherite, a Sturdy Sheet and 2 essences. 25 armour and 16 toughness, second only to Ignitium."
	]
	quest.1A2583C4031F9F8D.quest_subtitle: "Upgrade Battlemage armour: a Mark of Mastery, a netherite ingot, a Sturdy Sheet and 2 essences. 25 armour and 16 toughness for the set, second only to Cataclysm's Ignitium."
	quest.1A2583C4031F9F8D.title: "&c&lHeavy Elemental Armour"
	quest.1A2FD3A794560953.quest_desc: [
		"Buried in lush caves, dripstone caves or the deep dark, in newly generated land. The Harbinger is the boss."
	]
	quest.1A2FD3A794560953.quest_subtitle: "An ancient factory buried underground, in cave biomes such as lush caves, dripstone caves and the deep dark."
	quest.1A2FD3A794560953.title: "&6Ancient Factory"
	quest.1A389BBE7CDB0F96.quest_desc: [
		"Hang a &eHose Pulley&r over a lake, feed it a pipe, and it drinks or places fluid as the hose extends. A big enough pool never runs out — that is the next quest."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.1A389BBE7CDB0F96.title: "Hose Pulley"
	quest.1A389BBE7CDB0F96.quest_subtitle: "A &6Hose Pulley&r can be used to place or extract large bodies of liquid"
	quest.1A9BDF6B88E5A7A9.quest_desc: [
		"Obtained by Smoking or Bulk-Smoking Peats"
		""
		"You need &6Peat Briquettes&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.1A9BDF6B88E5A7A9.quest_subtitle: "Much better than Coal or Charcoal Briquettes"
	quest.1A9BDF6B88E5A7A9.title: "&aPeat Briquettes "
	quest.1AD963990297EBD1.quest_desc: [
		"Oa, Korugar, Odym, Okaara, Zamaron, Ysmault and Ryut are real Northstar planets in this pack. Reach every one with a lit ring and the star chart."
		""
		"The rocket path still works for Earth-system worlds. This goal is the ring path."
	]
	quest.1AD963990297EBD1.quest_subtitle: "All seven homeworlds by ring"
	quest.1AD963990297EBD1.title: "&aTo the Lantern Worlds"
	quest.1AFEF2789E7179B1.quest_desc: [
		"Stick a &eStressometer&r on any shaft to read used stress versus capacity. If new machines stop the whole line, this is the first block to look at."
	]
	quest.1AFEF2789E7179B1.title: "Stressometer"
	quest.1AFEF2789E7179B1.quest_subtitle: "A &6Stressometer&r lets you see the current stress and stress capacity of the kinetic network it's connected to"
	quest.1B3F3097CE12FE41.quest_desc: [
		"Connect two placed pieces to stretch a line — curves and slopes are allowed."
		"Make them on a sequenced assembly line: a stone slab (or similar sleeper), iron or zinc nuggets, then a &eMechanical Press&r."
		"You'll want a lot of track before you assemble the train."
	]
	quest.1B3F3097CE12FE41.quest_subtitle: "The thing your trains go on"
	quest.1B3F3097CE12FE41.title: "Train Track"
	quest.1B4EA9D4B62D0237.quest_desc: [
		"Two &eRedstone Contacts&r output a signal while they touch. Put one on a moving door or elevator and one on the landing so you know when it has arrived."
	]
	quest.1B4EA9D4B62D0237.title: "Redstone Contact"
	quest.1B4EA9D4B62D0237.quest_subtitle: "A &cRedstone Contact&r component that outputs a signal when in contact with another &cRedstone Contact&r. Particularly useful for building contraptions"
	quest.1B532265A50A9BCA.quest_desc: [
		"Each look starts from a Particle Blend, then becomes flame, smoke, soul fire, snow, or rainbow."
		"Purely visual. Craft one after the gold pack if you want the trail to match the hull."
	]
	quest.1B532265A50A9BCA.quest_subtitle: "Change your jetpack's exhaust: flame, smoke, soul fire, snow or rainbow. Each one starts from a Particle Blend."
	quest.1B532265A50A9BCA.title: "&dParticle Customizer"
	quest.1B62CFE5C700C5C5.quest_desc: [
		"A Nether forge in the wastes, soul sand valleys, or crimson and warped forests. The Netherite Monstrosity waits inside."
	]
	quest.1B62CFE5C700C5C5.quest_subtitle: "In the Nether: nether wastes, soul sand valleys, crimson and warped forests."
	quest.1B62CFE5C700C5C5.title: "&6Soul Black Smith"
	quest.1B67448AD335E5E4.quest_desc: [
		"It grabs the block in front. Add rock-cutting wheels and a storage container and you have a drill that auto-collects drops."
		"It reverses rotation and spins at a quarter of the input RPM. Extract from the bearing when the internal storage fills, or it stops. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.1B67448AD335E5E4.title: "Borehead Bearing"
	quest.1B67448AD335E5E4.quest_subtitle: "An &8Borehead Bearing&r is used to create boreheads"
	quest.1B6AE2D9EE970BD3.quest_desc: [
		"Fill an &eEcho Cake Base&r at a Spout with Molten Echo. It's a Blaze Cake upgrade that burns for a long while — special fuel for the Burner, not a snack."
	]
	quest.1B6AE2D9EE970BD3.quest_subtitle: "Ewww!"
	quest.1B6AE2D9EE970BD3.title: "&dEcho Cake"
	quest.1B7DD4402C5CD447.quest_desc: [
		"Obtained by using a Deployer equipped with a &eFlint and Steel&r and to deploy it onto a &aInactive Blaze Core&r"
	]
	quest.1B7DD4402C5CD447.quest_subtitle: "Most expensive way to cook steaks"
	quest.1B7DD4402C5CD447.title: "&cBlaze Core"
	quest.1B8593B519AF35AF.quest_desc: [
		"Mechanical-crafted. Together with the barrel and firing mechanism it is the core of every Create Armorer gun, starting with the Stress pistol."
	]
	quest.1B8593B519AF35AF.quest_subtitle: "Mechanical-crafted. Needed for every Create Armorer gun."
	quest.1B8593B519AF35AF.title: "&eTrigger Mechanism"
	quest.1B89EA5E54DE9178.quest_desc: [
		"Crush &eEnd Stone&r on &eCrushing Wheels&r. You get powder, and sometimes the stone back."
		"Four powder plus zinc nuggets and water mix, heated, into Levitite Blend."
	]
	quest.1B89EA5E54DE9178.title: "End Stone Powder"
	quest.1B89EA5E54DE9178.quest_subtitle: "Crush &eEnd Stone&r on &eCrushing Wheels&r. You get powder, and sometimes the stone back."
	quest.1BC069B1D52BB54C.quest_desc: [
		"Craft Tropical Stew shapeless from a Coconut Slice and Crab Meat. It restores 10 hunger, and the empty husk is returned when you finish the bowl."
	]
	quest.1BC069B1D52BB54C.quest_subtitle: "Coconut Slice and Crab Meat"
	quest.1BC069B1D52BB54C.title: "&6Tropical Stew"
	quest.1BE84A67C4F49130.quest_desc: [
		"Geode loot, and the starting ingredient for Optical Devices. You'll also need them for tinted glass."
	]
	quest.1BE84A67C4F49130.quest_subtitle: "Geode loot, and the starting ingredient for Optical Devices. You'll also need them for tinted glass."
	quest.1BE84A67C4F49130.title: "&dAmethyst Shards"
	quest.1BF8883F64D94AFC.quest_desc: [
		"Optional side path: the stock TACZ table crafts guns that are not on the Create Armorer line. Iron, logs and an iron block. The Mechanical Crafter remains the main route."
	]
	quest.1BF8883F64D94AFC.title: "Gun Smith Table"
	quest.1BF8883F64D94AFC.quest_subtitle: "Optional side path: the stock TACZ table crafts guns that are not on the Create Armorer line. Iron, logs and an iron block. The Mechanica..."
	quest.1C709492F2F78BB9.quest_desc: [
		"The Access Port fattens a chest's face so filters and switches can reach it. The Inventory Bridge sits between two inventories and sorts with its own filter slots."
	]
	quest.1C709492F2F78BB9.quest_subtitle: "Attach to any inventory to expand its surface area. Great for access in tight spaces and smart setups with threshold switches. - Provides an interface to access two inventories simultaneously. Also comes with filter slots to quickly sort incoming items"
	quest.1C709492F2F78BB9.title: "&aInventory Access Port"
	quest.1C8B708C362B156F.quest_desc: [
		"Eat them for a little mana, or cook them later with Ars Delight. Plant a bush near your base so you never run out."
	]
	quest.1C8B708C362B156F.quest_subtitle: "They restore a little mana when eaten."
	quest.1C8B708C362B156F.title: "&2Sourceberries"
	quest.1C901D6957027EB8.quest_desc: [
		"&eWelcome to Create Kitchen&r. Complete it by obtaining &6Welcome to Create Kitchen&r."
		""
		"Opens after create:mechanical_arm (Brass Age)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.1C901D6957027EB8.quest_subtitle: "Welcome to Create: Kitchen! It includes three different types of mods designed to help you automate food production, cooking, and farming"
	quest.1C901D6957027EB8.title: "&eWelcome to Create Kitchen"
	quest.1C982C9E827813C5.quest_desc: [
		"The &eSteering Wheel&r is precise rotation you hold and turn. Sensors speak redstone: altitude, speed along one axis, and tilt from the gimbal."
		"&eSymmetric Sails&r only add drag, which is what you want for fins and windmill blades. Regular Create sails add lift when the hull is moving. Hold &eW&r over them in EMI to see their Ponder."
	]
	quest.1C982C9E827813C5.quest_subtitle: "The &eSteering Wheel&r is precise rotation you hold and turn. Sensors speak redstone: altitude, speed along one axis, and tilt from the g..."
	quest.1C982C9E827813C5.title: "Sail Equipments"
	quest.1C9DFE7DD07C9F77.quest_desc: [
		"Capstone for Steam 'n' Rails: a working railway, not a parked locomotive."
		"Two named stations, a signal somewhere on the line, and a train following a schedule is enough to tick this off."
	]
	quest.1C9DFE7DD07C9F77.quest_subtitle: "Run a line with at least two stations, a signal, and a train on a schedule. Tick this off when it's running on its own."
	quest.1C9DFE7DD07C9F77.title: "&6Railway Network"
	quest.1D0911E494CA0184.quest_desc: [
		"Sneak-right-click inventories to teach a &eMechanical Arm&r its inputs and outputs. It only works if every target is inside its reach, and it needs stress to move."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.1D0911E494CA0184.title: "Mechanical Arm"
	quest.1D0911E494CA0184.quest_subtitle: "A &6Mechanical Arm&r is an advanced item distribution machine that works by designating it to specific blocks the arm can reach. If it can't reach a location, the arm won't work. Requires &6SUs&r to operate"
	quest.1D2E9035CBEF5334.quest_desc: [
		"Place a &eHandcar&r on the track and pump the handles. No casing, no controls, no fuel."
		"Walk a new alignment with it before the real locomotive is ready."
	]
	quest.1D2E9035CBEF5334.quest_subtitle: "The smallest train there is, and it's powered by you. Handy for inspecting a new line."
	quest.1D2E9035CBEF5334.title: "&cHandcar"
	quest.1D4DB6859C74FDE5.quest_desc: [
		"Agronomic from growing crops, Mycelial from mushrooms, Vitalic from animals, Alchemical from potions. Park one on a Create farm and the jars stay full."
	]
	quest.1D4DB6859C74FDE5.quest_subtitle: "Crops growing, animals, food and potions can all make Source too. Pair one with your Create farms."
	quest.1D4DB6859C74FDE5.title: "&6More Sourcelinks"
	quest.1D8DB9025EC63135.quest_desc: [
		"Redstone fills the balloon above it with hot air. The panel sets max output; signal strength scales that output."
		"Lift falls off as air pressure drops with altitude, so a bigger envelope or more burners are how you keep climbing. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.1D8DB9025EC63135.title: "Adjustable Burner"
	quest.1D8DB9025EC63135.quest_subtitle: "An &8Hot Air Burner&r can be powered by &credstone&r to generate &aLift&r by filling balloons with hot air"
	quest.1D98174DC7159C28.quest_desc: [
		"Every pulse into a &ePowered Toggle Latch&r flips it. One button can start and stop a clutch without a separate off switch."
	]
	quest.1D98174DC7159C28.title: "Powered Toggle Latch"
	quest.1D98174DC7159C28.quest_subtitle: "A &cPowered Toggle Latch&r toggles its state with every redstone pulse"
	quest.1D9CB8D1389E13EB.quest_desc: [
		"Another leftover base, this time on Mars. Loot it, then get back to steel, seeds and electrolysis."
	]
	quest.1D9CB8D1389E13EB.quest_subtitle: "Another leftover base, this time on Mars. Loot it, then get back to steel, seeds and electrolysis."
	quest.1D9CB8D1389E13EB.title: "&cAbandoned Martian Base"
	quest.1DAB0F69BE29D8C5.quest_desc: [
		"Can also be used to create infinite &9water&r by extracting from a source block that has 2 source blocks adjacent to it"
	]
	quest.1DAB0F69BE29D8C5.quest_subtitle: "Since most blocks in &6&lCreate&r don't allow for manual extraction and insertion of liquids, these &6Fluid Pipes&r are rather useful"
	quest.1DAB0F69BE29D8C5.title: "Fluid Pipes"
	quest.1DAF719E2730E4CF.quest_desc: [
		"Each ion thruster has a small 4,000 FE buffer and draws more the harder it's throttled, so bring plenty of accumulators."
		"The &ePropulsion&r chapter covers crafting it."
	]
	quest.1DAF719E2730E4CF.quest_subtitle: "Thrust straight from FE: no shaft, no fuel, no exhaust. Feed it from the on-board accumulators and throttle it with redstone."
	quest.1DAF719E2730E4CF.title: "&bIon Thrusters"
	quest.1DC0B9D997DBD390.quest_desc: [
		"Craft an Iron Fillet Knife from two iron ingots and a stick."
		""
		"It counts as a knife, so it works on a Cutting Board and in a Slicer."
	]
	quest.1DC0B9D997DBD390.quest_subtitle: "A knife for board and Slicer"
	quest.1DC0B9D997DBD390.title: "&eIron Fillet Knife"
	quest.1DD12584ADBD1739.quest_desc: [
		"Imbue amethyst, or find them. Pedestals, the Enchanting Apparatus and the Scribe's Table all start here."
	]
	quest.1DD12584ADBD1739.quest_subtitle: "The base material of all Ars crafting."
	quest.1DD12584ADBD1739.title: "&5Source Gems"
	quest.1DF7367D76E81BFC.quest_desc: [
		"A village built around airships. Find it after Clockwork Village; everything in this chapter is inside the world border."
	]
	quest.1DF7367D76E81BFC.quest_subtitle: "A village built around airships. Find it after Clockwork Village; everything in this chapter is inside the world border."
	quest.1DF7367D76E81BFC.title: "&6Airship Village"
	quest.1DFD87B60DF28EA1.quest_desc: [
		"&eCreate Café&r. Complete it by obtaining &6Coffee Beans&r."
		""
		"Opens after create:millstone (Andesite Age) Coffee bushes and the fruit for the teas grow from seeds. Look in EMI for where each one comes from.."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.1DFD87B60DF28EA1.quest_subtitle: "Coffee and bubble tea, made by machine."
	quest.1DFD87B60DF28EA1.title: "&aCreate Café"
	quest.1E3081292571CD31.quest_desc: [
		"Heated mix of sugar, two cocoa powder and milk, spout it into a glass bottle, then craft the bottle with a marshmallow."
		"Drinking it grants Regeneration II."
	]
	quest.1E3081292571CD31.quest_subtitle: "Heated mix of sugar, two cocoa powder and milk, spout it into a glass bottle, then craft the bottle with a marshmallow."
	quest.1E3081292571CD31.title: "&cSoothing Hot Chocolate"
	quest.1E524894453AE0BB.quest_desc: [
		"A coastal Integrated Villages town. Same hunt as the Airship Village: walk, map, and keep an eye on the compass."
	]
	quest.1E524894453AE0BB.quest_subtitle: "A coastal Integrated Villages town. Same hunt as the Airship Village: walk, map, and keep an eye on the compass."
	quest.1E524894453AE0BB.title: "&6Pirate Village"
	quest.1E7326E5E8D2CDD9.quest_desc: [
		"The apparatus sits on an Arcane Core, with pedestals around it. This is Ars's main altar: trinkets, charms, book upgrades and rituals all pass through here."
	]
	quest.1E7326E5E8D2CDD9.quest_subtitle: "The apparatus on top of an arcane core, surrounded by pedestals: Ars Nouveau's main crafting altar."
	quest.1E7326E5E8D2CDD9.title: "&5Enchanting Apparatus"
	quest.1EB44121D6968D59.quest_desc: [
		"Mill wheat. Gingerdough and honey candy both call for it, so make a stack while the millstone is out."
	]
	quest.1EB44121D6968D59.title: "Wheat Flour"
	quest.1EB44121D6968D59.quest_subtitle: "Mill wheat. Gingerdough and honey candy both call for it, so make a stack while the millstone is out."
	quest.1EC85BA03D3DD7CC.quest_desc: [
		"When the ship parks with the two interfaces lined up, energy flows between them, so the dock can recharge the ship's accumulators."
	]
	quest.1EC85BA03D3DD7CC.quest_subtitle: "Like Create's Portable Storage Interface, but for FE. Put one on the ship and one at the dock, facing each other."
	quest.1EC85BA03D3DD7CC.title: "&aPortable Energy Interface"
	quest.1EE4A5C43CE2B840.quest_desc: [
		"Brass ingots and iron bars. Park it in front of an Encased Fan, then fill it so the fan blasts, washes, smokes, and more without a messy block in the world."
	]
	quest.1EE4A5C43CE2B840.quest_subtitle: "Brass ingots and iron bars. Park it in front of an Encased Fan, then fill it so the fan blasts, washes, smokes, and more without a messy ..."
	quest.1EE4A5C43CE2B840.title: "&lEmpty Fan Catalyst"
	quest.1F074F66679DDC25.quest_desc: [
		"Line the platform edge with &eStation Platforms&r so the gap to the carriage is tidy."
		"They don't affect the train — they're for the station build."
	]
	quest.1F074F66679DDC25.quest_subtitle: "Platform edges that sit flush against a passing train."
	quest.1F074F66679DDC25.title: "&7Station Platform"
	quest.1F4456568BDB3EAD.quest_desc: [
		"Glue &eContraption Controls&r onto an assembled machine and you can mute its drills, saws, or harvesters without taking the whole thing apart."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.1F4456568BDB3EAD.title: "Contraption Controls"
	quest.1F4456568BDB3EAD.quest_subtitle: "A &6Contraption Control&r let you turn off parts of contraptions while they are formed"
	quest.1F7C06CC0B7E5AC2.quest_desc: [
		"Find dormant martian seeds and wake them on a sequenced assembly line with water and potions. Plant the result in Mars soil: palm, sprout or tulip."
	]
	quest.1F7C06CC0B7E5AC2.quest_subtitle: "Dormant martian seeds wake up after a few rounds of filling. Grow them in Mars soil."
	quest.1F7C06CC0B7E5AC2.title: "&aMartian Garden"
	quest.1F7FB165C4C74D16.quest_desc: [
		"Casing, primer and powder on a sequenced assembly belt. Automate it now: the Armory and every gun after this will empty your pockets."
	]
	quest.1F7FB165C4C74D16.quest_subtitle: "Casing, primer and powder in a sequenced assembly line. Automate it early: guns get hungry."
	quest.1F7FB165C4C74D16.title: "&6Assembled Ammo"
	quest.1FD1E0A2EF4B63F9.quest_desc: [
		"They hold the extra ingredients around an Enchanting Apparatus. You will want a ring of them before you craft the apparatus itself."
	]
	quest.1FD1E0A2EF4B63F9.quest_subtitle: "They hold the extra ingredients around an Enchanting Apparatus. You will want a ring of them before you craft the apparatus itself."
	quest.1FD1E0A2EF4B63F9.title: "&5Arcane Pedestals"
	quest.1FD40934312DF437.quest_desc: [
		"Place a &eWine Cellar&r and put grape pomace in it. Red and white pomace each make different wines."
		"It is slow. Come back later, or start cider in the meantime."
	]
	quest.1FD40934312DF437.quest_subtitle: "Pomace matures into wine here. It takes a while."
	quest.1FD40934312DF437.title: "&5Wine Cellar"
	quest.1FD5D2A8CEB4D418.quest_desc: [
		"A small-terrain wheel: one &eRubber Sheet&r and a shaft. Right-click it onto a &eWheel Mount&r."
		"Light carts and tight trails. Step up a size if the chassis starts burying the rim."
	]
	quest.1FD5D2A8CEB4D418.title: "Small Tire"
	quest.1FD5D2A8CEB4D418.quest_subtitle: "A small-terrain wheel: one &eRubber Sheet&r and a shaft. Right-click it onto a &eWheel Mount&r."
	quest.1FE0DB58676C394D.quest_desc: [
		"Slide these into a thruster's upgrade slot. Smoking, smelting, and haunting cook items on nearby depots in the exhaust; propulsion T1 doubles thrust and fuel use."
		"T2 and T3 wait behind this quest."
	]
	quest.1FE0DB58676C394D.quest_subtitle: "Slide these into a thruster's upgrade slot. Smoking, smelting, and haunting cook items on nearby depots in the exhaust; propulsion T1 dou..."
	quest.1FE0DB58676C394D.title: "Craft All Tier 1 on Thrusters"
	quest.1FE4FB9F61915D53.quest_desc: [
		"Apple, sweet berry, pumpkin or watermelon all count. Brew the fruit tea, then spout it into a cup that already has boba."
		"That's the drink half of this chapter's café."
	]
	quest.1FE4FB9F61915D53.quest_subtitle: "Brew a fruit tea, then spout it into a boba cup."
	quest.1FE4FB9F61915D53.title: "&dMilk Tea"
	quest.1FE8EA6FB9329269.quest_desc: [
		"The &b&lEcho Shard&r is the first step on the path towards creating the very powerful &5weapons and &5armors&r the Deep Dark&r provides."
		""
		"&l-&r While usually it's only found in the loot chests inside the &2Ancient City&r after many trials and errors certain &6Master Clerics&r have become able to synthesize it at the comfort of their own brewing stands letting you avoid the many dangers inside of these cities."
	]
	quest.1FE8EA6FB9329269.quest_subtitle: "The &b&lEcho Shard&r is the first step on the path towards creating the very powerful &5weapons and &5armors&r the Deep Dark&r provides."
	quest.1FE8EA6FB9329269.title: "&bEcho Shard"
	quest.1FFF9B91CA71694E.quest_desc: [
		"Pipe lava instead and the sprinkler becomes a cook-zone or a mob incinerator."
		"Keep it off your wooden kitchen."
	]
	quest.1FFF9B91CA71694E.quest_subtitle: "Lava applies a small amount of fire damage to entities below in a radius"
	quest.1FFF9B91CA71694E.title: "&cLava Bucket"
	quest.2005366DA716D1AA.quest_desc: [
		"Easily the longest part of our process the conversion of &6Netherite ingot&r to the &3&lEcho ingot&r needs us to repeat the five step process of "
		""
		"1&l-&r Pouring &cLava&r over it"
		"2&l-&r Pressing it"
		"3&l-&r Pouring some &dMolten Echo&r over it"
		"4&l-&r Applying a &eBlaze powder&r onto it"
		"5&l-&r And then pressing it again"
		""
		"&c&nFive times over&r&r"
		""
		"But at the end of this grueling process we will be the owner of a pristine condition &3&lEcho ingot&r"
	]
	quest.2005366DA716D1AA.quest_subtitle: "Easily the longest part of our process the conversion of &6Netherite ingot&r to the &3&lEcho ingot&r needs us to repeat the five step pro..."
	quest.2005366DA716D1AA.title: "&l&9Echo Ingot"
	quest.2005FA370149167D.quest_desc: [
		"Drop a filled bucket or a wet item onto an &eItem Drain&r and the liquid comes out the bottom into a pipe or tank. It is the spout in reverse."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.2005FA370149167D.title: "Item Drain"
	quest.2005FA370149167D.quest_subtitle: "An &6Item Drain&r allows for the extraction of liquids from items manually or automatically"
	quest.2039D4A01E3B0567.quest_desc: [
		"Integrated Stronghold replaces the vanilla one: bigger, meaner, and still the way to the End portal. Eyes of Ender find it."
	]
	quest.2039D4A01E3B0567.quest_subtitle: "Rebuilt by Integrated Stronghold: bigger, and more dangerous."
	quest.2039D4A01E3B0567.title: "&5The Stronghold"
	quest.2047D5978329D0AB.quest_desc: [
		"Bearing, head, crank, and a canister. Stand it over an oil chunk the scanner found, power the crank, and crude oil comes up."
	]
	quest.2047D5978329D0AB.quest_subtitle: "Bearing, head, crank, and a canister. Stand it over an oil chunk the scanner found, power the crank, and crude oil comes up."
	quest.2047D5978329D0AB.title: "Pumpjack"
	quest.20520A21C344BD5B.quest_desc: [
		"Odym is light gravity and cool air. Blue light. Jump from the chart the same way you reached Oa."
	]
	quest.20520A21C344BD5B.quest_subtitle: "Hope's world"
	quest.20520A21C344BD5B.title: "&bOdym"
	quest.205A0AC6DACC3521.quest_desc: [
		"Train cargo that looks like a shipping container. Holds a vault's worth and rides a train like any other cargo."
	]
	quest.205A0AC6DACC3521.quest_subtitle: "Train cargo that looks like train cargo."
	quest.205A0AC6DACC3521.title: "&7Shipping Containers"
	quest.20799AD96112AAFC.quest_desc: [
		"Better rods, hooks and bait, plus fish and crates from the deep. Neptune's Bounty is the crate that can hold Neptunium."
	]
	quest.20799AD96112AAFC.quest_subtitle: "Better fishing rods, hooks and bait, and loot from the deep. Neptunium comes from Neptune's Bounty."
	quest.20799AD96112AAFC.title: "&9Aquaculture"
	quest.20B73692143FEC05.quest_desc: [
		"Joy of Painting lets you paint on a canvas. Place an Easel (four sticks) and bring a Canvas and Palette."
		"Only one player can work an easel at a time."
	]
	quest.20B73692143FEC05.quest_subtitle: "Easel, canvas and palette"
	quest.20B73692143FEC05.title: "&eJoy of Painting"
	quest.20BA931A8B0BF63E.quest_desc: [
		"&eElemental Foci&r. Complete it by obtaining &6Lesser Fire Focus&r."
		""
		"Opens after Enchanting Apparatus (Ars Nouveau)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.20BA931A8B0BF63E.quest_subtitle: "From &eArs Elemental&r: a focus makes one school of magic stronger and cheaper. Imbue an amethyst shard with three essences and gold."
	quest.20BA931A8B0BF63E.title: "&dElemental Foci"
	quest.20C5CD8F80F0AC65.quest_desc: [
		"Ignis's metal. Combine it with an Ignitium Upgrade Smithing Template to turn netherite armour into Ignitium armour, the strongest in the pack."
	]
	quest.20C5CD8F80F0AC65.quest_subtitle: "Ignis's metal. With an Ignitium Upgrade Smithing Template it turns netherite armour into Ignitium armour."
	quest.20C5CD8F80F0AC65.title: "&6Ignitium"
	quest.212D44720DF1B4D6.quest_desc: [
		"Mechanical-craft the iron pack with gold sheets, a capacitor, and two Gadgets & Gizmos &eRCS Thrusters&r."
		"More speed, more FE. Particle customizers unlock at this tier, and diamond is the next upgrade."
	]
	quest.212D44720DF1B4D6.quest_subtitle: "Upgrade the iron jetpack in a Mechanical Crafter with gold sheets, a capacitor and two RCS Thrusters from Create Gadgets & Gizmos. Faster, and it holds more charge."
	quest.212D44720DF1B4D6.title: "&6Gold Jetpack"
	quest.215E6B958632937D.quest_desc: [
		"Take Compost from the Mechanical Composter."
		"An Item Drain empties it to 75 mB of liquid compost, a Mechanical Press turns it into Bone Meal, and it crafts into a Block of Compost or Tree Fertilizer."
	]
	quest.215E6B958632937D.quest_subtitle: "Drain it or press it"
	quest.215E6B958632937D.title: "&eCompost"
	quest.2165E80C52C79992.quest_desc: [
		"Press &bR &rwhile hovering over an item to view its Recipe"
		""
		"Press &bU &rwhile hovering over an item to view its Uses"
		""
		"Press &bC &rto Crawl"
		""
		"Press &bM &rto open the World Map"
		""
		"Press &bU &rto Create a New Waypoint"
		""
		"Press &bB &rto open your Backpack"
		""
		"{@pagebreak}"
	]
	quest.2165E80C52C79992.quest_subtitle: "Read my description! Make sure to scroll down."
	quest.2165E80C52C79992.title: "&9Important Controls"
	quest.220899EA628566A7.quest_desc: [
		"The last book: a nether star, a Totem of Undying and a Wilden Tribute at the apparatus. Tier 3 glyphs live here."
	]
	quest.220899EA628566A7.quest_subtitle: "The final spellbook: needs a nether star, a totem of undying and a Wilden Tribute."
	quest.220899EA628566A7.title: "&d&lArchmage Spell Book"
	quest.220D03EF87821AB8.quest_desc: [
		"A Depot and an Electron Tube. Attach the finished depot to a villager's workstation and it trades while you're away."
	]
	quest.220D03EF87821AB8.quest_subtitle: "A Depot and an Electron Tube. Attach the finished depot to a villager's workstation and it trades while you're away."
	quest.220D03EF87821AB8.title: "Materials for the &2Trading Depot"
	quest.22190D410ED6F5AB.quest_desc: [
		"Craft from an Item Vault and a Transmitter. When placed it creates a stock network; right-click an existing link before placing another to bind them."
		"Stock-linked Packagers make their attached inventory available. On request, items go into packages — the signal has unlimited range, but the boxes still need transport. Full redstone stops a link from broadcasting; analog power lowers its priority. Hold &eW&r over it in EMI."
	]
	quest.22190D410ED6F5AB.quest_subtitle: "One network, unlimited range"
	quest.22190D410ED6F5AB.title: "&eStock Link"
	quest.221C911599AF7E47.quest_desc: [
		"Craft a Tweaked Linked Controller from two Linked Controllers, Analog Levers, Electron Tubes, wooden buttons and a Precision Mechanism."
		"Right-click toggles it so your gamepad drives Redstone Link frequencies; sneak-right-click opens the bind GUI, and it can sit on a Lectern beside the Aeroworks desk."
	]
	quest.221C911599AF7E47.quest_subtitle: "Fly with a gamepad"
	quest.221C911599AF7E47.title: "&6Tweaked Linked Controller"
	quest.223A1E5B6E119BF3.quest_desc: [
		"The borehead and rock-cutting wheels in this chapter all want industrial iron in the build."
		"Keep a stack from Brass Age; the excavator branch starts here."
	]
	quest.223A1E5B6E119BF3.title: "Industrial Iron Block"
	quest.223A1E5B6E119BF3.quest_subtitle: "The borehead and rock-cutting wheels in this chapter all want industrial iron in the build."
	quest.223FE2F7B310B827.quest_desc: [
		"Craft glyphs here for the spellbook. You need the novice book and Source Gems. More glyphs mean better spells, including the Mage's book later."
	]
	quest.223FE2F7B310B827.quest_subtitle: "Craft spell glyphs here. More glyphs mean better spells."
	quest.223FE2F7B310B827.title: "&5Scribe's Table"
	quest.2246378717B9E80B.quest_desc: [
		"Extra glyphs (trail, momentum, ride, plow and more) plus threads, and a Spell Binder that stores extra spellbooks' worth of spells."
	]
	quest.2246378717B9E80B.quest_subtitle: "More glyphs and threads for your spells, plus the Spell Binder to carry extra spellbooks' worth of spells."
	quest.2246378717B9E80B.title: "&5Not Enough Glyphs"
	quest.22464F35204CBECE.quest_desc: [
		"Fill the empty catalyst so the fan smokes items. The heat stays inside the block instead of cluttering your processing line with campfires."
	]
	quest.22464F35204CBECE.quest_subtitle: "Fill the empty catalyst so the fan smokes items. The heat stays inside the block instead of cluttering your processing line with campfires."
	quest.22464F35204CBECE.title: "&7Fan Smoking Catalyst"
	quest.224866F50B6E1B18.quest_desc: [
		"EMI lists every Create Armorer gun under the &eMechanical Crafting&r category: search for &e@createimmersivetacz&r."
	]
	quest.224866F50B6E1B18.quest_subtitle: "Barrel, trigger and firing mechanism, plus a precision mechanism, in a mechanical crafter. Start with the Stress pistol."
	quest.224866F50B6E1B18.title: "&c&lYour First Gun"
	quest.227D8B17E7004F3A.quest_desc: [
		"Press platinum, then craft &eCable&r with redstone and black dye. The &eCable Relay&r is the junction."
		"Run them between Propulsion machines that need a wired link rather than redstone dust."
	]
	quest.227D8B17E7004F3A.quest_subtitle: "Press platinum, then craft &eCable&r with redstone and black dye. The &eCable Relay&r is the junction."
	quest.227D8B17E7004F3A.title: "Cable"
	quest.22AAD0DB4C56BA7A.quest_desc: [
		"The metal Create: Springs is built from. Springs store rotation and dump it in a burst."
		""
		"You need &6Spring Alloy&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.22AAD0DB4C56BA7A.quest_subtitle: "From &eCreate: Springs&r. Springs store rotation and release it all at once."
	quest.22AAD0DB4C56BA7A.title: "&bSpring Alloy"
	quest.22BCBE0EBE80FEC7.quest_desc: [
		"An &eAttribute Filter&r matches traits instead of a list — smeltable, a given mod, max stack size, and so on. Drop it in a brass funnel when the item IDs keep changing."
	]
	quest.22BCBE0EBE80FEC7.title: "Attribute Filter"
	quest.22BCBE0EBE80FEC7.quest_subtitle: "An &6Attribute Filter&r can filter by attributes like \"can be smelted\" or \"from Create&r\""
	quest.22D3778029D7B924.quest_desc: [
		"Belts are back because brass logistics sit on them. Run a line from your crafters and slot brass funnels, tunnels, and a &eMechanical Arm&r onto it next."
	]
	quest.22D3778029D7B924.quest_subtitle: "&6Mechanical Belts&r are useful for moving items either in a straight line or diagonally. Make sure to place a &6Shaft&r on each end so they can connect and work properly"
	quest.22D3778029D7B924.title: "Mechanical Belt"
	quest.22E0A1AA989B395B.quest_desc: [
		"In this pack it's made from a targeting computer, two circuits, a combustion chamber and three titanium sheets."
	]
	quest.22E0A1AA989B395B.quest_subtitle: "From the &eNorthstar-Aeronautics bridge&r: lets an Aeronautics airship travel between planets."
	quest.22E0A1AA989B395B.title: "&5Dimensional Drive"
	quest.23133D51200B5C08.quest_desc: [
		"Prismarine, a lightning rod, diamonds and a water bucket around an Eye of Ender. It finds an Acropolis in a warm ocean."
	]
	quest.23133D51200B5C08.quest_subtitle: "Crafted at a crafting table around an Eye of Ender. Throw it and it flies toward the nearest Acropolis."
	quest.23133D51200B5C08.title: "&eStorm Eye"
	quest.231C8943A649FD16.quest_desc: [
		"Stick it on a Fluid Tank to turn the tank into a Distillation Tower. Heat crude oil in that tower to split it into diesel and gasoline."
	]
	quest.231C8943A649FD16.title: "Distillation Controller"
	quest.231C8943A649FD16.quest_subtitle: "Apply a &fDistillation Controller&r to a &6Fluid Tank&r to create a &6Distillation Tower&r"
	quest.2321A90C9B2BA592.quest_desc: [
		"A Mechanical Press, a Fluid Tank, and a copper block. It presses with fluid pressure instead of a shaft alone — stronger, and it wants a fluid supply."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.2321A90C9B2BA592.quest_subtitle: "From &eDreams n' Desires&r: a stronger press driven by fluid pressure."
	quest.2321A90C9B2BA592.title: "&eHydraulic Press"
	quest.232B6570D09FD2CE.quest_desc: [
		"Couples only in the direction you configure. Reverse the input and it freewheels instead of fighting you."
	]
	quest.232B6570D09FD2CE.quest_subtitle: "A clutch that is only coupled if the input spins in the correct direction as configured"
	quest.232B6570D09FD2CE.title: "&6Freewheel Clutch"
	quest.236439AD7BB284E5.quest_desc: [
		"Campfire or smoker, not a furnace. Once toasted, the ruby chocolate branch opens."
		""
		"You need &6Caramelized Marshmellow On A Stick&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.236439AD7BB284E5.quest_subtitle: "Campfire or smoker, not a furnace. Once toasted, the ruby chocolate branch opens."
	quest.236439AD7BB284E5.title: "&eCaramelized Marshmallows on a Stick"
	quest.23B3F4127D33F0F0.quest_desc: [
		"Deploy an electron tube and redstone onto a golden sheet, then press — three loops. Most of the outputs are chips; the rest is scrap. You'll need one for the Sequenced Pulse Generator."
	]
	quest.23B3F4127D33F0F0.quest_subtitle: "A crafting ingredient for the Sequenced Pulse Generator"
	quest.23B3F4127D33F0F0.title: "&cControl Chip"
	quest.23BD46B40E91DF41.quest_desc: [
		"Carry a &eConductor Whistle&r and blow it to call a conductor-driven train to where you're standing."
		"You need a working conductor (cap on a toolbox) on that train first."
	]
	quest.23BD46B40E91DF41.quest_subtitle: "Call a train that a Conductor is driving to wherever you're standing."
	quest.23BD46B40E91DF41.title: "&bConductor Whistle"
	quest.23D0117E34FA7A51.quest_desc: [
		"Same job as the Receptor, built to take a heavier load. Crafted with a &eGolden Coil&r when the light bridge has to move more stress."
	]
	quest.23D0117E34FA7A51.quest_subtitle: "A heavier alternative to the &6Optical Receptor&r"
	quest.23D0117E34FA7A51.title: "&eHeavy Optical Receptor"
	quest.23DC1C4E25C076E8.quest_desc: [
		"A Lantern is a power battery: gold in the four corners, stained glass of the light, an Eye of Ender, and that light's key block (emerald for green, redstone for red, copper for orange, glowstone for yellow, lapis for blue, crying obsidian for indigo, amethyst for violet)."
		""
		"Or fill a &eLantern Frame&r at a spout with 1000 mB of that liquid light. Hold &eW&r over the frame in EMI to see its Ponder."
	]
	quest.23DC1C4E25C076E8.quest_subtitle: "The battery that feeds the ring"
	quest.23DC1C4E25C076E8.title: "&eYour Lantern"
	quest.240FE5358CFFD781.quest_desc: [
		"Craft any jetpack with the matching chestplate to wear armor and the pack in one slot."
		"Every tier has an armored version. Start from iron if you just want the extra plate while you learn the keys."
	]
	quest.240FE5358CFFD781.quest_subtitle: "Craft a jetpack together with a chestplate of the same material: armor and flight in one slot. Every tier has one."
	quest.240FE5358CFFD781.title: "&7Armored Jetpack"
	quest.242E73C55EA48037.quest_desc: [
		"Build a closed, airtight volume. Hot air fills from the top down; leftover blocks inside steal volume, and shafts need an envelope casing to stay airtight."
		"Dye them if you want colour. Pair with the burner you just made, or a steam vent for huge balloons. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.242E73C55EA48037.title: "White Envelope"
	quest.242E73C55EA48037.quest_subtitle: "A &fHot Air Envelope&r forms balloons on simulated contraptions and generates &aLift&r when heated from below by a powered &8Hot Air Burner&r or &6Steam Vent&r"
	quest.24351C29FD9BAD0B.quest_desc: [
		"Crushing a nautilus shell showers bone meal and experience, with a chance at a &eSpiky Shell&r. Keep feeding shells until you have enough for a Trident."
		"Hold &eW&r over &eCrushing Wheels&r in EMI to see their Ponder."
	]
	quest.24351C29FD9BAD0B.quest_subtitle: "This produces Spiky Shells."
	quest.24351C29FD9BAD0B.title: "&aThrow a &eNautilus Shell&a into the &6Crushing Wheel"
	quest.24693FD7ECC78DDF.quest_desc: [
		"Craft one &eAndesite&r with one iron nugget, or mix the same pair in a &eMechanical Mixer&r once you have one."
		""
		"This is the ingot for casings, shafts, and almost every machine in this chapter."
	]
	quest.24693FD7ECC78DDF.quest_subtitle: "Iron grit in gray stone — the workshop's bread."
	quest.24693FD7ECC78DDF.title: "&7The First Alloy"
	quest.24D3F7C523F5AB0B.quest_desc: [
		"Craft or mix Prismarine with copper nuggets for &ePrismarine Alloy&r, then stack two Alloy into a Rod."
		"Both go into the &eConduit Cage&r — and the Rods also make Tridents later."
	]
	quest.24D3F7C523F5AB0B.quest_subtitle: "Craft Prismarine Alloy and Prismarine Rod"
	quest.24D3F7C523F5AB0B.title: "&aObtain some &bPrismarine Alloy&r &aand &bPrismarine Rods&r"
	quest.25207A8A32465083.quest_desc: [
		"Sit a &ePackage Frogport&r on an inventory or under a chain conveyor. Name it, address packages to that name, and a frog hops them in or out."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.25207A8A32465083.title: "Package Frogport"
	quest.25207A8A32465083.quest_subtitle: "Sit a &ePackage Frogport&r on an inventory or under a chain conveyor. Name it, address packages to that name, and a frog hops them in or ..."
	quest.259BA7ADACF10913.quest_desc: [
		"Same idea as the Copper Coil, with gold — check EMI for the sequence. Unlocks the Heavy Optical Receptor."
	]
	quest.259BA7ADACF10913.quest_subtitle: "Same idea as the Copper Coil, with gold — check EMI for the sequence. Unlocks the Heavy Optical Receptor."
	quest.259BA7ADACF10913.title: "&eGolden Coil"
	quest.25B0E3DC2762B231.quest_desc: [
		"Optional Create train advancements: long trips, portals, whistles, crashes and a track factory."
		"None of these are required to finish the chapter. They're excuses to take the locomotive out."
	]
	quest.25B0E3DC2762B231.quest_subtitle: "Optional Create train advancements: long trips, portals, whistles, crashes and a track factory."
	quest.25B0E3DC2762B231.title: "&bChallenges"
	quest.25DABD7C2D1C733C.quest_desc: [
		"Wear the &eCopper Diving Helmet&r with a charged &eBacktank&r and you breathe from the tank instead of the air meter."
		"Craft the matching boots so you can walk the seafloor instead of floating past it."
	]
	quest.25DABD7C2D1C733C.title: "Copper Diving Helmet"
	quest.25DABD7C2D1C733C.quest_subtitle: "A &6Diving Helmet&r lets you use air from an equipped tank to breathe underwater"
	quest.26250B86376A0525.quest_desc: [
		"Five candy canes in the axe shape. Craft it from the canes, not the block."
		""
		"You need &6Candy Cane Axe&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.26250B86376A0525.quest_subtitle: "Five candy canes in the axe shape. Craft it from the canes, not the block."
	quest.26250B86376A0525.title: "&eCandy Cane Axe"
	quest.26448F616ABCCAF2.quest_desc: [
		"Place &eFluid Tanks&r against each other to grow a boiler or a storage tower. Windows show the fluid; pumps and pipes are how you fill them."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.26448F616ABCCAF2.title: "Fluid Tank"
	quest.26448F616ABCCAF2.quest_subtitle: "A &6Fluid Tank&r is the main block used for bulk fluid storage"
	quest.264ECBCC1FAC046E.quest_desc: [
		"Oa is a real Northstar planet in this pack: breathable, 22 °C, a little under Earth gravity. The bridge reads the world out of Create: Lanterns and lands you in its sky."
		""
		"Jump from the star chart. The trip costs ring charge (a few percent, more the further you go, capped). Look for Oa grass, the Central Power Battery structure, and wrecks."
	]
	quest.264ECBCC1FAC046E.quest_subtitle: "Home of the Green Lanterns"
	quest.264ECBCC1FAC046E.title: "&aOa"
	quest.2689B97A89F4DEAC.quest_desc: [
		"&eSteam 'n' Rails&r. Complete it by obtaining &6Railway Casing&r."
		""
		"Opens after create:sturdy_sheet (Locomotive Age) Finish the Trains chapter first if you haven't built a train yet. This chapter assumes you have. Almost every block here has a Ponder scene: hold W over it in EMI.."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.2689B97A89F4DEAC.quest_subtitle: "Everything Create's trains are missing: new track, signals, couplers, liquid fuel, and a lot of train décor."
	quest.2689B97A89F4DEAC.title: "&6Steam 'n' Rails"
	quest.26B389AF4D077CA9.quest_desc: [
		"Packed gunpowder in a charge bag: standard big-cannon propellant. Match the charge to the barrel; cast iron does not like being over-gassed."
	]
	quest.26B389AF4D077CA9.quest_subtitle: "Packed gunpowder in a charge bag. One charge per barrel, roughly."
	quest.26B389AF4D077CA9.title: "&ePowder Charges"
	quest.26B4A91A3C2366EA.quest_desc: [
		"It reads your train schedules, so name your stations and set up schedules first."
		""
		"You need &6Navigator&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.26B4A91A3C2366EA.quest_subtitle: "From &eCreate Railways Navigator&r: plan a trip between any two stations, with changes, live departure times and delays."
	quest.26B4A91A3C2366EA.title: "&aNavigator"
	quest.26B5A6A7FB0A963E.quest_desc: [
		"Cassava grows from its own seeds — EMI shows where those drop. Process it into tapioca pearls."
		"Once you have &eBoba&r, you're ready for milk tea."
	]
	quest.26B5A6A7FB0A963E.quest_subtitle: "Tapioca pearls, from cassava."
	quest.26B5A6A7FB0A963E.title: "&dBoba"
	quest.26BBBFBDBB4FB5EA.quest_desc: [
		"An Integrated Villages town full of Create machines. Loot, ideas, and a lead toward the Airship and Pirate villages."
	]
	quest.26BBBFBDBB4FB5EA.quest_subtitle: "A village full of Create machines."
	quest.26BBBFBDBB4FB5EA.title: "&6Clockwork Village"
	quest.26EEB682FF3E8BED.quest_desc: [
		"Craft a Copycat Box from six Copycat Boards."
		"Six boards make the box. Craft it after the zinc boards."
	]
	quest.26EEB682FF3E8BED.quest_subtitle: "Six boards"
	quest.26EEB682FF3E8BED.title: "&eCopycat Box"
	quest.26FA15C0D2681972.quest_desc: [
		"Any one wine from the cellar counts: merlot, pinot, chardonnay and the rest."
		"Drink it, cellar more, or move on to cider if you have apples handy."
	]
	quest.26FA15C0D2681972.quest_subtitle: "Any one wine from the cellar counts: merlot, pinot, chardonnay and the rest."
	quest.26FA15C0D2681972.title: "&5A Fine Vintage"
	quest.273170D88255F4D6.quest_desc: [
		"Cut them on a Mechanical Saw; each calibre has its own casing, from pistol up to 40mm. They go onto the sequenced assembly line with a primer and powder."
	]
	quest.273170D88255F4D6.quest_subtitle: "Cut on a mechanical saw. Each ammo type has its own casing."
	quest.273170D88255F4D6.title: "&6Casings"
	quest.27365E92FE356663.quest_desc: [
		"Conductors can drive trains, ride along and work switches. The cap's &bPonder&r scene shows how to make one."
	]
	quest.27365E92FE356663.quest_subtitle: "A dyeable cap, and the start of everything to do with Conductors."
	quest.27365E92FE356663.title: "&bConductor's Cap"
	quest.27491161DE9F796A.quest_desc: [
		"A large IDAS fortress. Heavier loot and heavier fights than the castle."
		""
		"You need &6Tinker's Citadel&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.27491161DE9F796A.quest_subtitle: "A large IDAS fortress. Heavier loot and heavier fights than the castle."
	quest.27491161DE9F796A.title: "&6Tinker's Citadel"
	quest.27C041D46B670E00.quest_desc: [
		"Mechanical-crafted. It is the first of three parts every Create Armorer gun shares, before the trigger and firing mechanism."
	]
	quest.27C041D46B670E00.quest_subtitle: "Mechanical crafting."
	quest.27C041D46B670E00.title: "&eGun Barrel"
	quest.27E521E443209518.quest_desc: [
		"Two extended connectors seek each other, then lock into a rigid dock that still keeps both sides as separate assemblies."
		"Once locked, items and fluids can pass if you insert and extract on both sides. Retract either connector to undock. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.27E521E443209518.title: "Docking Connector"
	quest.27E521E443209518.quest_subtitle: "Two extended connectors seek each other, then lock into a rigid dock that still keeps both sides as separate assemblies."
	quest.281D6BAA6A343E88.quest_desc: [
		"Every rail this chapter uses: regular track for the line, then powered, detector, activator, and Create's controller rail."
		"Lay a loop first, then swap in the special rails where you need speed, sensing or a reverse."
	]
	quest.281D6BAA6A343E88.quest_subtitle: "Every rail this chapter uses: regular track for the line, then powered, detector, activator, and Create's controller rail."
	quest.281D6BAA6A343E88.title: "&aRails"
	quest.289D978A3CB3FE69.quest_desc: [
		"Cover a belt with &eAndesite Tunnels&r to split or merge lines. They only pass one item type per lane, which is plenty until brass tunnels."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.289D978A3CB3FE69.title: "Andesite Tunnel"
	quest.289D978A3CB3FE69.quest_subtitle: "An &6Andesite Tunnel&r is used to manage the flow of items on belts by splitting or merging production lines"
	quest.28CCB8868759C53B.quest_desc: [
		"Wear it on your head against smoke shells. It will not save you from lingering potions, dragon's breath or potion fluid blobs."
	]
	quest.28CCB8868759C53B.quest_subtitle: "For when the smoke shells come out."
	quest.28CCB8868759C53B.title: "&aGas Mask"
	quest.28DF4183D2B58BF6.quest_desc: [
		"Essential for us to make the &dEcho Cake&r the &d&lSculk flour&r is made by passing &9Sculk blocks&r through a pair of &6Crushing Wheels&r and pulverizing them to bits."
	]
	quest.28DF4183D2B58BF6.quest_subtitle: "Essential for us to make the &dEcho Cake&r the &d&lSculk flour&r is made by passing &9Sculk blocks&r through a pair of &6Crushing Wheels&..."
	quest.28DF4183D2B58BF6.title: "&dSculk Flours"
	quest.28E2042CD660FE69.quest_desc: [
		"You can search in REI for the fluids that apply by typing \\"$create:bottomless\\""
		""
		"You need &6Bottomless Lava&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.28E2042CD660FE69.quest_subtitle: "Some fluids can be infinitely extracted from the world as long as the pool the &6Hose Pulley&r is extracting from contains 10,000 or more source blocks"
	quest.28E2042CD660FE69.title: "Bottomless Lava"
	quest.2946D9F5206C1008.quest_desc: [
		"Repositories hold items; a Storage Lectern searches them. Bookwyrms help if you enchanted one. A Create-friendly alternative to walking chests."
	]
	quest.2946D9F5206C1008.quest_subtitle: "Link repositories to a storage lectern for a searchable storage system."
	quest.2946D9F5206C1008.title: "&5Magical Storage"
	quest.2958CA7FA6FD3E4F.quest_desc: [
		"The icon in the top left of the screen is the &aFTB Teams &rmenu. This allows you to add other players to your team"
		""
		"On the right of the &aFTB Teams &ricon is the &6Quest Book &ricon, which allows you to access the &6Quest Book &rat any time"
		""
		"When you click the square at the top left of your player display, your &8Curios &rslots will become visible. Some items, such as Elytras and Totems can be equipped here"
	]
	quest.2958CA7FA6FD3E4F.quest_subtitle: "Read my description!"
	quest.2958CA7FA6FD3E4F.title: "&2Inventory"
	quest.2976EA899A6A6DD9.quest_desc: [
		"Put a switch on a junction after the extra tracks are laid. Andesite is redstone-only; brass can also auto-set for the approaching train."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.2976EA899A6A6DD9.quest_subtitle: "Place a switch on a junction to flip it with redstone. The brass switch can also set itself for whatever train is coming."
	quest.2976EA899A6A6DD9.title: "&eTrack Switches"
	quest.29815D7316A451D6.quest_desc: [
		"&eOcean Monument&r. Complete it by obtaining &6Ocean Monument&r."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.29815D7316A451D6.quest_subtitle: "YUNG's Better Ocean Monuments"
	quest.29815D7316A451D6.title: "&eOcean Monument"
	quest.29882BA136A365CC.quest_desc: [
		"Press gold like any other plate. The Control Chip's sequenced assembly starts on a &eGolden Sheet&r."
	]
	quest.29882BA136A365CC.quest_subtitle: "Press gold like any other plate. The Control Chip's sequenced assembly starts on a &eGolden Sheet&r."
	quest.29882BA136A365CC.title: "&eGolden Sheet"
	quest.29BC2181C9AC3A60.quest_desc: [
		"A &6Mechanical Mixer&r over a &6Basin&r is how this age opens — shapeless crafts, potions, and soon brass itself."
		""
		"It needs at least &630 RPM&r. Ponder the mixer if the setup feels wrong; skip ahead only when something actually needs brass."
	]
	quest.29BC2181C9AC3A60.title: "&eThe Brass Threshold"
	quest.29BC2181C9AC3A60.quest_subtitle: "Heat, mix, and the machines start thinking."
	quest.29E0DB74CF948639.quest_desc: [
		"&eBatteries on Board&r. Complete it by obtaining &6Modular Accumulator&r."
		""
		"Opens after createaddition:modular_accumulator (Brass Age) This chapter puts Create Crafts & Additions power on Aeronautics ships. Accumulators built into a ship go with it when it's assembled, so the ship carries its own charge. Brass Age covers making them.."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.29E0DB74CF948639.quest_subtitle: "Store FE on the ship itself and your aircraft can fly with no fuel and no burner."
	quest.29E0DB74CF948639.title: "&eBatteries on Board"
	quest.29F3FCDB8B20E164.quest_desc: [
		"Shafts on every face. Top and bottom run at half speed, same trick as the Parallel Gearbox's internals."
	]
	quest.29F3FCDB8B20E164.quest_subtitle: "A gearbox with shafts on all 6 sides. Conceptually uses the same internal mechanism as Parallel Gearbox, so top and bottom spins at half speed"
	quest.29F3FCDB8B20E164.title: "&6The 6-way Gearboxes"
	quest.2A3DD4D92BF87C09.quest_desc: [
		"Sequenced assembly: polished diamond, a &eHardened Precision Mechanism&r, a Circuit, and two engraving passes. It goes into the Rocket Station, and later the Navigator and Dimensional Drive."
	]
	quest.2A3DD4D92BF87C09.quest_subtitle: "Tells a rocket where to go."
	quest.2A3DD4D92BF87C09.title: "&dTargeting Computer"
	quest.2A45646F93259D25.quest_desc: [
		"Same &eGearbox&r as Andesite Age, but here it unlocks the &eRotation Speed Controller&r and &eSequenced Gearshift&r. Place one in the brass line before those two."
	]
	quest.2A45646F93259D25.title: "Gearbox"
	quest.2A45646F93259D25.quest_subtitle: "The &6Gearbox&r is sort of like an extension cord, but for &6Shafts&r. It can change the direction of shafts, and can have more than one shaft attached to a different side of the gearbox"
	quest.2A5D792CD3695430.quest_desc: [
		"Stand a lightning rod next to a &eBlock of Experience&r and wait for a thunderstorm. A strike can super-heat the block into Super Experience."
	]
	quest.2A5D792CD3695430.quest_subtitle: "Place near the &2Block of Experience&r during a &bthunderstorm&r."
	quest.2A5D792CD3695430.title: "&6Lighting Rod"
	quest.2A6F8598292657FE.quest_desc: [
		"The &eDirectional Linked Receiver&r reads the angle to a matching Redstone Link: full strength dead ahead, weaker off-axis, nothing behind."
		"The &eModulating Linked Receiver&r reads distance instead, with a min and max range you set. Same item frequencies as normal links. Hold &eW&r over them in EMI to see their Ponder."
	]
	quest.2A6F8598292657FE.title: "Directional Linked Receiver"
	quest.2A6F8598292657FE.quest_subtitle: "The &eDirectional Linked Receiver&r reads the angle to a matching Redstone Link: full strength dead ahead, weaker off-axis, nothing behind."
	quest.2AB9E83773FD728C.quest_desc: [
		"Sits under the mount and turns it with Create rotation. Elevation is on the mount itself."
		""
		"You need &6Yaw Controller&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.2AB9E83773FD728C.quest_subtitle: "Rotate the whole mount with Create power."
	quest.2AB9E83773FD728C.title: "&cYaw Controller"
	quest.2AC910A3CE221B33.quest_desc: [
		"Create's clutch breaks the connection when powered. This one only connects when powered — handy for redstone that means go."
	]
	quest.2AC910A3CE221B33.quest_subtitle: "A clutch that is uncoupled unless powered"
	quest.2AC910A3CE221B33.title: "&6Inverted Clutch"
	quest.2AD31B4BEA4CB9F8.quest_desc: [
		"Blast Mercury's tungsten ore, or crush then blast the crushed raw. The &eRocket Waypoint&r is the machine that actually needs the ingots."
	]
	quest.2AD31B4BEA4CB9F8.quest_subtitle: "Smelt or crush Mercury's tungsten ore."
	quest.2AD31B4BEA4CB9F8.title: "&8Tungsten"
	quest.2AE3E90D07A627F5.quest_desc: [
		"An &eElectric Motor&r is a compact kinetic source powered by FE instead of water or steam. Set the RPM on it; faster speeds draw more energy."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.2AE3E90D07A627F5.title: "Electric Motor"
	quest.2AE3E90D07A627F5.quest_subtitle: "A &6Electric Motor&r converts &6Energy (E)&r into kinetic energy (&6SU&r) at any &6RPM&r"
	quest.2AEBE7EE1C6A3D00.quest_desc: [
		"Craft from leather, string and iron. After it is equipped, open it with the Open Backpack key (the Tutorial lists &eB&r)."
		"Augments such as Funnelling put picked-up items into the pack, and Hopper Bridge lets a hopper insert and extract while you stand on or in front of it. This is personal logistics; the stock network still handles the warehouse."
	]
	quest.2AEBE7EE1C6A3D00.quest_subtitle: "Carry the run, then dock it"
	quest.2AEBE7EE1C6A3D00.title: "&eBackpack"
	quest.2B00541A5EA7F062.quest_desc: [
		"Pipe a &eSteam Engine&r into it instead of using a redstone burner. One vent can fill far more envelope than a Hot Air Burner."
		"Save it for the giant endgame balloons the burner cannot keep up with. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.2B00541A5EA7F062.title: "Steam Vent"
	quest.2B00541A5EA7F062.quest_subtitle: "The &6Steam Vent&r works similarly to the &8Hot Air Burner&r, but uses a &6Steam Engine&r instead, allowing it to fill far more envelopes. Perfect for endgame giant air balloons"
	quest.2B2265A965603686.quest_desc: [
		"Capstone for the chapter: one drink (coffee, milk tea or wine) and one dessert (a novelty cake) made by machine, not by hand."
		"Tick this off when both lines are running."
	]
	quest.2B2265A965603686.quest_subtitle: "Automate one drink and one dessert from this chapter. Tick this off when both are made by machine."
	quest.2B2265A965603686.title: "&a&lOpen a Café"
	quest.2B41CDD40C717359.quest_desc: [
		"All eight bosses are down. Wear the armour, fuse the weapons, and you have finished this chapter."
	]
	quest.2B41CDD40C717359.quest_subtitle: "All eight bosses down."
	quest.2B41CDD40C717359.title: "&c&lCataclysm Conquered"
	quest.2B5AFCE5758657E9.quest_desc: [
		"A steam engine you can carry. Pairs with springs when you want kinetic power in a backpack."
	]
	quest.2B5AFCE5758657E9.quest_subtitle: "A steam engine small enough to carry around."
	quest.2B5AFCE5758657E9.title: "&bPortative Steam Engine"
	quest.2B5F6A8FDF29A2F8.quest_desc: [
		"Draw a structure with the &eSchematic Table&r and an empty schematic, then load it into the &eSchematicannon&r with gunpowder and the matching blocks."
		"It prints the build for you. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.2B5F6A8FDF29A2F8.title: "Schematicannon"
	quest.2B5F6A8FDF29A2F8.quest_subtitle: "The &6Schematicannon&r is a special type of machine used to build structures with the use of &6Schematics&r"
	quest.2B76FCB1361847B4.quest_desc: [
		"A &eSpeedometer&r shows RPM on the network it sits on. Check it before you merge two power sources — mismatched speeds stall both."
	]
	quest.2B76FCB1361847B4.title: "Speedometer"
	quest.2B76FCB1361847B4.quest_subtitle: "A &6Speedometer&r lets you see the rotational speed of a kinetic network"
	quest.2BA2507984D3E703.quest_desc: [
		"It thrusts when spun, and pitches itself along one axis so the blades try to face up. Needs a &eGyroscopic Mechanism&r."
		"Use it when a plain propeller would flop as the hull banks. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.2BA2507984D3E703.title: "Smart Propeller"
	quest.2BA2507984D3E703.quest_subtitle: "It thrusts when spun, and pitches itself along one axis so the blades try to face up. Needs a &eGyroscopic Mechanism&r."
	quest.2BBF0472DF2B705E.quest_desc: [
		"Impact goes off on a hit, timed after launch, proximity near a block. Craft the fuze onto the shell in a crafting grid; impact and proximity only work on the front."
	]
	quest.2BBF0472DF2B705E.quest_subtitle: "Impact, timed or proximity: put one on a shell in a crafting grid."
	quest.2BBF0472DF2B705E.title: "&4Fuzes"
	quest.2BC0A0977CD94919.quest_desc: [
		"Park flint on a depot in the channeling stream of a Cage-powered fan. It has a chance to become a &ePrismarine Shard&r."
	]
	quest.2BC0A0977CD94919.quest_subtitle: "Place it into a depot and wait for the Conduit Cage to convert it into Prismarine Shards."
	quest.2BC0A0977CD94919.title: "&aObtain &rFlint"
	quest.2BE761526F800B3C.quest_desc: [
		"The &eAltitude Sensor&r and &eTelemetry Reader&r go on an Aeronautics airship with a Dimensional Drive. They report height and ship readings so you can hit the trigger altitude for a planetary jump."
	]
	quest.2BE761526F800B3C.quest_subtitle: "Sensors for flying between worlds: altitude and readings from your ship."
	quest.2BE761526F800B3C.title: "&5Ship Telemetry"
	quest.2C3F196AA63F3573.quest_desc: [
		"Mechanical-crafted. Pair it with the barrel and trigger in the Mechanical Crafter for Your First Gun."
	]
	quest.2C3F196AA63F3573.quest_subtitle: "Mechanical-crafted. Pairs with the barrel and trigger in the gun recipe."
	quest.2C3F196AA63F3573.title: "&eFiring Mechanism"
	quest.2C45E9A1F0E829E0.quest_desc: [
		"Place a ritual tablet on a Brazier and light it for rain, growth, flight and other area effects. The Tattered Tome lists each tablet's recipe."
	]
	quest.2C45E9A1F0E829E0.quest_subtitle: "Light a ritual tablet on a brazier for effects across a whole area: rain, growth, flight, and more."
	quest.2C45E9A1F0E829E0.title: "&5Rituals"
	quest.2C770179FF6B1F73.quest_desc: [
		"To use this block, first you will need to &cattach it to a workstation&r that a Villager is using. After attaching this block to a station simply &dright click it with the items you want to trade&r and the next time the Villager comes to it's station the &eDepot&r will trade the items you stored into it for you and store what the Villager trades. &aLetting you trade with Villagers without needing to be present&r"
	]
	quest.2C770179FF6B1F73.quest_subtitle: "This block allows you to &atrade with Villagers&r more conveniently"
	quest.2C770179FF6B1F73.title: "&2Trading Depot"
	quest.2C7B4EE0E160A970.quest_desc: [
		"Powered, it accelerates minecarts. Unpowered, it brakes them to a stop."
		"You'll still want these on hills even if the rest of the line uses &eController Rails&r."
	]
	quest.2C7B4EE0E160A970.quest_subtitle: "Powered, it accelerates minecarts. Unpowered, it brakes them to a stop."
	quest.2C7B4EE0E160A970.title: "&6Powered Rail"
	quest.2C9437A8C1AF3E1C.quest_desc: [
		"Ryut has no air and sits at -60 °C. A lit ring is the whole life-support system. Black light's world; you are visiting, not joining."
	]
	quest.2C9437A8C1AF3E1C.quest_subtitle: "Vacuum, sixty below"
	quest.2C9437A8C1AF3E1C.title: "&8Ryut"
	quest.2CB9F0EB59BCA4A0.quest_desc: [
		"A Rocket Station rebuilt with lunar sapphire so incoming rockets put down where you placed it. Build one at each base you care about."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.2CB9F0EB59BCA4A0.quest_subtitle: "Brings rockets down where you want them."
	quest.2CB9F0EB59BCA4A0.title: "&bAuto-Landing Station"
	quest.2CBECC6DBE97B387.quest_desc: [
		"A sealed, liveable base on another world: air from a sealer, a Temperature Regulator, and a Rocket Waypoint to land on. Tick this off when you could live there without the suit."
	]
	quest.2CBECC6DBE97B387.quest_subtitle: "Set up a sealed, working base on another planet, with air, a temperature regulator and a landing pad. Tick this off when it's done."
	quest.2CBECC6DBE97B387.title: "&9&lSpace Colony"
	quest.2D0F4B50B4D29B55.quest_desc: [
		"A &ePulse Repeater&r waits a delay you set, then emits one short pulse even if the input stays on. That is how you fire a deployer once per cycle."
	]
	quest.2D0F4B50B4D29B55.title: "Pulse Repeater"
	quest.2D0F4B50B4D29B55.quest_subtitle: "A &cPulse Repeater&r sends a single pulse from a continuous redstone signal after a configurable amount of time"
	quest.2D3CC066DA89BE22.quest_desc: [
		"Crush andesite (and other stones and ores) into crushed material, then wash and melt it and cast ingots. EMI has the full chain — this crushed andesite is the first taste."
	]
	quest.2D3CC066DA89BE22.quest_subtitle: "Ores and metals as fluids: crush, wash and melt them into molten metal, then cast ingots. Check EMI for the steps."
	quest.2D3CC066DA89BE22.title: "&7Create: Metalwork"
	quest.2D490D75B73526E5.quest_desc: [
		"Crush &eLimestone&r on Crushing Wheels for the best chance; sand works too, just slower. Mix this with a &eSodium Catalyst&r to make titanium tetrachloride."
	]
	quest.2D490D75B73526E5.quest_subtitle: "Titanium starts on Earth: crush limestone or sand for rutile."
	quest.2D490D75B73526E5.title: "&7Rutile Concentrate"
	quest.2D6CCA806E1A76CD.quest_desc: [
		"A &ePulse Extender&r stretches a short click into a longer signal, long enough for a piston or door to finish moving."
	]
	quest.2D6CCA806E1A76CD.title: "Pulse Extender"
	quest.2D6CCA806E1A76CD.quest_subtitle: "A &cPulse Extender&r extends a pulse to a configurable duration"
	quest.2E31F85F781C4BCC.quest_desc: [
		"This amazing tool lets you &ahook yourself to a block and swing from it&r gaining momentum along the way and letting you launch yourself and get enough distance to hook yourself &ato the next block&r"
		""
		"You can even enchant it with the &dImpact enchantment&r to deal damage to whoever dares to get in your way"
		""
		"&o&8You can pair these with the&r &aSlime Boots&r &o&8and go even faster"
	]
	quest.2E31F85F781C4BCC.quest_subtitle: "This amazing tool lets you &ahook yourself to a block and swing from it&r gaining momentum along the way and letting you launch yourself ..."
	quest.2E31F85F781C4BCC.title: "&dGrapplin Whisk"
	quest.2E33A75857A2942A.quest_desc: [
		"A &eCannon Loader&r contraption rams charges and shells in; keep a Ram Rod for doing it by hand. Pair it with a sliding breech."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.2E33A75857A2942A.quest_subtitle: "A Cannon Loader pushes charges and shells in for you. Pair it with a sliding breech."
	quest.2E33A75857A2942A.title: "&6Automatic Loading"
	quest.2E907AC52B8EE2E9.quest_desc: [
		"Vectored thrust that burns liquid fuel instead of FE, so it can yaw and pitch without a battery bank."
		"Use it when the ship already has tanks and pipes but no accumulators. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.2E907AC52B8EE2E9.title: "Liquid Vector Thruster"
	quest.2E907AC52B8EE2E9.quest_subtitle: "An &6Liquid Vector Thruster&r is a directional thruster that can yaw and pitch using liquid fuel instead of &6FE&r energy"
	quest.2E9480FAA0567C61.quest_desc: [
		"Reinforce a Precision Mechanism with titanium nuggets and iron cogwheels on a sequenced assembly line. The &eRocket Station&r wants several; ordinary mechanisms would not last the shake."
	]
	quest.2E9480FAA0567C61.quest_subtitle: "A precision mechanism, reinforced. Rockets shake."
	quest.2E9480FAA0567C61.title: "&dHardened Precision Mechanism"
	quest.2EB02338D41A9E1F.quest_desc: [
		"Rub a lunar sapphire shard with sandpaper. You will need several for navigation beyond the Moon."
	]
	quest.2EB02338D41A9E1F.quest_subtitle: "Sand it with sandpaper."
	quest.2EB02338D41A9E1F.title: "&bPolished Sapphire"
	quest.2F0EAEBB4EF66163.quest_desc: [
		"A &eSpout&r filling salt with lava. Superheated mixing needs it for &eTitanium Tetrachloride&r and, later, hydrocarbon rocket fuel."
	]
	quest.2F0EAEBB4EF66163.quest_subtitle: "Spout lava onto salt."
	quest.2F0EAEBB4EF66163.title: "&7Sodium Catalyst"
	quest.2F3ED4F3FC8BFC07.quest_desc: [
		"Mix two iron ingots with coal in a heated mixer for two steel ingots. Stronger than cast iron, so built-up guns and autocannons can take more punishment."
	]
	quest.2F3ED4F3FC8BFC07.quest_subtitle: "Melt iron with coal in a superheated foundry basin."
	quest.2F3ED4F3FC8BFC07.title: "&7Steel"
	quest.2F4D033C31346B10.quest_desc: [
		"Projects text or an item in the air. Decorative, and useful as a label once you've got a &eZinc Coil&r."
	]
	quest.2F4D033C31346B10.quest_subtitle: "Displays text or items in a hologram style"
	quest.2F4D033C31346B10.title: "&aHologram Source"
	quest.2F5C0E54CEB11C7C.quest_desc: [
		"Industrialized Architecture adds ash bricks, metal doors, vents and brass lights. Stonecut ash brick blocks into slabs, stairs and ornate variants."
		"Metal plate blocks are also on the stonecutter in this pack."
	]
	quest.2F5C0E54CEB11C7C.quest_subtitle: "Ash bricks, vents and metal doors"
	quest.2F5C0E54CEB11C7C.title: "&eIndustrialized Architecture"
	quest.2F9A0EE894DCA760.quest_desc: [
		"Spruce is the example; EMI has every other wood. Each wood's slab goes through the same sequenced assembly as Create's stone track."
		"Use them to match the biome, then look at narrow, wide and monorail gauges."
	]
	quest.2F9A0EE894DCA760.quest_subtitle: "Steam 'n' Rails adds a train track for every wood. Like Create's track, it's made by sequenced assembly from that wood's slabs."
	quest.2F9A0EE894DCA760.title: "&6Track for Every Wood"
	quest.2FA092D064A16A6B.quest_desc: [
		"Macaw's Roofs adds steep roofs such as the Oak Roof."
		"Craft a Roofing Hammer and right-click the top of a roof to toggle between states."
	]
	quest.2FA092D064A16A6B.quest_subtitle: "Steep roofs and a hammer"
	quest.2FA092D064A16A6B.title: "&eMacaw's Roofs"
	quest.2FC2E358FBFDDDF7.quest_desc: [
		"&eLook Up&r. Complete it by obtaining &6Telescope&r."
		""
		"Opens after a Precision Mechanism (Brass Age). Northstar flies on rockets; Create: Lanterns is the other ascent if rings call louder. Every machine has a Ponder and a deep tooltip. Start with the Rocket Station ponder for the whole pad — then build only as far as your curiosity goes.."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.2FC2E358FBFDDDF7.quest_subtitle: "Steel to the planets — the factory's road into the dark."
	quest.2FC2E358FBFDDDF7.title: "&9Look Up"
	quest.2FCF57E09D4BB840.quest_desc: [
		"Put a &eCart Assembler&r over a rail, glue your machine to it, and send a minecart through. The whole structure rides the track like a cart."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.2FCF57E09D4BB840.title: "Cart Assembler"
	quest.2FCF57E09D4BB840.quest_subtitle: "A &6Cart Assembler&r allows for contraptions that traverse rails in the same way minecarts do"
	quest.3013102F588F3BB7.quest_desc: [
		"Give a &eClockwork Bearing&r two glued hands — a short one and a long one — and it turns them like a clock using the in-game time."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.3013102F588F3BB7.title: "Clockwork Bearing"
	quest.3013102F588F3BB7.quest_subtitle: "A &6Clockwork Bearing&r lets you create your own custom functional clock"
	quest.302167AFA048184F.quest_desc: [
		"Start with a burger bun instead of sliced bread. Same station, same ingredients, different shape."
		"Unique fillings can add a bonus effect — the station's tooltip lists the threshold."
	]
	quest.302167AFA048184F.quest_subtitle: "After crafting your first Chicken Sandwich, you gain access to a wide range of custom sandwich recipes, allowing you to create your own unique burgers"
	quest.302167AFA048184F.title: "&eMake a &3Burger"
	quest.3079DF976F5290C3.quest_desc: [
		"This is a custom claim system that is separate from &6OPAC&r, but integrated with its parties and allies system and claim amount"
		""
		"You can claim sub-levels (ships, aircraft, or anything) with the block using its &bGUI&r"
		""
		"{image:allofcreate:textures/qb_aeroclaims1.png width:100 height:100 align:center fit:true}"
		""
		"You will have to use Aero Claims depending on your sub-level size. Aero Claims are obtained by converting regular &6OPAC Claims&r into Aero Claims through the &bAeroClaims Menu&r"
		""
		""
		"{image:allofcreate:textures/qb-aeroclaims2.png width:100 height:100 align:center fit:true}"
	]
	quest.3079DF976F5290C3.title: "Claim Block"
	quest.3079DF976F5290C3.quest_subtitle: "Used for claiming sub-levels as they are seperate from regular claims"
	quest.309779606351AC6A.quest_desc: [
		"Crafted eight at a time from &eBrass Casing&r, iron sheets, a Precision Mechanism, and redstone. Charge it on one grid, then carry that stress somewhere else."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.309779606351AC6A.quest_subtitle: "Stores kinetic stress for later use. Retains charge in item form to enable long-distance energy transport. Battery capacity, RPM at discharge and stress impact values are all configurable"
	quest.309779606351AC6A.title: "&cKinetic Battery"
	quest.30CF131DFA9D542D.quest_desc: [
		"Moves stress from one network into another without joining them. If the far side jams, the source side keeps spinning."
	]
	quest.30CF131DFA9D542D.quest_subtitle: "Transfer stress capacity from one network to another while keeping the networks separate. Guarantees that the source network will not be affected when the destination network is overstressed"
	quest.30CF131DFA9D542D.title: "&bKinetic Bridge"
	quest.30D5CEA810CE1978.quest_desc: [
		"A &eSpout&r above a depot or belt pours fluid into buckets, bottles, and recipes — including the lava step on &eSturdy Sheets&r later."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.30D5CEA810CE1978.title: "Spout"
	quest.30D5CEA810CE1978.quest_subtitle: "A &6Spout&r is used for filling items with fluids and crafting certain items using fluids"
	quest.3103AA1D921B71BC.quest_desc: [
		"Hold right-click and drag to mark a volume of blocks as one contraption."
		"Every carriage has to be glued before the &eTrain Station&r will pick it up as a train."
	]
	quest.3103AA1D921B71BC.quest_subtitle: "As the name implies, &aSuper Glue&r allows you to glue blocks together. Particularly useful when making contraptions"
	quest.3103AA1D921B71BC.title: "&aSuper Glue"
	quest.313B89CDDEC26A69.quest_desc: [
		"A &eTrain Observer&r watching a stretch of track pulses redstone when a train (optionally matching a filter) rolls past. Use it to ring a speaker or open a door."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.313B89CDDEC26A69.title: "Track Observer"
	quest.313B89CDDEC26A69.quest_subtitle: "A &6Train Observer&r gives off a &credstone&r signal when detecting a train"
	quest.3151475431766DAF.quest_desc: [
		"A &eBrass Funnel&r takes a filter and can move whole stacks, unlike the andesite one. Use it when a belt needs to feed a crafter without dribbling one item at a time."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.3151475431766DAF.title: "Brass Funnel"
	quest.3151475431766DAF.quest_subtitle: "A &6Brass Funnel&r allows for filtering and higher stack sizes"
	quest.31AEA648B7854247.quest_desc: [
		"A storm-swept ruin in warm ocean. Scylla waits at the top."
		""
		"You need &6Acropolis&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.31AEA648B7854247.quest_subtitle: "A storm-swept acropolis in a warm ocean."
	quest.31AEA648B7854247.title: "&6Acropolis"
	quest.31B194BCD3165DFF.quest_desc: [
		"Create's mechanical drill and saw as tools you hold. Mine and cut without building a gantry."
	]
	quest.31B194BCD3165DFF.quest_subtitle: "Create's drill and saw, as tools."
	quest.31B194BCD3165DFF.title: "&eHandheld Drill and Saw"
	quest.31CC7F2DE56B10CD.quest_desc: [
		"&eBrass Tunnels&r filter per-exit and can split stacks. Replace andesite tunnels wherever a line has to choose a lane by item type."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.31CC7F2DE56B10CD.title: "Brass Tunnel"
	quest.31CC7F2DE56B10CD.quest_subtitle: "A &6Brass Tunnel&r is an upgrade to the &6Andesite Tunnel&r, allowing more configurability in how to deal with items"
	quest.31D73A024C2BD203.quest_desc: [
		"A combustion chamber, a propeller and titanium sheets. Place enough on the rocket that the station says it can lift; more mass needs more thrust."
	]
	quest.31D73A024C2BD203.quest_subtitle: "Thrust. A bigger rocket needs more of them: the station tells you if it can lift off."
	quest.31D73A024C2BD203.title: "&9Rocket Thrusters"
	quest.31DDD0BF009FA0DE.quest_desc: [
		"Quark adds extra building blocks such as framed glass."
		"The Trowel randomly places a block from your hotbar; extra copies of the same block raise its odds."
	]
	quest.31DDD0BF009FA0DE.quest_subtitle: "Building blocks and a Trowel"
	quest.31DDD0BF009FA0DE.title: "&eQuark"
	quest.3207FC214E81882A.quest_desc: [
		"Water in the fan's airflow washes items: gravel into flint, rusty leftovers into nuggets, concrete powder into concrete. A hose pulley later makes this infinite."
	]
	quest.3207FC214E81882A.title: "Water Bucket"
	quest.3207FC214E81882A.quest_subtitle: "When placed in front of the &6Encased Fan&r, &9water&r allows it to wash items"
	quest.320A501E80680EFF.quest_desc: [
		"Opposite poles pull together and try to line up; matching poles push apart. That magnetic force shows up on a Contraption Diagram."
		"Use a pair to latch a cart to a dock, or to hover one assembly over another. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.320A501E80680EFF.title: "Redstone Magnet"
	quest.320A501E80680EFF.quest_subtitle: "Opposite poles pull together and try to line up; matching poles push apart. That magnetic force shows up on a Contraption Diagram."
	quest.3219BEC774066F29.quest_desc: [
		"A giant desert beast. It drops a Sandstorm in a Bottle, a Remnant Skull and Ancient Metal."
	]
	quest.3219BEC774066F29.quest_subtitle: "A giant desert beast. It drops a Sandstorm in a Bottle, a Remnant Skull and Ancient Metal."
	quest.3219BEC774066F29.title: "&c&lAncient Remnant"
	quest.323F20F8AFC2C633.quest_desc: [
		"Explodes when it hits a powered &eActivator Rail&r, takes enough damage, or is lit."
		"Useful as a payload on a cart contraption — keep it off the assembler until you're ready."
	]
	quest.323F20F8AFC2C633.quest_subtitle: "Explodes when it hits a powered &eActivator Rail&r, takes enough damage, or is lit."
	quest.323F20F8AFC2C633.title: "&cMinecart with TNT"
	quest.326B2F79F3A9D8D7.quest_desc: [
		"Keep a sequenced assembly line running through one &eMechanical Press&r until the advancement pops."
		"You'll want that factory anyway if you plan a real railway."
	]
	quest.326B2F79F3A9D8D7.quest_subtitle: "Produce more than 1000 &fTrain Tracks&r with the same Mechanical Press"
	quest.326B2F79F3A9D8D7.title: "&6Track Factory"
	quest.326BB81BA22F0E4E.quest_desc: [
		"Gadgets that aren't on the main Create ages: crates and transporters, flanged cogs, grappling, slime armor, trading depots, and hypertubes. Opens after Andesite."
	]
	quest.326BB81BA22F0E4E.quest_subtitle: "&7Opens after &eAndesite, the Foundation&7 (Andesite Age)"
	quest.326BB81BA22F0E4E.title: "&d&lWelcome to the Fun Section"
	quest.328CE987F5B04421.quest_desc: [
		"Deep IDAS mines. Good for ores and a path toward the Frozen Crypt."
		""
		"You need &6Ancient Mines&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.328CE987F5B04421.quest_subtitle: "Deep IDAS mines. Good for ores and a path toward the Frozen Crypt."
	quest.328CE987F5B04421.title: "&7Ancient Mines"
	quest.32E829C0294F149D.quest_desc: [
		"Crafted from electron tubes, iron sheets and fluid pipes, two at a time. It is an ingredient in the filler, combustion chamber and later oxygen machines, not a room sealer."
	]
	quest.32E829C0294F149D.quest_subtitle: "Pulls oxygen from the air."
	quest.32E829C0294F149D.title: "&bOxygen Separator"
	quest.3331455E2E700AA1.quest_desc: [
		"Trinkets from dungeon chests and mimics. Lootr gives each player their own loot from a chest, so take what you find."
	]
	quest.3331455E2E700AA1.quest_subtitle: "Magical trinkets found in dungeon loot and mimic chests. Each player gets their own loot from a chest, thanks to Lootr."
	quest.3331455E2E700AA1.title: "&dArtifacts"
	quest.334E09BB534F212D.quest_desc: [
		"Obtained by filling a piece of Coal or a Charcoal with a Spout filled with Lava"
		""
		"You need &6Fiery Coal&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.334E09BB534F212D.quest_subtitle: "Who in the world needs this much fuel"
	quest.334E09BB534F212D.title: "&2Fiery Coal&r and &2Fiery Charcoal&r"
	quest.3365EE30271B51FA.quest_desc: [
		"Slap a nameplate on the hull so the assembly has a name in the world and on diagrams."
		"Dye variants exist if you want the plate to match the paint job."
	]
	quest.3365EE30271B51FA.title: "White Nameplate"
	quest.3365EE30271B51FA.quest_subtitle: "Used for naming Simulated Contraptions"
	quest.337BA8FE36665B99.quest_desc: [
		"A diode you program with a list of timed pulses. Drop a &eControl Chip&r in the recipe and you can fire redstone in a rhythm no repeater chain can match."
	]
	quest.337BA8FE36665B99.quest_subtitle: "A flexible diode that can output precisely timed redstone pulses according to a configured sequence"
	quest.337BA8FE36665B99.title: "&cSequenced Pulse Generator"
	quest.338718947D5318B3.quest_desc: [
		"Empty bottles of dragon's breath into a fluid. That liquid is what the dragon-breathing sail (and related fan processing) runs on."
	]
	quest.338718947D5318B3.quest_subtitle: "From &eCreate: Dragons Plus&r: empty bottles of dragon's breath into a fluid. It powers a new fan processing type."
	quest.338718947D5318B3.title: "&5Dragon's Breath"
	quest.338FEA7CB1A8309C.quest_desc: [
		"Four colours of tree in overworld archwood forests. Logs and planks from them are the wood of almost every Ars block."
	]
	quest.338FEA7CB1A8309C.quest_subtitle: "Archwood forests grow in the overworld, in four colours. Most Ars blocks are made from them."
	quest.338FEA7CB1A8309C.title: "&2Archwood"
	quest.33B3C5F33B18C4F3.quest_desc: [
		"Apply a &eSturdy Sheet&r to &eBrass Casing&r (or craft them shapeless together)."
		"Stations, controls and most other train blocks are made from this. Hold a casing and press &eAlt&r to pick a bogey style before placing it."
	]
	quest.33B3C5F33B18C4F3.quest_subtitle: "&7Opens after &ecreate:sturdy_sheet&7 (Locomotive Age)"
	quest.33B3C5F33B18C4F3.title: "&eTrain Casing"
	quest.34B833D58C45952C.quest_desc: [
		"The next step begins by &6heating&r a blaze burner that sits directly below a &aBasin&r and in that basin we are going to be compacting an &aEgg&r, a piece of &eSugar&r and lastly our &dSculk Flour&r which will give us a beatiful &dEcho Cake Base&r which will be used in the next step of our process"
	]
	quest.34B833D58C45952C.quest_subtitle: "The next step begins by &6heating&r a blaze burner that sits directly below a &aBasin&r and in that basin we are going to be compacting a..."
	quest.34B833D58C45952C.title: "&eEcho Cake Base"
	quest.34BDEA7471099252.quest_desc: [
		"Feed it coal (or another furnace fuel) and it pushes itself and any coupled carts along the rail."
		"The direction is set by the face you click when you add the fuel."
	]
	quest.34BDEA7471099252.quest_subtitle: "Feed it coal (or another furnace fuel) and it pushes itself and any coupled carts along the rail."
	quest.34BDEA7471099252.title: "&dMinecart with Furnace"
	quest.34CCB2CA93699AE1.quest_desc: [
		"Crush basalt on Earth, or compact brine in a heated basin. Spout lava onto the salt next to make the &eSodium Catalyst&r."
	]
	quest.34CCB2CA93699AE1.quest_subtitle: "Mix salt into water for brine, then compact brine back into salt. Salt plus lava in a spout makes the sodium catalyst."
	quest.34CCB2CA93699AE1.title: "&7Salt"
	quest.34F3123DD3182406.quest_desc: [
		"Layers steel sheets around a core and welds them into a built-up cannon. Those barrels handle bigger charges than a simple cast."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.34F3123DD3182406.quest_subtitle: "Built-up cannons are layered from sheets of steel and welded together: stronger, so they take bigger charges."
	quest.34F3123DD3182406.title: "&7Cannon Builder"
	quest.34F9C9456F031EEA.quest_desc: [
		"Four Andesite Alloy. Drop it on a heated basin to melt metal instead of mixing. Iron becomes molten cast iron for ingots or cannon moulds."
	]
	quest.34F9C9456F031EEA.quest_subtitle: "Put it on a heated basin and it melts metal instead of mixing it. Iron becomes molten cast iron."
	quest.34F9C9456F031EEA.title: "&6Basin Foundry Lid"
	quest.34FF589B697722F3.quest_desc: [
		"Any colour &eSeat&r works. Glue one onto a bearing, cart, or train so you ride with the contraption instead of walking beside it."
	]
	quest.34FF589B697722F3.quest_subtitle: "It's just a &6Seat&r, nothing more, nothing less. But if you're in a moving contraption, you might as well glue it to the contraption so you can sit and move along with it"
	quest.34FF589B697722F3.title: "Seat"
	quest.356481588F239F15.quest_desc: [
		"Fill the empty catalyst so the fan haunts items. Soul fire stays in the catalyst instead of sitting in the open."
	]
	quest.356481588F239F15.quest_subtitle: "Fill the empty catalyst so the fan haunts items. Soul fire stays in the catalyst instead of sitting in the open."
	quest.356481588F239F15.title: "&9Fan Haunting Catalyst"
	quest.356FAF5F07EE364F.quest_desc: [
		"Link warp scrolls into a Warp Index book, a Warp Nexus block, or a Stabilized Index. Travel between those points without standing at a waystone."
	]
	quest.356FAF5F07EE364F.quest_subtitle: "From &eArs Additions&r: link warp scrolls into a book or a block and travel between them."
	quest.356FAF5F07EE364F.title: "&bWarp Index"
	quest.3579EE70549D6DBF.quest_desc: [
		"Smith the helmet with netherite. Paired with the netherite tank it lets you breathe in lava the way copper does in water."
	]
	quest.3579EE70549D6DBF.title: "Netherite Diving Helmet"
	quest.3579EE70549D6DBF.quest_subtitle: "An upgraded version of the &6Copper Diving Helmet&r"
	quest.35A0F04B9F1AA77E.quest_desc: [
		"Assemble the rocket at the station, sit at the controls, and fly to Earth orbit. From there you can land on the Moon; Mars, Venus and Mercury wait on better navigation and fuel."
	]
	quest.35A0F04B9F1AA77E.quest_subtitle: "Launch a rocket and reach Earth orbit."
	quest.35A0F04B9F1AA77E.title: "&9&lLift-off!"
	quest.35C8929631187831.quest_desc: [
		"When a &ePackager&r on a chest or vault gets a redstone pulse, it wraps the contents into a package for Create's logistics."
		"Frogports, Robo Bees, and the Re-Packager all start from here. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.35C8929631187831.title: "Packager"
	quest.35C8929631187831.quest_subtitle: "A &6Packager&r will pack items from the connected inventory into a package when given &credstone&r power"
	quest.35D330C94DEF26DF.quest_desc: [
		"Spout honey, chocolate or jam onto the waffle, or cover it with spread."
		"Any of those four toppings completes this."
	]
	quest.35D330C94DEF26DF.quest_subtitle: "Spout honey, chocolate or jam onto the waffle, or cover it with spread."
	quest.35D330C94DEF26DF.title: "&eTopped Waffle"
	quest.3619EEA1236FDB0F.quest_desc: [
		"Put two trains on a collision course, reverse one of them, and let them meet."
		"Do it on a spare siding if you like your rolling stock intact."
	]
	quest.3619EEA1236FDB0F.quest_subtitle: "Crash into another &bTrain&r while driving backwards"
	quest.3619EEA1236FDB0F.title: "Blind Spot"
	quest.363D2EB468AC7D52.quest_desc: [
		"The coalburner is the task item; EMI lists woodburner, diesel radiator and the rest."
		"They puff while the train is moving, so they're an easy way to tell a consist is live."
	]
	quest.363D2EB468AC7D52.quest_subtitle: "Smokestacks puff smoke while the train runs. There are a dozen styles, from woodburner to diesel radiator."
	quest.363D2EB468AC7D52.title: "&7Smokestacks"
	quest.36668621669EDF51.quest_desc: [
		"Now that we obtained some &dEcho Shards&r it's now time for us to liquefy them using a &bsuper-heated&r blaze burner and a &6Mechanical Mixer&r setup to obtain some very pretty looking &3Molten Echo"
		""
		"&l-&r If you don't know how to super-heat you can feed our blaze burner a &6Blaze cake&r or give them a &fStraw&r so that you can make them drink some delicious &cLava&r you can find out how to do both of these things by following the &bCreate&r chapter of the questbook."
	]
	quest.36668621669EDF51.quest_subtitle: "Now that we obtained some &dEcho Shards&r it's now time for us to liquefy them using a &bsuper-heated&r blaze burner and a &6Mechanical M..."
	quest.36668621669EDF51.title: "&bMolten Echo Bucket"
	quest.369D8CB2365B6EE9.quest_desc: [
		"&eThe Moon&r. Complete it by obtaining &6The Moon&r."
		""
		"Opens after Lift-off! (Lift-off)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.369D8CB2365B6EE9.quest_subtitle: "Low gravity, no air, and lunar sapphire."
	quest.369D8CB2365B6EE9.title: "&7The Moon"
	quest.36B46804A7E0A38A.quest_desc: [
		"Refine diesel on the Pump Dat Oil line, then brew Northstar rocket fuel and put boots on Mars."
		""
		"Oil fields and orbital mechanics are one logistics story."
	]
	quest.36B46804A7E0A38A.quest_subtitle: "Diesel below, rockets above"
	quest.36B46804A7E0A38A.title: "&6Fuel for the Stars"
	quest.36B4BBB6EB3B49E2.quest_desc: [
		"Three &eSpiky Shells&r and two &ePrismarine Alloy Rods&r at a crafting table. Vanilla never let you craft this; now it's a factory product."
	]
	quest.36B4BBB6EB3B49E2.quest_subtitle: "Finally you can craft it."
	quest.36B4BBB6EB3B49E2.title: "&aCraft &dTrident"
	quest.36C23968F5A792B1.quest_desc: [
		"Cast, then drill. Longer guns take more barrel sections and can hold a bigger powder charge. Add a breech and a Cannon Mount next."
	]
	quest.36C23968F5A792B1.quest_subtitle: "Cast, bore, repeat. More barrels let you load bigger charges."
	quest.36C23968F5A792B1.title: "&8Cast Iron Barrels"
	quest.36C68A63A3A6C878.quest_desc: [
		"Diesel and biodiesel from Diesel Generators make good train fuel."
		""
		"You need &6Fuel Tank&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.36C68A63A3A6C878.quest_subtitle: "Trains can burn liquid fuel instead of coal. A Fuel Tank on the train holds it, and anything that fuels a blaze burner works."
	quest.36C68A63A3A6C878.title: "&cFuel Tanks"
	quest.36D50A6AFFF2346F.quest_desc: [
		"Dive for them, or channel &eSuspicious Rock&r in front of a Cage-powered fan. You'll crush one next for a shot at Spiky Shells."
	]
	quest.36D50A6AFFF2346F.quest_subtitle: "Nautilus Shells can be obtained from the ocean, or by bulk washing or channeling suspicious rocks."
	quest.36D50A6AFFF2346F.title: "&aObtain &eNautilus Shell"
	quest.36ECE457C7EB0613.quest_desc: [
		"Now that we have our liquid metal we are gonna need something strong enough to handle it luckily for us the &6Netherite ingot&r is just the ore for this job"
	]
	quest.36ECE457C7EB0613.quest_subtitle: "Now that we have our liquid metal we are gonna need something strong enough to handle it luckily for us the &6Netherite ingot&r is just t..."
	quest.36ECE457C7EB0613.title: "&6Netherite Ingot"
	quest.376F28B8624324AC.quest_desc: [
		"An &eAnalog Lever&r can sit at any redstone strength from 0 to 15. Use it when a binary lever is too blunt — lamp brightness, for example."
	]
	quest.376F28B8624324AC.title: "Analog Lever"
	quest.376F28B8624324AC.quest_subtitle: "An &cAnalog Lever&r can be set to output any redstone level. It's basically an upgraded version of the basic lever"
	quest.37760181A25650CE.quest_desc: [
		"A Schematic that stamps the same design over and over. Fill it like a normal schematic, then paint a floor or wall in a repeating pattern."
	]
	quest.37760181A25650CE.title: "Empty Pattern Schematic"
	quest.37760181A25650CE.quest_subtitle: "Pattern schematics can be used to repeat schematic designs multiple times"
	quest.378C3116EE6DD795.quest_desc: [
		"An &eAlternator&r turns spare SU into FE for the dock-side &ePortable Energy Interface&r."
		"Land, line the two interfaces up, and the ship's accumulators fill for the next leg. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.378C3116EE6DD795.quest_subtitle: "Power the dock-side interface from alternators, so every landing tops the batteries back up."
	quest.378C3116EE6DD795.title: "&aCharging Dock"
	quest.3794686E3CC0149C.quest_desc: [
		"A cursed knight. It drops Cursium ingots for Cursium armour."
		""
		"You need &6Maledictus&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.3794686E3CC0149C.quest_subtitle: "A cursed knight. It drops Cursium ingots for Cursium armour."
	quest.3794686E3CC0149C.title: "&c&lMaledictus"
	quest.37B6EB9A0B55CD09.quest_desc: [
		"An IDAS structure built for Ars. Find it in the overworld for loot and a look at a mage's workshop."
	]
	quest.37B6EB9A0B55CD09.quest_subtitle: "Find an Archmage's tower. It's an IDAS structure built for Ars Nouveau."
	quest.37B6EB9A0B55CD09.title: "&dArchmage's Tower"
	quest.37F3C6EA2B70D83A.quest_desc: [
		"Put &eConnectors&r on machines that take Energy, then right-click two of them with a wire. Small connectors reach 16 blocks at 1000 FE/t; large ones reach 32 at 5000 FE/t."
	]
	quest.37F3C6EA2B70D83A.title: "Connector"
	quest.37F3C6EA2B70D83A.quest_subtitle: "&6Connectors&r insert and extract energy from blocks, while &6Wires&r are used to link connectors"
	quest.381C4FE0A2071247.quest_desc: [
		"A heated Mechanical Mixer cooks Chorus Fruit Milk Tea from Chorus Fruit, Chorus Fruit Grain, a glass bottle and milk."
		""
		"Hold &eW&r over the Mixer in EMI to see its Ponder."
	]
	quest.381C4FE0A2071247.quest_subtitle: "Heated mixer, grain, bottle, milk"
	quest.381C4FE0A2071247.title: "&6Chorus Fruit Milk Tea"
	quest.3833A634FD2AC32D.quest_desc: [
		"Create Deco adds cage lamps, bars, doors and coins in Create metals."
		"In this pack, its sheet metal is made on the stonecutter."
	]
	quest.3833A634FD2AC32D.quest_subtitle: "Cage lamps, bars and coins"
	quest.3833A634FD2AC32D.title: "&eCreate Deco"
	quest.38419FFA03E72E3A.quest_desc: [
		"Right-click a &eRope Pulley&r with a chain. Same elevator, metal rope — better when you're already swimming in chains."
	]
	quest.38419FFA03E72E3A.quest_subtitle: "Right-click a &eRope Pulley&r with a chain. Same elevator, metal rope — better when you're already swimming in chains."
	quest.38419FFA03E72E3A.title: "&6Chain Pulley"
	quest.38830B6B945944C9.quest_desc: [
		"Heat a mixer: four &eEnd Stone Powder&r, two zinc nuggets, and water. Bucket the blend."
		"Pour it out and add heat to crystallize &eLevitite&r in the world. Once it starts, the crystal spreads through the whole fluid and you cannot pick the blend back up."
	]
	quest.38830B6B945944C9.title: "Levitite Blend Bucket"
	quest.38830B6B945944C9.quest_subtitle: "Heat a mixer: four &eEnd Stone Powder&r, two zinc nuggets, and water. Bucket the blend."
	quest.38B2EF3D559A5913.quest_desc: [
		"Scoop it off the Martian surface; it does not craft. Compact it with titanium and raw martian iron for steel."
	]
	quest.38B2EF3D559A5913.quest_subtitle: "Scoop it off the Martian surface; it does not craft. Compact it with titanium and raw martian iron for steel."
	quest.38B2EF3D559A5913.title: "&cVolcanic Ash"
	quest.38C6CA73A1BFB0CF.quest_desc: [
		"Five candy canes in the pickaxe shape. Same idea as the rest of the candy tool set."
		""
		"You need &6Candy Cane Pickaxe&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.38C6CA73A1BFB0CF.quest_subtitle: "Five candy canes in the pickaxe shape. Same idea as the rest of the candy tool set."
	quest.38C6CA73A1BFB0CF.title: "&eCandy Cane Pickaxe"
	quest.38D99DB222DF83E4.quest_desc: [
		"Sandpaper amethyst, then set three polished shards in iron and redstone. It is the lens of the &eCircuit Engraver&r; the Electrolysis Machine wants one later too."
	]
	quest.38D99DB222DF83E4.quest_subtitle: "Polished amethyst set in iron and redstone. The circuit engraver's lens."
	quest.38D99DB222DF83E4.title: "&dAmethyst Crystal"
	quest.38F8BF47857DCE77.quest_desc: [
		"Bogey styles aren't crafted. Pick them from Steam 'n' Rails' bogey menu while holding a Railway Casing. Its key is listed under Options > Controls."
	]
	quest.38F8BF47857DCE77.quest_subtitle: "Track made from metal girders. Monorail trains run on a single beam with a monorail bogey."
	quest.38F8BF47857DCE77.title: "&6Monorail"
	quest.391FA9B8D6B130A7.quest_desc: [
		"There are 3 main ways of getting &2Nuggets of Experiences&r: &6Crushing Wheels&r, &bdropped by slain Mobs&r or &dBottles of Experience&r."
	]
	quest.391FA9B8D6B130A7.quest_subtitle: "Don't right click it or you'll absorb it all"
	quest.391FA9B8D6B130A7.title: "&2Nuggets of Experience"
	quest.3928FD010478D80E.quest_desc: [
		"Faster than T2, and the processing upgrades reach a wider area. Propulsion T3 is eight times thrust."
		"Fuel use climbs with each propulsion tier, so upgrade the tanks before you slot T3 for a long burn."
	]
	quest.3928FD010478D80E.quest_subtitle: "Faster than T2, and the processing upgrades reach a wider area. Propulsion T3 is eight times thrust."
	quest.3928FD010478D80E.title: "Craft All Tier 3 on Thrusters"
	quest.39B7A2B0128DD9EC.quest_desc: [
		"Press 90 mB of molten brass in a basin to cast a &eRing Blank&r."
		""
		"This is the start of the Foundry line. You still need a ring of that light to recast a new one; the blank is the brass for the band."
	]
	quest.39B7A2B0128DD9EC.quest_subtitle: "Compact molten brass"
	quest.39B7A2B0128DD9EC.title: "&eRing Blank"
	quest.39E852852B8A1BCE.quest_desc: [
		"The Harbinger's metal. You need it, an anvil and redstone blocks to craft the Mechanical Fusion Anvil."
	]
	quest.39E852852B8A1BCE.quest_subtitle: "The Harbinger's metal."
	quest.39E852852B8A1BCE.title: "&8Witherite"
	quest.39F463F266C9A44C.quest_desc: [
		"A skinny way to jump rotation from one belt to the next-door belt without a bulky cog stack."
	]
	quest.39F463F266C9A44C.quest_subtitle: "Allowing you to relay &aRotational Force&r between two belts next to eachother in a smaller form factor"
	quest.39F463F266C9A44C.title: "&6Transmission Chain"
	quest.3A575A5853D61529.quest_desc: [
		"&eConfectionery&r. Complete it by obtaining &6Confectionery&r."
		""
		"Opens after the millstone (Andesite Age). Sugar, flour and cocoa go through mixers, presses and spouts into candy, chocolate and gingerbread. A millstone is enough to start; a heated mixer and a spout will finish most of the chapter.."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.3A575A5853D61529.quest_subtitle: "&7Opens after &ecreate:millstone&7 (Andesite Age)"
	quest.3A575A5853D61529.title: "Confectionery"
	quest.3A752CB0F94025B6.quest_desc: [
		"Craft two from wool and Andesite Alloy. Table cloths display items; with a Packager, Stock Link and Stock Ticker they also sell. Seat a mob or Blaze Burner as shop keeper, then interact with the keeper while holding a table cloth to create a trade and set a price on the side slot."
		"Other players check out at the cashier. Bought items pack into a package for the shop front; payments store inside the Stock Ticker. Hold &eW&r over a table cloth in EMI."
	]
	quest.3A752CB0F94025B6.quest_subtitle: "The shop front on your stock network"
	quest.3A752CB0F94025B6.title: "&eTable Cloth"
	quest.3A861B21F4724A9A.quest_desc: [
		"Right-click a Diesel Engine with it. The engine revs harder on the same fuel."
		""
		"You need &6Engine Turbocharger&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.3A861B21F4724A9A.title: "Engine Turbocharger"
	quest.3A861B21F4724A9A.quest_subtitle: "Use an &fEngine Turbocharger&r on a &6Diesel Engine&r to make it run faster"
	quest.3A86FB6788AF5201.quest_desc: [
		"Right-click the empty catalyst with sand. Compatible add-ons can bulk-sand through this fan without a sand block in the world."
	]
	quest.3A86FB6788AF5201.quest_subtitle: "Right-click the empty catalyst with sand. Compatible add-ons can bulk-sand through this fan without a sand block in the world."
	quest.3A86FB6788AF5201.title: "&eFan Sanding Catalyst"
	quest.3B64BED389B2CF9F.quest_desc: [
		"Heated mix of sugar, cocoa butter and milk — no cocoa beans, that's what makes it white."
		"Compact the fluid in a press and basin, same as the other chocolate bars."
	]
	quest.3B64BED389B2CF9F.title: "Bar of White Chocolate"
	quest.3B64BED389B2CF9F.quest_subtitle: "Heated mix of sugar, cocoa butter and milk — no cocoa beans, that's what makes it white."
	quest.3B70E9F32969E565.quest_desc: [
		"Phantom track vanishes unless you're holding track, so you can hide a line through scenery."
		"Tieless track is just the rails, for when the sleepers are already part of the build. Both still work with stations and signals."
	]
	quest.3B70E9F32969E565.quest_subtitle: "Phantom track is invisible unless you hold track, and tieless track is just the rails: both are for good-looking lines."
	quest.3B70E9F32969E565.title: "&6Phantom and Tieless Track"
	quest.3BD85D07B2A60A0B.quest_desc: [
		"Sequenced assembly on an iron sheet: deploy a cogwheel, a shaft, and a brass nugget, several loops."
		"You need it for the gimbal sensor here, and later for Aeronautics' &eSmart Propeller&r and &eGyroscopic Propeller Bearing&r."
	]
	quest.3BD85D07B2A60A0B.title: "Gyroscopic Mechanism"
	quest.3BD85D07B2A60A0B.quest_subtitle: "Sequenced assembly on an iron sheet: deploy a cogwheel, a shaft, and a brass nugget, several loops."
	quest.3C1F8C1753AF118A.quest_desc: [
		"A wither-machine hybrid. It drops a Witherite Block, which breaks into ingots for the Fusion Anvil."
	]
	quest.3C1F8C1753AF118A.quest_subtitle: "A wither-machine hybrid. It drops a Witherite Block, which breaks into ingots for the Fusion Anvil."
	quest.3C1F8C1753AF118A.title: "&c&lThe Harbinger"
	quest.3C2D6F3F116122BC.quest_desc: [
		"Bundle three sticks into &eKindling Sticks&r. They barely cook anything on their own — nine of them compact into a Stick Bundle that's actually worth burning."
	]
	quest.3C2D6F3F116122BC.quest_subtitle: "A basic fuel for the furnace."
	quest.3C2D6F3F116122BC.title: "&6Kindling Sticks"
	quest.3C4FD121C6C74A24.quest_desc: [
		"Macaw's Fences and Walls adds picket fences and decorative walls. An Oak Picket Fence is a simple sample."
	]
	quest.3C4FD121C6C74A24.quest_subtitle: "Picket fences and walls"
	quest.3C4FD121C6C74A24.title: "&eMacaw's Fences"
	quest.3C50975A0686EB72.quest_desc: [
		"With the mixer heated, brew until the basin holds &eAwkward Potion&r and pump it into a tank. Every other mixer potion starts from here."
	]
	quest.3C50975A0686EB72.quest_subtitle: "Used for creating different potions."
	quest.3C50975A0686EB72.title: "&aObtain &5Awkward potion"
	quest.3C5954636A9EE549.quest_desc: [
		"Use the &eTelescope&r to take readings on paper, then bind them into a &eSpace Atlas&r here. Rockets read that atlas for destinations."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.3C5954636A9EE549.quest_subtitle: "Study what the telescope shows. Rocket navigation depends on it."
	quest.3C5954636A9EE549.title: "&9Astronomy Table"
	quest.3CC5FD50C31A14CC.quest_desc: [
		"Iron sheets and glass panes. Together with amethyst they loop through deployers into an &eOptical Device&r."
	]
	quest.3CC5FD50C31A14CC.quest_subtitle: "These will be used to make our &5Optical Device"
	quest.3CC5FD50C31A14CC.title: "&eGather some supplies"
	quest.3CC91ACF67DE03C7.quest_desc: [
		"Upgrade gold with diamonds, precision mechanisms, two electric motors, and two Propulsion &eIon Thrusters&r."
		"Fast enough to cross a base in seconds. Netherite is the last hull."
	]
	quest.3CC91ACF67DE03C7.quest_subtitle: "Upgrade the gold jetpack with diamonds, precision mechanisms, two electric motors and two FE-powered Ion Thrusters from Create Propulsion. Fast enough to cross a base in seconds."
	quest.3CC91ACF67DE03C7.title: "&bDiamond Jetpack"
	quest.3CEE39555810FAE4.quest_desc: [
		"This chapter is a checklist of building and furniture mods. Each quest asks for any item from that mod."
		"Work the branches in any order; Master Builder waits at the end."
	]
	quest.3CEE39555810FAE4.quest_subtitle: "A tour of the pack's decoration mods"
	quest.3CEE39555810FAE4.title: "&6Welcome, Builder"
	quest.3D041D8923064C9A.quest_desc: [
		"A sticky &eMechanical Piston&r pushes a glued structure along &ePiston Poles&r. Extend, retract, and you have a linear drill or a hidden door."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.3D041D8923064C9A.quest_subtitle: "A &6Mechanical Piston&r allows for the linear movement of structures using rotational force"
	quest.3D041D8923064C9A.title: "Mechanical Piston"
	quest.3D3989E80BF08149.quest_desc: [
		"A brass &eElevator Pulley&r raises a glued cabin. Place &eRedstone Contacts&r at each floor so the cabin can stop and call, unlike a plain rope pulley."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.3D3989E80BF08149.title: "Elevator Pulley"
	quest.3D3989E80BF08149.quest_subtitle: "An &6Elevator Pulley&r allows for the creation of elevators and adding floors using Redstone Contacts"
	quest.3D65C935CDC38F88.quest_desc: [
		"Park a &eMechanical Press&r over a depot, belt, or basin. It flattens ingots into sheets and is also how you compact flowers into &eRubber&r."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.3D65C935CDC38F88.title: "Mechanical Press"
	quest.3D65C935CDC38F88.quest_subtitle: "The &6Mechanical Press&r is used for processing items provided beneath it on a depot or belt, or in a basin to compact"
	quest.3D6ADF4135A3BE48.quest_desc: [
		"Left versus right analog redstone sets a tilt angle; equal signals keep it centered."
		"Mount control surfaces or a vectored nozzle on it when a joystick should aim the ship. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.3D6ADF4135A3BE48.title: "Tilt Adapter"
	quest.3D6ADF4135A3BE48.quest_subtitle: "An &8Tilt Adapter&r tilts rotational output based on an analog &credstone&r signal"
	quest.3D988137341AE75D.quest_desc: [
		"Blocks beams the same way it blocks light. Also the ingredient for Polarizing Filters."
		""
		"You need &6Tinted Glass&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.3D988137341AE75D.quest_subtitle: "Let's you block incoming beams"
	quest.3D988137341AE75D.title: "&3Tinted Glass"
	quest.3DADAD947C982C71.quest_desc: [
		"The shaft is the track, the carriage assembles a payload and rides it, and the belt wheel passes rotation onto moving physics assemblies."
		"A &ePowered Zipline&r rides ropes; a &eClaw&r hangs from rope and grabs connectors, with redstone setting how hard it holds. Hold &eW&r over them in EMI to see their Ponder."
	]
	quest.3DADAD947C982C71.quest_subtitle: "The shaft is the track, the carriage assembles a payload and rides it, and the belt wheel passes rotation onto moving physics assemblies."
	quest.3DADAD947C982C71.title: "Craft Gantery Equipments"
	quest.3DD50CF838BAAE78.quest_desc: [
		"The Infernal Forge is a heavy hammer; the Monstrous Horn upgrades a netherite helmet into the Monstrous Helm. Keep the Forge for the Fusion Anvil later."
	]
	quest.3DD50CF838BAAE78.quest_subtitle: "The Infernal Forge hammer, or a Monstrous Horn for the Monstrous Helm."
	quest.3DD50CF838BAAE78.title: "&dSpoils of the Monstrosity"
	quest.3E16F51340365B66.quest_desc: [
		"Craft from copper ingots, a hopper and planks. Place a Backpack into the Dock first; the GUI will tell you if it is empty."
		"Use it as a station for a pack you are not wearing, then pick the pack back up when you head out with a plane or a bee delivery."
	]
	quest.3E16F51340365B66.quest_subtitle: "Park the pack on a hopper frame"
	quest.3E16F51340365B66.title: "&eBackpack Dock"
	quest.3E190A6DA59EB1E9.quest_desc: [
		"Aeronautics' own jukebox track, Cloud Skipper. It has no crafting recipe, so keep an ear out for one."
		"A trophy for the hangar more than a flight part."
	]
	quest.3E190A6DA59EB1E9.title: "Music Disc Cloud Skipper"
	quest.3E190A6DA59EB1E9.quest_subtitle: "Aeronautics' own jukebox track, Cloud Skipper. It has no crafting recipe, so keep an ear out for one."
	quest.3E388A13C2BD5A0B.quest_desc: [
		"A heated mixer turns sugar and slime into marshmallows — check EMI for the exact recipe."
		"Eat them, stick them, glaze them, or stir one into hot chocolate."
	]
	quest.3E388A13C2BD5A0B.title: "Marshmallow"
	quest.3E388A13C2BD5A0B.quest_subtitle: "A heated mixer turns sugar and slime into marshmallows — check EMI for the exact recipe."
	quest.3E64F7D567A992A9.quest_desc: [
		"Crafted around an Eye of Ender with lava buckets, netherite scrap and blackstone. Throw it like an Eye of Ender; it flies toward a Soul Black Smith."
	]
	quest.3E64F7D567A992A9.quest_subtitle: "Crafted at a crafting table around an Eye of Ender. Throw it and it flies toward the nearest Soul Black Smith."
	quest.3E64F7D567A992A9.title: "&eMonstrous Eye"
	quest.3E68562B397B60E0.quest_desc: [
		"A &eDeployer&r mimics a player hand: give it a tool or ingredient and it right-clicks or left-clicks whatever is in front."
		"You will use it constantly for sequenced assembly, including Precision Mechanisms. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.3E68562B397B60E0.title: "Deployer"
	quest.3E68562B397B60E0.quest_subtitle: "A &6Deployer&r is a simple machine with massive potential. Acts as a psuedo-player, allowing you to right click with items you insert to use them, or left click to attack and mine with them"
	quest.3EB60E27A12D04B9.quest_desc: [
		"&eMore Create Machines&r. Complete it by obtaining &6Andesite Alloy&r."
		""
		"Opens after Andesite, the Foundation (Andesite Age)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.3EB60E27A12D04B9.quest_subtitle: "The add-ons in this chapter give Create new gears, fans, presses and springs."
	quest.3EB60E27A12D04B9.title: "&eMore Create Machines"
	quest.3ED0226315017D8D.quest_desc: [
		"Power a &eSticker&r and its face becomes sticky, latching onto the world or another contraption. Airships use them as retractable landing gear."
	]
	quest.3ED0226315017D8D.title: "Sticker"
	quest.3ED0226315017D8D.quest_subtitle: "A &aSticker&r sticks to blocks when powered by &credstone&r. Great for mobile anchors on airships"
	quest.3EDE4A64705009C1.quest_desc: [
		"Mount a Create Big Cannon on a Simulated or Aeronautics airframe. Propeller up front, breech in the belly."
		""
		"Tick this when a flying ship has fired a round that was not from the ground."
	]
	quest.3EDE4A64705009C1.quest_subtitle: "A cannon on a flying ship"
	quest.3EDE4A64705009C1.title: "&cGunboat Diplomacy"
	quest.3F2F0D5736916576.quest_desc: [
		"Feed it water for hydrogen and oxygen, or brine for chlorine and sodium. Crafted with Martian Steel. Hydrogen is the next step toward the best rocket fuel."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.3F2F0D5736916576.quest_subtitle: "Splits brine into chlorine and sodium, and water into hydrogen and oxygen."
	quest.3F2F0D5736916576.title: "&eElectrolysis Machine"
	quest.3F5C0F8E1B705059.quest_desc: [
		"Three candy canes in a column. A novelty sword — fine for showing off, not for the Nether."
	]
	quest.3F5C0F8E1B705059.quest_subtitle: "Three candy canes in a column. A novelty sword — fine for showing off, not for the Nether."
	quest.3F5C0F8E1B705059.title: "&eCandy Cane Sword"
	quest.3F891FB92BDD9743.quest_desc: [
		"Wear &eAviator's Goggles&r and the HUD annotates placed Aeronautics parts: burners, envelopes, bearings, pressure."
		"Put them on before you start trimming lift. Almost every flight block in this chapter hangs off this quest."
	]
	quest.3F891FB92BDD9743.title: "Aviators Goggles"
	quest.3F891FB92BDD9743.quest_subtitle: "Wear &eAviator's Goggles&r and the HUD annotates placed Aeronautics parts: burners, envelopes, bearings, pressure."
	quest.3FA149E684F79311.quest_desc: [
		"Own four guns. Mix a shotgun, rifle, SMG or sniper as you like, and keep the ammo line stocked."
	]
	quest.3FA149E684F79311.quest_subtitle: "Own four guns. Shotgun, rifle, SMG, sniper: it's up to you."
	quest.3FA149E684F79311.title: "&c&lArmory"
	quest.3FA5666AC0C462E8.quest_desc: [
		"It spends on-board FE and spins a shaft. Scroll the speed value; it does not care how loaded the network is."
		"Point that shaft at a propeller bearing and the plane no longer needs a burner. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.3FA5666AC0C462E8.quest_subtitle: "On board, a motor turns stored FE into rotation. Set its speed with the scroll value."
	quest.3FA5666AC0C462E8.title: "&eElectric Motor"
	quest.4036519259DC46D1.quest_desc: [
		"Rechiseled: Create adds chiseled Create stones and windows, plus a Mechanical Chisel. Craft it from an Andesite Casing and a Chisel."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4036519259DC46D1.quest_subtitle: "A chisel on Andesite Casing"
	quest.4036519259DC46D1.title: "&eRechiseled: Create"
	quest.40C70D05C46DCF4E.quest_desc: [
		"Outputs redstone while a minecart is on it. Same idea as a pressure plate, but for carts."
		"Use it to open doors, start a furnace cart, or time an activator rail."
	]
	quest.40C70D05C46DCF4E.quest_subtitle: "Outputs redstone while a minecart is on it. Same idea as a pressure plate, but for carts."
	quest.40C70D05C46DCF4E.title: "&2Detector Rail"
	quest.40EE8FC6E1A4E681.quest_desc: [
		"Point a &eDisplay Link&r at a machine, then at a board or nixie tube. It copies live data — speed, counts, train ETAs — onto the display."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.40EE8FC6E1A4E681.title: "Display Link"
	quest.40EE8FC6E1A4E681.quest_subtitle: "A &6Display Link&r lets you display real-time information on a connected &6Display Board&r or &6Nixie Tube&r"
	quest.4106CAF7FC1EF1ED.quest_desc: [
		"Pipe water into the &eSprinkler&r. Crops and farmland below stay hydrated as if it were raining."
		"That's the simple automatic farm: sprinkler over tilled soil."
	]
	quest.4106CAF7FC1EF1ED.quest_subtitle: "Water makes the area below wet, making the world think it's raining there"
	quest.4106CAF7FC1EF1ED.title: "&bWater Bucket"
	quest.410C2567BCB30109.quest_desc: [
		"Craft a cogwheel, &eAndesite Casing&r and &eTurntable&r. Power the &eSlicer&r, then insert a knife or an axe on the next quest."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.410C2567BCB30109.quest_subtitle: "The Slicer is used for automatic cutting and stripping when used with a Farmer's Delight Knife or any Axe, respectively."
	quest.410C2567BCB30109.title: "&eCraft a &6Slicer"
	quest.41374A60BC001BEE.quest_desc: [
		"Mud, moss, and a water bucket. Compact or craft them into &ePeat&r, then smoke that into briquettes."
	]
	quest.41374A60BC001BEE.quest_subtitle: "To make some peats"
	quest.41374A60BC001BEE.title: "&eObtain Materials"
	quest.41423783869CBE12.quest_desc: [
		"Point a &eDisplay Link&r from a &eTrain Station&r at a &eDisplay Board&r."
		"Arrivals and departures show up once trains are actually running on a schedule."
	]
	quest.41423783869CBE12.quest_subtitle: "Forecast a train's arrival on your &6Display Board&r with the help of your &6Display Links&r"
	quest.41423783869CBE12.title: "&dForecasting a Train's Arrival"
	quest.4187C52EA677B491.quest_desc: [
		"Buried in desert. The Ancient Remnant is the boss; fight it in melee range."
		""
		"You need &6Cursed Pyramid&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.4187C52EA677B491.quest_subtitle: "A buried pyramid in the desert."
	quest.4187C52EA677B491.title: "&6Cursed Pyramid"
	quest.41A0B52DD33255A3.quest_desc: [
		"Right-click a &eRope Connector&r and a &eRope Winch&r with a &eRope Coupling&r to tie two Simulated assemblies together."
		"Two connectors can share a rope; two winches cannot. Shears cut the line."
	]
	quest.41A0B52DD33255A3.title: "Rope Coupling"
	quest.41A0B52DD33255A3.quest_subtitle: "Right-click a &eRope Connector&r and a &eRope Winch&r with a &eRope Coupling&r to tie two Simulated assemblies together."
	quest.41DBE34083E1C3FD.quest_desc: [
		"Park a &eTrain Buffer&r at the end of a siding so a runaway train hits a bumper instead of the station wall. Craft them from sturdy sheet blocks."
	]
	quest.41DBE34083E1C3FD.title: "Train Buffer"
	quest.41DBE34083E1C3FD.quest_subtitle: "Park a &eTrain Buffer&r at the end of a siding so a runaway train hits a bumper instead of the station wall. Craft them from sturdy sheet..."
	quest.426E071ABE9D9CE2.quest_desc: [
		"A train needs at least:"
		""
		"- 1 &6Train Casing&r"
		"- 1 &6Train Station&r"
		"- Enough &6Train Tracks&r for the line"
		""
		"Ponder the &6Train Station&r to see assembly. Nothing here forces a schedule — build a loop for fun or a line to a depot when logistics start to matter."
	]
	quest.426E071ABE9D9CE2.quest_subtitle: "Lay track when your factory wants a horizon."
	quest.426E071ABE9D9CE2.title: "&8Rails Outward"
	quest.42A614D1E294D180.quest_desc: [
		"Pump hydrocarbon, biofuel or liquid hydrogen into the rocket's fluid tanks. Biofuel is the easy start: compact three dried kelp and bone meal in a heated basin."
		"Hydrocarbon needs sodium catalyst; liquid hydrogen waits until you can electrolyse water on Mars."
	]
	quest.42A614D1E294D180.quest_subtitle: "Fill the rocket's fluid tanks with hydrocarbon, biofuel or liquid hydrogen. Biofuel is compacted from dried kelp and bone meal, the easiest to start with."
	quest.42A614D1E294D180.title: "&9Rocket Fuel"
	quest.43122959460C68EA.quest_desc: [
		"A &ePowered Latch&r remembers: pulse the set side to turn it on, pulse the reset side to turn it off. Good for start/stop buttons on a factory line."
	]
	quest.43122959460C68EA.title: "Powered Latch"
	quest.43122959460C68EA.quest_subtitle: "A &cPowered Latch&r that toggles on when receiving a redstone signal on one side and off when receiving a signal on another side"
	quest.436319DB8AD746DA.quest_desc: [
		"A powered &eLaser Pointer&r draws a beam the &eLaser Sensor&r can see. Signal strength follows beam power; a filter matches colour."
		"Wrench the faces to invert, and set max distance on the back. Useful for dock alignment that optical sensors cannot cover. Hold &eW&r over them in EMI to see their Ponder."
	]
	quest.436319DB8AD746DA.quest_subtitle: "A powered &eLaser Pointer&r draws a beam the &eLaser Sensor&r can see. Signal strength follows beam power; a filter matches colour."
	quest.436319DB8AD746DA.title: "Laser Blocks"
	quest.43D0152B9C0F0E1B.quest_desc: [
		"Park either burner under a &eStirling Engine&r. Solid takes furnace fuels; liquid burns valid fuel fluids and can pass fluid through like a pipe."
		"Both support a redstone thermostat. Hold &eW&r over them in EMI to see their Ponder."
	]
	quest.43D0152B9C0F0E1B.quest_subtitle: "Park either burner under a &eStirling Engine&r. Solid takes furnace fuels; liquid burns valid fuel fluids and can pass fluid through like..."
	quest.43D0152B9C0F0E1B.title: "Solid and Liquid Burners"
	quest.43D9ABDFFFB703FE.quest_desc: [
		"Hard-light constructs, every Lantern world, oil into rocket fuel, a gunboat, a spellforged factory, a scheduled rail net, an industrial kitchen, an armory, the deep, and a shop that looks built."
		""
		"That is The Illustrious MFPack. Wear the goggles. Tick the book. The rest is play."
	]
	quest.43D9ABDFFFB703FE.quest_subtitle: "Every synergy, one title"
	quest.43D9ABDFFFB703FE.title: "&6The Illustrious"
	quest.44160C55DF0D7632.quest_desc: [
		"Andesite casing, cogs, sheets, shafts, alloy, and an electron tube. This pile covers the clutches, gearboxes, and brakes down this branch."
	]
	quest.44160C55DF0D7632.quest_subtitle: "For Clutches and Brakes and more!"
	quest.44160C55DF0D7632.title: "&l&cAll the things you'll need"
	quest.445212E6651B7746.quest_desc: [
		"Four candy canes in a square. From here you can make the candy cane tool set, or The Bright Side disc."
	]
	quest.445212E6651B7746.title: "Candy Cane Block"
	quest.445212E6651B7746.quest_subtitle: "Four candy canes in a square. From here you can make the candy cane tool set, or The Bright Side disc."
	quest.448189D652A46D20.quest_desc: [
		"&eCreate Big Cannons&r. Complete it by obtaining &6Casting Sand&r."
		""
		"Opens after Blaze Burner (Brass Age) Cannon parts are cast from molten metal in moulds of casting sand, then bored out with a Cannon Drill. Bigger cannons are assembled from layers by a Cannon Builder. Every machine here has a Ponder scene.."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.448189D652A46D20.quest_subtitle: "Cast, bore and build your own artillery. It starts with casting sand."
	quest.448189D652A46D20.title: "&cCreate Big Cannons"
	quest.44AAFF977264A23B.quest_desc: [
		"Drill, saw, launcher, and catapult that run off stored spring charge instead of a shaft. Wind them, then take them into the field."
	]
	quest.44AAFF977264A23B.quest_subtitle: "Drills, saws, launchers and catapults that run on stored spring energy."
	quest.44AAFF977264A23B.title: "&bSpring Machines"
	quest.44B2BD4CD968C0F1.quest_desc: [
		"This pack has Create: Framed instead of Framed Blocks. It dyes Create's framed glass, windows, seats and cardboard."
		"A stained framed glass pane is the usual start."
	]
	quest.44B2BD4CD968C0F1.quest_subtitle: "Coloured framed glass"
	quest.44B2BD4CD968C0F1.title: "&eCreate: Framed"
	quest.4518E6ABC94B732C.quest_desc: [
		"Right-click the empty catalyst with a &eBlaze Cake&r. Compatible add-ons treat the airstream as superheated."
	]
	quest.4518E6ABC94B732C.quest_subtitle: "Right-click the empty catalyst with a &eBlaze Cake&r. Compatible add-ons treat the airstream as superheated."
	quest.4518E6ABC94B732C.title: "&4Fan Seething Catalyst"
	quest.45240C873BEAD3EF.quest_desc: [
		"With these awesome armor pieces you can &bBounce from place to place&r using your &aSlime Boots&r or &eCling to the ceiling&r with your &aSlime Helmet&r the helmet also allows you to &dBounce off walls&r if you are using an Elytra alongside it"
	]
	quest.45240C873BEAD3EF.quest_subtitle: "Boing! Boing! Boing!"
	quest.45240C873BEAD3EF.title: "&aSlime Armor"
	quest.452AB65797BA37C2.quest_desc: [
		"Craft a &eRoost&r from canvas, bamboo and wheat, then capture a chicken on the next quest."
		"Occupied roosts lay on a timer. Feeding is optional and only speeds the next output."
	]
	quest.452AB65797BA37C2.quest_subtitle: "Fast-track poultry product output from chickens, various chicken types, and ducks."
	quest.452AB65797BA37C2.title: "&eCraft a &bRoost"
	quest.4537302671AE839F.quest_desc: [
		"Create Armorer scopes, grips and muzzles are Mechanical Crafting recipes, same as the guns. Fit them after you have something to shoot."
	]
	quest.4537302671AE839F.quest_subtitle: "Create Armorer's scopes, grips and muzzles are mechanical-crafted too."
	quest.4537302671AE839F.title: "&eAttachments"
	quest.4566D7BB620B517A.quest_desc: [
		"An experience block, copper casing, and a sponge. It soaks up orbs — even while the contraption is moving — so farms don't leave XP on the floor."
	]
	quest.4566D7BB620B517A.quest_subtitle: "Absorbs experience, and also works on moving contraptions."
	quest.4566D7BB620B517A.title: "&2Craft Experience Lantern"
	quest.45972D76A609E9A6.quest_desc: [
		"Accumulators and a motor or ion thrusters on the ship, an alternator and energy interface on the pad."
		"Fly a lap that leaves and returns on stored FE with no burner and no liquid fuel, then tick this off."
	]
	quest.45972D76A609E9A6.quest_subtitle: "Build a ship that flies on stored FE alone and recharges at its dock through a Portable Energy Interface. Tick this off when it makes a round trip."
	quest.45972D76A609E9A6.title: "&6All-Electric Aircraft"
	quest.45E7B061B7E02E68.quest_desc: [
		"Four mechanical belts around a shaft. Bigger radius, more ground clearance."
		"Still just a right-click onto a Wheel Mount. Go monstrous if even this looks small on the chassis."
	]
	quest.45E7B061B7E02E68.title: "Large Tire"
	quest.45E7B061B7E02E68.quest_subtitle: "Four mechanical belts around a shaft. Bigger radius, more ground clearance."
	quest.45EF2EA3837EF0A6.quest_desc: [
		"Carry a &ePortable Whistle&r on the platform and blow it while you work. Smith it into a netherite one later if you want the upgrade."
	]
	quest.45EF2EA3837EF0A6.title: "Portable Whistle"
	quest.45EF2EA3837EF0A6.quest_subtitle: "Carry a &ePortable Whistle&r on the platform and blow it while you work. Smith it into a netherite one later if you want the upgrade."
	quest.4601FF19A911B628.quest_desc: [
		"A &eSmart Chute&r accepts a filter and moves full stacks vertically. It is the brass upgrade when a normal chute jams on mixed items."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4601FF19A911B628.title: "Smart Chute"
	quest.4601FF19A911B628.quest_subtitle: "A &6Smart Chute&r is a more configurable chute that also allows full item stacks to be moved"
	quest.46085B16F9FA9ADC.quest_desc: [
		"Feed it rotation and it fires a beam whose type depends on that speed. Point it at a Receptor to send kinetics as light."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.46085B16F9FA9ADC.quest_subtitle: "Emits different types of beams based on the &6rotational force&r applied"
	quest.46085B16F9FA9ADC.title: "&5Optical Source"
	quest.46118D84C56B11A7.quest_desc: [
		"Right-click a copper ingot onto any stripped log to make a &eCopper Casing&r, the same trick as andesite casings."
		"Fluid machines, tanks, and the steam engine all start here."
	]
	quest.46118D84C56B11A7.title: "Copper Casing"
	quest.46118D84C56B11A7.quest_subtitle: "The basis of most fluid-related things in &6&lCreate&r"
	quest.4611A7BFBDA641A8.quest_desc: [
		"Upgrade diamond with netherite, two more ion thrusters, and two Northstar rocket thrusters. Not a smithing recipe — that would copy the wrong tier."
		"Biggest battery, hover for building in mid-air. Charge it fully; an empty netherite pack still drops like a brick."
	]
	quest.4611A7BFBDA641A8.quest_subtitle: "Upgrade the diamond jetpack with netherite ingots, two Ion Thrusters and two Northstar Rocket Thrusters. The top tier: fastest, with the biggest battery. Hover mode makes building in mid-air easy."
	quest.4611A7BFBDA641A8.title: "&8Netherite Jetpack"
	quest.4643735856150DA8.quest_desc: [
		"&7Andesite Alloy&r feeds &7Andesite Casings&r and the simple kinetic blocks that open Create."
		""
		"&7Andesite&r is abundant underground in pale pockets that blend with stone — keep your eyes open."
		""
		"Right-click any stripped log or wood with the alloy to make a casing. From here the book fans out; take any branch."
	]
	quest.4643735856150DA8.quest_subtitle: "Strip a log, press alloy to wood — the age begins."
	quest.4643735856150DA8.title: "&7Andesite, the Foundation"
	quest.466BBE083256E5E0.quest_desc: [
		"Purpur, shulker shells and end stone bricks around an Eye of Ender. It points to a Ruined Citadel on the outer End islands."
	]
	quest.466BBE083256E5E0.quest_subtitle: "Crafted at a crafting table around an Eye of Ender. Throw it and it flies toward the nearest Ruined Citadel."
	quest.466BBE083256E5E0.title: "&eVoid Eye"
	quest.4675C883C776220E.quest_desc: [
		"Pull enemies in, then punch. Later the Mechanical Fusion Anvil can fuse it with other boss weapons."
	]
	quest.4675C883C776220E.quest_subtitle: "The Ender Guardian's gauntlet: pull enemies in and punch."
	quest.4675C883C776220E.title: "&dGauntlet of Guard"
	quest.467CAD9681A88593.quest_desc: [
		"Place Steam 'n' Rails' &eTrack Buffer&r on the last piece of track so a runaway train has a proper bumper."
		"Different model from the buffers in the Trains chapter, same job."
	]
	quest.467CAD9681A88593.quest_subtitle: "A Track Buffer stops trains at the end of a line, and it looks the part."
	quest.467CAD9681A88593.title: "&6End of the Line"
	quest.46C12E2C8E1C71B8.quest_desc: [
		"Redstone blocks and iron around an Eye of Ender. It leads to the Ancient Factory, underground in cave biomes."
	]
	quest.46C12E2C8E1C71B8.quest_subtitle: "Crafted at a crafting table around an Eye of Ender. Throw it and it flies toward the nearest Ancient Factory."
	quest.46C12E2C8E1C71B8.title: "&eMech Eye"
	quest.471E56B0F10A8EBD.quest_desc: [
		"A lesser focus plus a Mark of Mastery at the apparatus. The matching school gets even cheaper and stronger."
	]
	quest.471E56B0F10A8EBD.quest_subtitle: "A lesser focus and a Mark of Mastery."
	quest.471E56B0F10A8EBD.title: "&dGreater Focus"
	quest.474340122C1CC765.quest_desc: [
		"Bind Redstone Link frequencies to keys, then sit at the typewriter to drive many channels without a handful of linked controllers."
		"Right-click a linked controller onto it to copy frequencies. Bindings survive breaking the block."
	]
	quest.474340122C1CC765.title: "Linked Typewriter"
	quest.474340122C1CC765.quest_subtitle: "Bind Redstone Link frequencies to keys, then sit at the typewriter to drive many channels without a handful of linked controllers."
	quest.477E6B9A9E264637.quest_desc: [
		"A handheld drill that drinks fuel. Brass, cogs, a Steam Engine, and a Brass Drill Head. Mine on the move without planting a mechanical drill."
	]
	quest.477E6B9A9E264637.title: "Portable Drill"
	quest.477E6B9A9E264637.quest_subtitle: "A handheld drill that drinks fuel. Brass, cogs, a Steam Engine, and a Brass Drill Head. Mine on the move without planting a mechanical dr..."
	quest.47B63CD140F2910E.quest_desc: [
		"&eWelcome to Aquatic Ambitions&r. Complete it by obtaining &6Welcome to Aquatic Ambitions&r."
		""
		"Opens after create:copper_casing (Copper Age)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.47B63CD140F2910E.quest_subtitle: "Create Aquatic Ambitions is a Create add-on that introduces new machines, processes, and production lines inspired by the ocean. Harness the power of the conduit to transform byproducts into valuable resources and building blocks — and make more materials renewable in the process!"
	quest.47B63CD140F2910E.title: "&bWelcome to Aquatic Ambitions"
	quest.482CF324FCEDF863.quest_desc: [
		"Lava in the fan's airflow blasts items in bulk, like a furnace on a belt. Keep the fan itself out of the lava or you will be rebuilding it."
	]
	quest.482CF324FCEDF863.title: "Lava Bucket"
	quest.482CF324FCEDF863.quest_subtitle: "When placed in front of the &6Encased Fan&r, &6lava&r allows it to blast items"
	quest.482D15841484DCA7.quest_desc: [
		"Stock a &eRobo Bee Port&r with &eRobo Bees&r and they fly packages to other ports on the same network. Holding a package in your off-hand lets you send it with a bee yourself."
		"Set return mode and filters on the port so bees come home."
	]
	quest.482D15841484DCA7.title: "Robo Bee"
	quest.482D15841484DCA7.quest_subtitle: "Stock a &eRobo Bee Port&r with &eRobo Bees&r and they fly packages to other ports on the same network. Holding a package in your off-hand..."
	quest.4865C6C955CF8233.quest_desc: [
		"Reads the beam hitting it and outputs redstone from those properties. Detect whether a link is live without a comparator on a receptor."
	]
	quest.4865C6C955CF8233.quest_subtitle: "Emits &credstone&r signal based on the incident beam properties"
	quest.4865C6C955CF8233.title: "&6Optical Sensor"
	quest.48673623C1866594.quest_desc: [
		"&eCart Assembler&r. Complete it by obtaining &6Cart Assembler&r."
		""
		"Opens after Andesite Age. Place a Cart Assembler over a rail, park a minecart on it, glue blocks to the cart, then pulse redstone. The whole glued structure becomes a moving contraption. Hold W over it in EMI to see its Ponder.."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.48673623C1866594.title: "Cart Assembler"
	quest.48673623C1866594.quest_subtitle: "&7Opens after &eAndesite, the Foundation&7 (Andesite Age)"
	quest.486CA59AED48B71A.quest_desc: [
		"Stock TACZ attachments craft here. Create Armorer scopes, grips and muzzles use the Mechanical Crafter, which you already have."
	]
	quest.486CA59AED48B71A.quest_subtitle: "Optional. Stock TACZ attachments craft here (Create Armorer attachments use the Mechanical Crafter)."
	quest.486CA59AED48B71A.title: "&7Attachment Workbench"
	quest.48963B9985715141.quest_desc: [
		"A &eSequenced Gearshift&r plays a list of steps: spin this way for N turns, wait, reverse. Use it for piston drills and anything that has to repeat a motion."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.48963B9985715141.title: "Sequenced Gearshift"
	quest.48963B9985715141.quest_subtitle: "A &eSequenced Gearshift&r plays a list of steps: spin this way for N turns, wait, reverse. Use it for piston drills and anything that has..."
	quest.48989B23AE749B26.quest_desc: [
		"An Encased Chain Drive that also has a cog sticking out, so you can tap rotation off the chain without a second shaft."
	]
	quest.48989B23AE749B26.quest_subtitle: "An encased chain drive with an additional cogwheel for connectivity."
	quest.48989B23AE749B26.title: "&6Encased Chain Cogwheel"
	quest.48FF65D5CA0A9DB0.quest_desc: [
		"The &eCopper Backtank&r fills with air while you walk, and faster when you feed rotation into the valve on its face."
		"Equip it on your chest or in a Curios slot under the diving helmet."
	]
	quest.48FF65D5CA0A9DB0.title: "Copper Backtank"
	quest.48FF65D5CA0A9DB0.quest_subtitle: "A &6Copper Backtank&r stores pressurized air for use with a diving helmet, effectively granting Water Breathing for as long as your air supply lasts"
	quest.493E39580C7CE70A.quest_desc: [
		"They store Source so machines can draw it. Put them next to the Imbuement Chamber and every sourcelink you build."
	]
	quest.493E39580C7CE70A.quest_subtitle: "Stores Source, the magical fuel that machines draw from."
	quest.493E39580C7CE70A.title: "&5Source Jars"
	quest.4958D7FCD507F6F7.quest_desc: [
		"Power a &eGearshift&r with redstone and rotation through it reverses. Use it to send a drill back out of a hole without rebuilding the gearbox."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4958D7FCD507F6F7.title: "Gearshift"
	quest.4958D7FCD507F6F7.quest_subtitle: "A &6Gearshift&r lets you reverse the direction of rotation by applying &credstone&r"
	quest.496201ECB22CF469.quest_desc: [
		"Keeps a sealed room from freezing or cooking. Mechanical-crafted with blaze rods, blue ice, advanced circuits and titanium; right-click to set the temperature."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.496201ECB22CF469.quest_subtitle: "Keeps a sealed base from freezing or cooking."
	quest.496201ECB22CF469.title: "&bTemperature Regulator"
	quest.496C2FD7E9BB6971.quest_desc: [
		"Andesite and brass casings, alloy, cogs, sheets, industrial iron, ingots, and a &ePrecision Mechanism&r."
		"That pile covers thrusters, the industrial motor pair, gantries, gearboxes, and the cockpit blocks."
	]
	quest.496C2FD7E9BB6971.quest_subtitle: "Andesite and brass casings, alloy, cogs, sheets, industrial iron, ingots, and a &ePrecision Mechanism&r."
	quest.496C2FD7E9BB6971.title: "Gather Materials"
	quest.496D0D622B44511D.quest_desc: [
		"Configure the &eWand of Symmetry&r to mirror across a plane or a four-fold cross. Every block you place or break is copied, which makes halls and factories much faster."
	]
	quest.496D0D622B44511D.title: "Wand of Symmetry"
	quest.496D0D622B44511D.quest_subtitle: "A &6Wand of Symmetry&r is an exceptional building tool that will mirror your actions in one, two, or four places depending on how it is configured, for both breaking and building blocks"
	quest.496FC8106904193E.quest_desc: [
		"A compact engine: pistons, flint and steel, a brass block, blackstone slabs, and a fluid tank. Pipe in diesel (or another fuel) and it spins a shaft."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.496FC8106904193E.title: "Diesel Engine"
	quest.496FC8106904193E.quest_subtitle: "&6Diesel Engines&r are a compact way of generating kinetic energy"
	quest.49BBDD0D2E688FBA.quest_desc: [
		"The Salamander 40mm field gun and the Devastator grenade launcher. Their rounds want nitropowder, which is why this sits after the Armory."
	]
	quest.49BBDD0D2E688FBA.quest_subtitle: "The Salamander 40mm field gun and the Devastator grenade launcher."
	quest.49BBDD0D2E688FBA.title: "&4Heavy Weapons"
	quest.49BD960380D0E983.quest_desc: [
		"Feed locometal through a &eMechanical Crafter&r array to get the boiler nose."
		"Glue it on the front of the locomotive; smokestacks go on top."
	]
	quest.49BD960380D0E983.quest_subtitle: "The rounded front of a steam engine, made in a mechanical crafter."
	quest.49BD960380D0E983.title: "&7Locometal Boiler"
	quest.49D48F359FEDCE62.quest_desc: [
		"Craft it from brass casing, a wooden slab, and a &eGyroscopic Mechanism&r. It tries to keep the propeller upright, which is what helicopters need."
		"Redstone zeros the tilt if that auto-level gets in the way. Thrust also fades with altitude. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.49D48F359FEDCE62.title: "Gyroscopic Propeller Bearing"
	quest.49D48F359FEDCE62.quest_subtitle: "Craft it from brass casing, a wooden slab, and a &eGyroscopic Mechanism&r. It tries to keep the propeller upright, which is what helicopt..."
	quest.49E7C672E2F02981.quest_desc: [
		"The loose mirror is a crafting part. Encased Mirrors and the Beam Splitter both start here."
	]
	quest.49E7C672E2F02981.quest_subtitle: "Reflects the beam perpendicularly"
	quest.49E7C672E2F02981.title: "Obtain Mirrors"
	quest.49FE019F2EA64ED1.quest_desc: [
		"A Potato Cannon you bolt to the airframe, mechanical-crafted from kelp, pipes, copper sheets, and redstone."
		"Load potatoes and you can shoot from the ship without leaving the seat."
	]
	quest.49FE019F2EA64ED1.title: "Mounted Potato Cannon"
	quest.49FE019F2EA64ED1.quest_subtitle: "A Potato Cannon you bolt to the airframe, mechanical-crafted from kelp, pipes, copper sheets, and redstone."
	quest.4A0272A87677AD1B.quest_desc: [
		"Pipe oxygen in, put the chestpiece in, and it refills the backtank. Crafted with a separator, a circuit and titanium sheets."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4A0272A87677AD1B.quest_subtitle: "Refills your space suit's air."
	quest.4A0272A87677AD1B.title: "&bOxygen Filler"
	quest.4A279425DB98EA88.quest_desc: [
		"32 armour and 16 toughness for the full set. Smith each netherite piece with Ignitium and the upgrade template."
	]
	quest.4A279425DB98EA88.quest_subtitle: "The toughest armour in the pack: 32 armour and 16 toughness for the full set."
	quest.4A279425DB98EA88.title: "&6&lIgnitium Armour"
	quest.4A4F682FF5FC3617.quest_desc: [
		"Right-click a &eList Filter&r and tick the items you want. Slot it into funnels and tunnels so the wrong stack never enters a machine."
	]
	quest.4A4F682FF5FC3617.title: "Filter"
	quest.4A4F682FF5FC3617.quest_subtitle: "A basic filter"
	quest.4A81AA1D0A14D552.quest_desc: [
		"A three-phase fire knight. Stay close, watch the damage caps, and pick up Ignitium when it falls."
	]
	quest.4A81AA1D0A14D552.quest_subtitle: "A three-phase fire knight. Stay close, watch the damage caps, and pick up Ignitium when it falls."
	quest.4A81AA1D0A14D552.title: "&c&lIgnis"
	quest.4A8A87957B64AFB0.quest_desc: [
		"Mechanical-crafted from the crystal, titanium sheets and a Precision Mechanism. Drop it into a sequenced assembly line to engrave circuits."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4A8A87957B64AFB0.quest_subtitle: "A mechanical-crafted machine that engraves circuits during sequenced assembly."
	quest.4A8A87957B64AFB0.title: "&dCircuit Engraver"
	quest.4AC668EE1AE5D96F.quest_desc: [
		"Imbue a Wilden Tribute with all eight essences. You get five marks. Greater foci and Heavy Elemental Armour both spend them."
	]
	quest.4AC668EE1AE5D96F.quest_subtitle: "Imbue a Wilden Tribute (from the Wilden Chimera) with all eight essences: five marks."
	quest.4AC668EE1AE5D96F.title: "&5Mark of Mastery"
	quest.4B24E4B0330823E0.quest_desc: [
		"Place &eTrack Signals&r to split the railway into blocks. A train waits on red if the next block is occupied, which keeps two trains off the same junction."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4B24E4B0330823E0.title: "Track Signal"
	quest.4B24E4B0330823E0.quest_subtitle: "A &6Track Signal&r is used to control the flow of trains across tracks and track intersections"
	quest.4B25075C31109A90.quest_desc: [
		"Pipe in &eTurpentine&r, then give it redstone. No valid fuel, no push. You can cluster them into bigger rear-fed multiblocks later."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4B25075C31109A90.title: "Thruster"
	quest.4B25075C31109A90.quest_subtitle: "A &6Thruster&r provides directional &6Propulsion&r when powered by &credstone&r and fueled with &eTurpentine&r"
	quest.4B3DE2788D5D543C.quest_desc: [
		"&eConnected&r. Complete it by obtaining &6Connected&r."
		""
		"Opens after Blaze Burner (Brass Age)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.4B3DE2788D5D543C.quest_subtitle: "A collection of quality of life blocks to enchance your contraptions"
	quest.4B3DE2788D5D543C.title: "&l&dConnected"
	quest.4B5020F5AA388FAA.quest_desc: [
		"Arrange &eMechanical Crafters&r in the shape of the recipe, including patterns bigger than 3x3. That is how you stamp &eCrushing Wheels&r, the Extendo Grip, and most brass gadgets."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4B5020F5AA388FAA.title: "Mechanical Crafter"
	quest.4B5020F5AA388FAA.quest_subtitle: "&6Mechanical Crafters&r allow for both automatic crafting of normal recipes and the crafting of recipes that are larger than a normal crafting table would allow"
	quest.4B68D3819B6C8246.quest_desc: [
		"The &eNetherite Backtank&r holds more air than copper and does not burn. Smith it from the copper tank when you are ready for lava lakes."
	]
	quest.4B68D3819B6C8246.title: "Netherite Backtank"
	quest.4B68D3819B6C8246.quest_subtitle: "An upgraded version of the &6Copper Backtank&r"
	quest.4BCFB8B54450D011.quest_desc: [
		"Obtained by Blasting or Bulk-Blasting a piece of Coal"
		""
		"You need &6Coal Coke&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.4BCFB8B54450D011.quest_subtitle: "Decent upgrade to the boring coal"
	quest.4BCFB8B54450D011.title: "&eCoal Coke"
	quest.4BD18F584B3344B7.quest_desc: [
		"On Northstar worlds a lit ring covers the air: no oxygen, frost below -32, fire above 300. It spends a little charge while that is true."
		""
		"Lava, fire blocks, falls and combat still hurt. Wear it on Ryut and Mercury; take it off when you want the ground to matter."
	]
	quest.4BD18F584B3344B7.quest_subtitle: "Atmosphere only"
	quest.4BD18F584B3344B7.title: "&bA Ring Knows"
	quest.4BDB8583AD55CD4B.quest_desc: [
		"Craft a Shuffle Filter from an iron nugget, wool and a brass nugget."
		"Right-click to configure up to 18 blocks. Equal mode gives every match the same chance; Weighted mode prefers stacks with more items. Stonecut it into a Weighted Shuffle Filter if you want the other item."
	]
	quest.4BDB8583AD55CD4B.quest_subtitle: "Random among matches"
	quest.4BDB8583AD55CD4B.title: "&6Shuffle Filter"
	quest.4BEB878CAB710AA3.quest_desc: [
		"Crafted from a hardened mechanism, an &eOxygen Separator&r, a propeller and titanium sheets. Pair it with thrusters; it also feeds the Dimensional Drive for airships."
	]
	quest.4BEB878CAB710AA3.quest_subtitle: "Where the fuel burns."
	quest.4BEB878CAB710AA3.title: "&9Combustion Chamber"
	quest.4C2CD6515EF0DD39.quest_desc: [
		"Place a &eRotation Speed Controller&r on a brass casing with a shaft out the top. Scroll the target RPM and that shaft matches it, no matter how fast the input is."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4C2CD6515EF0DD39.title: "Rotation Speed Controller"
	quest.4C2CD6515EF0DD39.quest_subtitle: "A &6Rotational Speed Controller&r allows for fine tuning of &6RPM&r, meaning you can modify how fast or slow it will be"
	quest.4C88AACD94986A30.quest_desc: [
		"Powered through a &6Shaft&r from below, it will only rotate by a configured amount before stopping"
		""
		"When no rotational power is provided, the &6Torsion Spring&r will return to its initial rotation"
	]
	quest.4C88AACD94986A30.title: "Torsion Spring"
	quest.4C88AACD94986A30.quest_subtitle: "A &6Torsion Spring&r allows rotational movement to be limited to a specific angle"
	quest.4C8BD6528E0AF188.quest_desc: [
		"Gold, bones, phantom membranes and rotten flesh around an Eye of Ender. It flies toward a Frosted Prison."
	]
	quest.4C8BD6528E0AF188.quest_subtitle: "Crafted at a crafting table around an Eye of Ender. Throw it and it flies toward the nearest Frosted Prison."
	quest.4C8BD6528E0AF188.title: "&eCursed Eye"
	quest.4CB5B0AF815D6A3D.quest_desc: [
		"Glue a &ePortable Fuel Interface&r onto the train's &eFuel Tank&r, park at a station with a matching interface, and a pump fills the tank."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4CB5B0AF815D6A3D.quest_subtitle: "Like Create's portable storage interface, but for fluids: a station pumps fuel into a waiting train."
	quest.4CB5B0AF815D6A3D.title: "&cPortable Fuel Interface"
	quest.4CFBD72ED6B727D5.quest_desc: [
		"Opposite of Create's Gearshift: it sits reversed until you power it. Use it when the unpowered default should already be flipped."
	]
	quest.4CFBD72ED6B727D5.quest_subtitle: "A gearshift that changes shaft rotation direction when powered."
	quest.4CFBD72ED6B727D5.title: "&6Inverted Gearshift"
	quest.4D0E68044AEAFF13.quest_desc: [
		"You can leave Earth without a rocket, land on a Lantern world, and keep the ring fed from a battery you built."
		""
		"The rocket path is still there under Lift-off if you want Northstar's own planets the slow way. Wear both hats if you like."
	]
	quest.4D0E68044AEAFF13.quest_subtitle: "A ring, a world, a battery"
	quest.4D0E68044AEAFF13.title: "&aLantern Bearer"
	quest.4D3BF0D99D937C87.quest_desc: [
		"Mechanical-craft a Kart Chassis from Andesite Alloy, iron ingots and iron nuggets."
		"This is the sequenced-assembly blank for a Create Kart: every finished kart starts on this frame."
	]
	quest.4D3BF0D99D937C87.quest_subtitle: "Andesite alloy frame"
	quest.4D3BF0D99D937C87.title: "&eKart Chassis"
	quest.4D63B46BF4CA209E.quest_desc: [
		"Apples press into cider the same way grapes become wine — EMI shows the exact steps."
		"It's the apple counterpart to a fine vintage, and it uses the cellar you just built."
	]
	quest.4D63B46BF4CA209E.quest_subtitle: "Apples work too."
	quest.4D63B46BF4CA209E.title: "&5Cider"
	quest.4D73BF9B7B5574C8.quest_desc: [
		"Wear &ePhysics Goggles&r and you get live force, propulsion, and assembly readouts on Simulated builds."
		"Different from Aviator's Goggles: these are for Gadgets ships and thruster tuning, not envelope pressure."
	]
	quest.4D73BF9B7B5574C8.quest_subtitle: "Wear &ePhysics Goggles&r and you get live force, propulsion, and assembly readouts on Simulated builds."
	quest.4D73BF9B7B5574C8.title: "Craft Physics Googles"
	quest.4DBD746A7DBD0A18.quest_desc: [
		"Point an &eEncased Fan&r through a water block to bulk-wash. Suspicious Rock washed this way breaks down into bones if you skip the Cage."
		"Hold &eW&r over the fan in EMI to see its Ponder."
	]
	quest.4DBD746A7DBD0A18.quest_subtitle: "If you don’t have a Conduit Cage and are only using bulk washing."
	quest.4DBD746A7DBD0A18.title: "&aActivate the &6Encased Fan &awith water"
	quest.4DC1633AFFAC7694.quest_desc: [
		"Cut Chorus Fruit on a Cutting Board or Slicer with a knife. One fruit becomes four Chorus Fruit Grain."
		""
		"This branch waits on the Exploration quest The End. End's Delight cooking also runs in a heated Mixer."
	]
	quest.4DC1633AFFAC7694.quest_subtitle: "Opens with the End"
	quest.4DC1633AFFAC7694.title: "&eChorus Fruit Grain"
	quest.4DE682C62B5C77E7.quest_desc: [
		"Make a plain waffle from Create Factory — EMI has the mixer and press steps."
		"Honey, jam, chocolate and spread toppings are the next quest."
	]
	quest.4DE682C62B5C77E7.quest_subtitle: "From &eCreate Factory&r: waffles, jams and chocolate spreads."
	quest.4DE682C62B5C77E7.title: "&eWaffles"
	quest.4DECA6D956FC4FFB.quest_desc: [
		"You already have a &ePackager&r. This chapter turns it into a logistics web: addressed cardboard, Frogports on chain conveyors, a Stock Link that lists inventories, then a shop other players can buy from."
		""
		"Three optional branches — &erouting&r on chains and trains, the &estock network&r and factory requests, and &emobile delivery&r (bees, planes, a backpack). They meet again at a working player shop if you want them to."
	]
	quest.4DECA6D956FC4FFB.quest_subtitle: "Address the crate. Trust the network. Sell what you spare."
	quest.4DECA6D956FC4FFB.title: "&bFrom Packages to Shops"
	quest.4E5DCFB4F721718D.quest_desc: [
		"A Water Wheel with a Starbuncle Charm inside. It turns by itself, so you can power Create machines without a water stream."
	]
	quest.4E5DCFB4F721718D.quest_subtitle: "From &eArs Creo&r: a water wheel with a Starbuncle running inside it. Free rotational power for your Create machines."
	quest.4E5DCFB4F721718D.title: "&6Starbuncle Wheel"
	quest.4E622855F293E9F0.quest_desc: [
		"Load a charge and a solid shot, then fire from the Cannon Mount. Tick this off once it has actually gone off."
	]
	quest.4E622855F293E9F0.quest_subtitle: "Load a charge and a shot, then fire your cannon. Tick this off once you have."
	quest.4E622855F293E9F0.title: "&c&lFire!"
	quest.4F4E1DEE8F0200D6.quest_desc: [
		"The basic track. Shape it into slopes, curves and junctions the same way as vanilla."
		"Start here, then replace key sections with powered or controller rails."
	]
	quest.4F4E1DEE8F0200D6.quest_subtitle: "The basic track. Shape it into slopes, curves and junctions the same way as vanilla."
	quest.4F4E1DEE8F0200D6.title: "&dRail"
	quest.4F552914EF729EE9.quest_desc: [
		"Shrapnel for crowds, smoke for cover, AP to burst inside a structure, or a fluid shell that dumps whatever you filled it with. Wear a gas mask before you try smoke."
	]
	quest.4F552914EF729EE9.quest_subtitle: "Shrapnel, smoke, AP, or a shell full of whatever fluid you like."
	quest.4F552914EF729EE9.title: "&4Specialised Shells"
	quest.4F576C152529CBB1.quest_desc: [
		"Powered, it behaves like a powered rail. The extra trick is a scroll-configured speed, including reverse."
		"That's how you send a cart contraption back without a second locomotive. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4F576C152529CBB1.quest_subtitle: "Used to control the speed of Minecarts or Minecart Contraptions"
	quest.4F576C152529CBB1.title: "&eController Rail"
	quest.4F6BE75EFB4FAB1F.quest_desc: [
		"Cook sourceberries, mendosteen, frostaya, bombegrante and the rest in a Farmer's Delight kitchen. Bastion, Frostaya and Bombegrante pies are the tasting menu."
	]
	quest.4F6BE75EFB4FAB1F.quest_subtitle: "Ars Nouveau meets Farmer's Delight: cook with sourceberries, mendosteen and other magical plants."
	quest.4F6BE75EFB4FAB1F.title: "&aArs Delight"
	quest.4F854858838BE85B.quest_desc: [
		"Craft a &ePower Core&r from four brass blocks, four &ePrecision Mechanisms&r and a Beacon. It comes charged, and keeps that charge when you break it."
		""
		"This is the centre of the Create multiblock that refills lanterns."
	]
	quest.4F854858838BE85B.quest_subtitle: "Heart of the Central Power Battery"
	quest.4F854858838BE85B.title: "&6Power Core"
	quest.4FFD9BAC2F94ADBB.quest_desc: [
		"Place &eTrain Tracks&r with a wrench in hand to curve and slope them. Connect two &eTrain Stations&r with a continuous line before you try to assemble a locomotive."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.4FFD9BAC2F94ADBB.quest_subtitle: "The thing your trains go on"
	quest.4FFD9BAC2F94ADBB.title: "Train Tracks"
	quest.50298AF2ED77D186.quest_desc: [
		"One of the two distillation cuts from crude oil. Fuel for the engines you're about to build."
	]
	quest.50298AF2ED77D186.title: "Gasoline Bucket"
	quest.50298AF2ED77D186.quest_subtitle: "One of the two distillation cuts from crude oil. Fuel for the engines you're about to build."
	quest.503C8C28BE2E73C1.quest_desc: [
		"Smelt coffee beans into roasted beans, then mill or crush them. Crushing is a bit faster."
		"Mix the grounds into coffee fluid, then spout that into an iced cup."
	]
	quest.503C8C28BE2E73C1.quest_subtitle: "Roast the coffee beans, then mill them."
	quest.503C8C28BE2E73C1.title: "&6Coffee Grounds"
	quest.5045F5EEFB84A0B7.quest_desc: [
		"A bag that pulls the next stack from storage into your hand as you use it. Useful for building, eating, or keeping a wand fed."
	]
	quest.5045F5EEFB84A0B7.quest_subtitle: "A bag that refills your hand from storage."
	quest.5045F5EEFB84A0B7.title: "&aHandy Haversack"
	quest.505C272F43942FDA.quest_desc: [
		"A dispenser on wheels, from Supplementaries. A powered &eActivator Rail&r fires or places whatever you loaded."
		"Handy on cart contraptions that need to drop items or shoot mid-route."
	]
	quest.505C272F43942FDA.quest_subtitle: "A dispenser on wheels, from Supplementaries. A powered &eActivator Rail&r fires or places whatever you loaded."
	quest.505C272F43942FDA.title: "&2Minecart with Dispenser"
	quest.505D0025C3E036D4.quest_desc: [
		"Iron sheets and andesite alloy craft several at once. Mount them on a Simulated hull as flight surfaces."
		"You can saw or stonecut one into a copycat wing if you want the same job in another block's skin."
	]
	quest.505D0025C3E036D4.title: "Wing"
	quest.505D0025C3E036D4.quest_subtitle: "Iron sheets and andesite alloy craft several at once. Mount them on a Simulated hull as flight surfaces."
	quest.5071FAFF85324148.quest_desc: [
		"Compact mud and moss in a basin, or craft a ring of them around water. Building block now, &ePeat Briquettes&r after a trip through a smoker."
	]
	quest.5071FAFF85324148.quest_subtitle: "Can be used as building blocks or turned into &aPeat Briquettes "
	quest.5071FAFF85324148.title: "&dPeat"
	quest.509F43D5C5B9E7D6.quest_desc: [
		"Mechanical-craft a pair of &eCrushing Wheels&r and spin them against each other. They crush ores into crushed raw with bonus chances the millstone never sees."
		"Keep the millstone for recipes these wheels do not share. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.509F43D5C5B9E7D6.title: "Crushing Wheel"
	quest.509F43D5C5B9E7D6.quest_subtitle: "Essentially an upgrade to the &6Millstone&r, each of them provides some different recipes so it might be worth keeping both around"
	quest.50AC5D9635367390.quest_desc: [
		"Crafted with the help of 11 &6Mechanical Crafters&r this item is the first step towards renewable &4blaze fuels&r"
	]
	quest.50AC5D9635367390.quest_subtitle: "Now time to fuel it"
	quest.50AC5D9635367390.title: "&2Inactive Blaze Core"
	quest.5105D072C590AC15.quest_desc: [
		"Wear the full set before you leave the atmosphere. Keep the copper backtank on the chestpiece filled at the &eOxygen Filler&r, or you will suffocate in orbit."
	]
	quest.5105D072C590AC15.quest_subtitle: "There's no air up there. The chestpiece carries a copper backtank: keep it filled."
	quest.5105D072C590AC15.title: "&bIron Space Suit"
	quest.512B1323F6068403.quest_desc: [
		"&eDeer&r. Complete it by obtaining &6Deer&r."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.512B1323F6068403.quest_subtitle: "A Naturalist classic"
	quest.512B1323F6068403.title: "&eDeer"
	quest.51346FAD3D5709FB.quest_desc: [
		"Now that we have crafted everything necessary we can finally make our &3Echo sword&r, a powerful weapon that inflicts &cdebuffs&r to anybody and anything it hits"
	]
	quest.51346FAD3D5709FB.quest_subtitle: "Now that we have crafted everything necessary we can finally make our &3Echo sword&r, a powerful weapon that inflicts &cdebuffs&r to anyb..."
	quest.51346FAD3D5709FB.title: "&bEcho Sword"
	quest.5145676FB585FF6C.quest_desc: [
		"A charm that summons a little fox to move items between inventories. Give it a wheel next for free Create power, or pick up more helper charms."
	]
	quest.5145676FB585FF6C.quest_subtitle: "A little helper that carries items between containers."
	quest.5145676FB585FF6C.title: "&6Starbuncle"
	quest.51473D35F3B04E2A.quest_desc: [
		"Blaze powder, netherite scrap and soul sand around an Eye of Ender. It leads to the Burning Arena."
	]
	quest.51473D35F3B04E2A.quest_subtitle: "Crafted at a crafting table around an Eye of Ender. Throw it and it flies toward the nearest Burning Arena."
	quest.51473D35F3B04E2A.title: "&eFlame Eye"
	quest.515F8B4EF94F6155.quest_desc: [
		"Drygmies farm mob drops, Whirlisprigs grow plants, Wixies craft and brew, Amethyst Golems harvest buds, Bookwyrms sort a storage lectern. Charm them at the apparatus."
	]
	quest.515F8B4EF94F6155.quest_subtitle: "Drygmies farm mob drops, Whirlisprigs grow plants, Wixies craft and brew, Amethyst Golems harvest amethyst."
	quest.515F8B4EF94F6155.title: "&6More Helpers"
	quest.5160C9AD28A09E93.quest_desc: [
		"Sequenced assembly: spout lava onto powdered obsidian, then press twice."
		"Signals, schedules, rollers and the rest of this chapter want more sheets than the first casing did."
	]
	quest.5160C9AD28A09E93.quest_subtitle: "Sequenced assembly: spout lava onto powdered obsidian, then press twice."
	quest.5160C9AD28A09E93.title: "&bSturdy Sheet"
	quest.516FAEEB8E9BC5EA.quest_desc: [
		"On this pack you compact four small flowers with a bucket of water in a &eMechanical Press&r over a &eBasin&r to make &eRubber&r, then press that into sheets."
		"Those sheets replace kelp in belts, funnels, tunnels, and spouts — grab some before Andesite Age logistics."
	]
	quest.516FAEEB8E9BC5EA.title: "Rubber"
	quest.516FAEEB8E9BC5EA.quest_subtitle: "&6&lCreate&r recipes using &aDried Kelp&r have been replaced with &8Pressed Rubber&r"
	quest.517750A4CF1097BD.quest_desc: [
		"Craft a &eRe-Packager&r by converting a Packager in a crafting grid (and convert it back the same way). It unpacks mixed boxes so frogports can sort them."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.517750A4CF1097BD.title: "Repackager"
	quest.517750A4CF1097BD.quest_subtitle: "Craft a &eRe-Packager&r by converting a Packager in a crafting grid (and convert it back the same way). It unpacks mixed boxes so frogpor..."
	quest.5188F35E57A03EF2.quest_desc: [
		"A &eLarge Water Wheel&r wants a wide channel of flowing water across its blades. Right-click it with planks to change the wood, same as the small wheel."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5188F35E57A03EF2.title: "Large Water Wheel"
	quest.5188F35E57A03EF2.quest_subtitle: "Generates twice as much &6SU&r as the regular &9Water Wheel&r but at a slower &6RPM&r. Just know that this is bigger and bulkier, so prepare a lot of space for it"
	quest.51B1952CA3175688.quest_desc: [
		"Glue a &eMechanical Plough&r onto a bearing or cart and drive it over dirt to till farmland, or into mobs to shove them aside."
		"Pair it with a harvester for a moving crop line. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.51B1952CA3175688.title: "Mechanical Plough"
	quest.51B1952CA3175688.quest_subtitle: "&6Mechanical Ploughs&r allow contraptions to plough farmland or launch entities"
	quest.51EB04F9DB620A23.quest_desc: [
		"Can be obtained by right-clicking a piece of Stripped Log with a Brass Ingot"
		""
		"You need &6Brass Casing&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.51EB04F9DB620A23.quest_subtitle: "For Kinetic Battery and Kinetic Bridge."
	quest.51EB04F9DB620A23.title: "&6Brass Casing"
	quest.51ED2D53445DAB57.quest_desc: [
		"Thrust from FE and redstone, no fuel line. Electric Flight hangs a whole chapter off this block."
		"Feed it from on-board accumulators. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.51ED2D53445DAB57.title: "Ion Thruster"
	quest.51ED2D53445DAB57.quest_subtitle: "An &eIon Thruster&r provides directional &6Propulsion&r when powered by &credstone&r and supplied with &6FE&r energy"
	quest.521DBB3674FAC59C.quest_desc: [
		"Slap it on a button or lever to get a Redstone Link without a second block. Same frequency slots, half the footprint."
	]
	quest.521DBB3674FAC59C.quest_subtitle: "A compact Redstone Link that adds wireless redstone to buttons and levers without using extra block space."
	quest.521DBB3674FAC59C.title: "&6Linked Transmitter"
	quest.525FD6B365FB7B50.quest_desc: [
		"The rare drop from crushing nautilus shells — and a lucky channel of Suspicious Rock. You need three plus Alloy Rods to craft a &eTrident&r."
	]
	quest.525FD6B365FB7B50.quest_subtitle: "The rare drop from crushing nautilus shells — and a lucky channel of Suspicious Rock. You need three plus Alloy Rods to craft a &eTrident&r."
	quest.525FD6B365FB7B50.title: "&aObtain &rSpiky Shell"
	quest.5272D9AC88702DE2.quest_desc: [
		"The modular one. Stack several and the stress scales with the stack. Same fuels as the small engine."
	]
	quest.5272D9AC88702DE2.title: "Large Diesel Engine"
	quest.5272D9AC88702DE2.quest_subtitle: "&6Modular Diesel Engines&r function like normal diesel generators. They can be stacked and will generate stress proportionally to how many engines you stack"
	quest.52E043CA3F3DADF1.quest_desc: [
		"&b&lThe Illustrious MFPack&r is built around &6&lCreate&r — a sandbox of kinetics. This chapter sketches what exists; it will not walk you to the end."
		""
		"Hover an item in &dEMI&r or your inventory and hold &eW&r to &bponder&r it. When the book is quiet, build something ugly and see what turns."
		""
		"{image:minecraft:textures/gui/title/minecraft.png width:397 height:99 align:center fit:true}"
		""
		"Side chapters unlock when your Create age can support them. Skip freely; come back when a machine finally makes sense."
	]
	quest.52E043CA3F3DADF1.quest_subtitle: "Shafts, steam, and whatever you invent next."
	quest.52E043CA3F3DADF1.title: "&6The Workshop Opens"
	quest.52F7B7F6FE3C861C.quest_desc: [
		"Smelt or smoke gingerdough. The result is food, and you can still press a man from the raw dough instead."
	]
	quest.52F7B7F6FE3C861C.title: "Gingerbread"
	quest.52F7B7F6FE3C861C.quest_subtitle: "Smelt or smoke gingerdough. The result is food, and you can still press a man from the raw dough instead."
	quest.5307073E03279837.quest_desc: [
		"A Dull Trinket is the blank for rings, amulets and belts. Enchant it on the apparatus into jewellery that actually does something."
	]
	quest.5307073E03279837.quest_subtitle: "The base for rings, amulets and belts."
	quest.5307073E03279837.title: "&eTrinkets"
	quest.533C58555E4F1616.quest_desc: [
		"Craft two iron sheets on an &eItem Drain&r. Pipe chocolate (or another dippable fluid) in, then right-click food onto the fountain."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.533C58555E4F1616.quest_subtitle: "Get some cheese and dip in it"
	quest.533C58555E4F1616.title: "&6Chocolate Fountain"
	quest.535AB5D4FA17ACBA.quest_desc: [
		"The world border is 5,000 by 5,000 blocks, centred on spawn. Everything below is somewhere inside it."
	]
	quest.535AB5D4FA17ACBA.quest_subtitle: "Integrated Dungeons and Structures, Integrated Villages and a new stronghold fill the world with places worth finding."
	quest.535AB5D4FA17ACBA.title: "&aOut There"
	quest.53680D911DA3DF42.quest_desc: [
		"Drive past a red &eTrain Signal&r on purpose."
		"A short test siding is kinder to the rest of your network than doing it on the main line."
	]
	quest.53680D911DA3DF42.quest_subtitle: "Run a red &cTrain Signal"
	quest.53680D911DA3DF42.title: "&cExpert Driver"
	quest.538ED1B4F997F491.quest_desc: [
		"Glue &eTrain Controls&r into the cab, sit in a seat, and you get throttle and brake. Without these, only a scheduled conductor can drive."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.538ED1B4F997F491.title: "Controls"
	quest.538ED1B4F997F491.quest_subtitle: "&6Train Controls&r allow you to control the train"
	quest.5396B679AE4D0F37.quest_desc: [
		"Pick Sorcerer, Arcanist or Battlemage robes. They boost mana, and Ars Elemental later upgrades each set into elemental armour."
	]
	quest.5396B679AE4D0F37.quest_subtitle: "Sorcerer, Arcanist or Battlemage: armour that boosts your mana."
	quest.5396B679AE4D0F37.title: "&dMage Armour"
	quest.53BCB756649D4D2B.quest_desc: [
		"This is a Conduit you can pipe and automate. Pair it with an &eEncased Fan&r to channel items, or feed it potions to spread effects."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.53BCB756649D4D2B.quest_subtitle: "This is a Conduit you can pipe and automate. Pair it with an &eEncased Fan&r to channel items, or feed it potions to spread effects."
	quest.53BCB756649D4D2B.title: "&3Conduit Cage"
	quest.540DCA232C7547C7.quest_desc: [
		"A &eConduit&r, &ePrismarine Alloy&r, Alloy Rods, and a &eFluid Pipe&r. That's the shopping list for the machine this chapter is built around."
	]
	quest.540DCA232C7547C7.quest_subtitle: "A &eConduit&r, &ePrismarine Alloy&r, Alloy Rods, and a &eFluid Pipe&r. That's the shopping list for the machine this chapter is built aro..."
	quest.540DCA232C7547C7.title: "&aGather Materials to craft a &3Conduit Cage"
	quest.54591574E7E9EC99.quest_desc: [
		"A dummy that reports how hard you hit. Useful while you learn recoil and range, before you point a gun at something that shoots back."
	]
	quest.54591574E7E9EC99.quest_subtitle: "A humanoid target that shows your damage."
	quest.54591574E7E9EC99.title: "&7Target Practice"
	quest.54AA2FBE635E3746.quest_desc: [
		"Place &eItem Vaults&r against each other to grow a dense chest you cannot open by hand. Use funnels, chutes, or a packager to get items in and out."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.54AA2FBE635E3746.title: "Item Vault"
	quest.54AA2FBE635E3746.quest_subtitle: "A &6Vault&r is a multi-block item storage that can't be accessed manually but with greater item density than vanilla storages"
	quest.54C21AAB3D24A2F7.quest_desc: [
		"Stand the assembled cannon on this to aim and fire. Power it, then add a Yaw Controller when you want the whole mount to turn."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.54C21AAB3D24A2F7.quest_subtitle: "Turns a stack of cannon parts into a cannon you can aim and fire."
	quest.54C21AAB3D24A2F7.title: "&cCannon Mount"
	quest.54C5C23D4C76961A.quest_desc: [
		"Place a &eTrain Coupler&r on the track where you want cars to join or split, then put a couple or decouple instruction on the schedule."
		"That's how a locomotive drops wagons at a siding without you riding along. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.54C5C23D4C76961A.quest_subtitle: "Couple and decouple trains at a fixed spot on the line. That's how you drop off or pick up wagons automatically."
	quest.54C5C23D4C76961A.title: "&eTrain Couplers"
	quest.54DF387F802921AB.quest_desc: [
		"Create Gadgets & Gizmos: thrusters, industrial FE machines, physics gantries, and the analogue cockpit for Simulated ships."
		"It opens once you have a &ePrecision Mechanism&r. Gather materials, then pick a branch: thrust, power, or controls."
	]
	quest.54DF387F802921AB.quest_subtitle: "&7Opens after &ecreate:precision_mechanism&7 (Brass Age)"
	quest.54DF387F802921AB.title: "Welcome to Gadgets And Gizmos"
	quest.54F157D3C8CB7557.quest_desc: [
		"&eWelcome to Enchantment Industry.&r. Complete it by obtaining &6Welcome to Enchantment Industry.&r."
		""
		"Opens after create:spout (Copper Age)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.54F157D3C8CB7557.quest_subtitle: "This Create add-on offers more tools and methods to handle enchantments, as well as experience storage."
	quest.54F157D3C8CB7557.title: "&6Welcome to Enchantment Industry."
	quest.5508E6B4D3EE61CB.quest_desc: [
		"Tiny cogs and a worm gear — ratios Create's normal cogs can't hit. In this pack the tiny cogwheel is a shaft plus a wooden button, not a slab."
	]
	quest.5508E6B4D3EE61CB.quest_subtitle: "Tiny cogs, worm gears, ring gears and planetary gears, for gear ratios Create can't do on its own."
	quest.5508E6B4D3EE61CB.title: "&6Gears n' Kinetics"
	quest.55152919769B9863.quest_desc: [
		"Craft a Grappling Hook from one iron ingot and four Silk. Silk has no crafting recipe. The hook has 256 durability."
	]
	quest.55152919769B9863.quest_subtitle: "Iron and four Silk"
	quest.55152919769B9863.title: "&6Grappling Hook"
	quest.555508F1582AF26C.quest_desc: [
		"Four candy canes in the shovel shape. That's most of the candy tools; the hoe is last."
		""
		"You need &6Candy Cane Shovel&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.555508F1582AF26C.quest_subtitle: "Four candy canes in the shovel shape. That's most of the candy tools; the hoe is last."
	quest.555508F1582AF26C.title: "&eCandy Cane Shovel"
	quest.5565EC42DFB73B73.quest_desc: [
		"It stores several filled maps, lets you pick the active target, and can be filled or emptied with item automation."
		"Outputs directional redstone toward the chosen map so a ship can fly a route. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5565EC42DFB73B73.quest_subtitle: "It stores several filled maps, lets you pick the active target, and can be filled or emptied with item automation."
	quest.5565EC42DFB73B73.title: "Craft Advance Navigtion Table"
	quest.55BE81A7CBA9D72F.quest_desc: [
		"Iron, copper, andesite alloy, and brass. That covers the Stirling, burners, thrusters, wings, and redstone gadgets in this chapter."
		"Platinum is a separate branch: ore first, then tanks, cables, and the vector thruster."
	]
	quest.55BE81A7CBA9D72F.quest_subtitle: "Iron, copper, andesite alloy, and brass. That covers the Stirling, burners, thrusters, wings, and redstone gadgets in this chapter."
	quest.55BE81A7CBA9D72F.title: "Gather Supplies"
	quest.55C65B9011C9B16D.quest_desc: [
		"An old Northstar structure on the Moon. Search it for leftovers, then get back to sapphire and sealing a room of your own."
	]
	quest.55C65B9011C9B16D.quest_subtitle: "Someone got here first. Find what they left behind."
	quest.55C65B9011C9B16D.title: "&7Abandoned Lunar Base"
	quest.55D143E89EAA9BAC.quest_desc: [
		"Slot a &eThruster Lens&r into a Gadgets thruster to switch Focused Mode: it spends FE and fires an energy beam instead of burning fuel."
		"Craft this after the thruster itself. A lens and a propulsion upgrade can sit in the same machine."
	]
	quest.55D143E89EAA9BAC.quest_subtitle: "Slot a &eThruster Lens&r into a Gadgets thruster to switch Focused Mode: it spends FE and fires an energy beam instead of burning fuel."
	quest.55D143E89EAA9BAC.title: "Craft Thruster Lens"
	quest.55E91D23970DE168.quest_desc: [
		"Closest to the sun, and the only place for tungsten. Bring liquid hydrogen for the burn and a Martian Steel suit for the heat."
	]
	quest.55E91D23970DE168.quest_subtitle: "Closest to the sun, and full of tungsten."
	quest.55E91D23970DE168.title: "&8Mercury"
	quest.5661DFADCF2EF5F1.quest_desc: [
		"The &eRedstone Inductor&r eases its output toward the input over a delay you set. The &eRedstone Accumulator&r stores a level: back face charges it, sides drain it."
		"Delays can run a long time, so they make gentle throttles for engines and burners. Hold &eW&r over them in EMI to see their Ponder."
	]
	quest.5661DFADCF2EF5F1.quest_subtitle: "The &eRedstone Inductor&r eases its output toward the input over a delay you set. The &eRedstone Accumulator&r stores a level: back face ..."
	quest.5661DFADCF2EF5F1.title: "Redstone Equipments"
	quest.56723AE661B61F88.quest_desc: [
		"It grabs the block in front. Glue a cluster, power the cog, and that cluster becomes a Simulated assembly that can pivot around the bearing."
		"Shaft rotation passes straight through while it turns. Redstone can unlock it so it spins freely. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.56723AE661B61F88.title: "Swivel Bearing"
	quest.56723AE661B61F88.quest_subtitle: "An &8Swivel Bearing&r allows simulated contraptions to rotate around a point in space"
	quest.56B6E71A8D4D1B5D.quest_desc: [
		"Supplementaries adds decorative bits like pedestals. Use a Wrench to rotate a block."
		""
		"You need &6Supplementaries&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.56B6E71A8D4D1B5D.quest_subtitle: "Pedestals and a Wrench"
	quest.56B6E71A8D4D1B5D.title: "&eSupplementaries"
	quest.56D9AB16B8C054B0.quest_desc: [
		"Catches a beam and turns it back into rotation. Pair with a &eCopper Coil&r — the light-to-shaft end of the link."
	]
	quest.56D9AB16B8C054B0.quest_subtitle: "Transforms the received beam into &6rotational force&r based on its properties"
	quest.56D9AB16B8C054B0.title: "&6Optical Receptor"
	quest.56F378317EFB975E.quest_desc: [
		"Closes a Basin so it can ferment. Fermentable crops plus bone meal in a lidded basin cook down into &eEthanol&r."
	]
	quest.56F378317EFB975E.title: "Basin Lid"
	quest.56F378317EFB975E.quest_subtitle: "Closes a Basin so it can ferment. Fermentable crops plus bone meal in a lidded basin cook down into &eEthanol&r."
	quest.570FB03B04D650BD.quest_desc: [
		"Two independent shafts crossing in one block. Relay two rotations through a junction without them fighting."
	]
	quest.570FB03B04D650BD.quest_subtitle: "Relays rotation in two directions independently."
	quest.570FB03B04D650BD.title: "&6Cross Connector"
	quest.5731A22D8497D62A.quest_desc: [
		"&eNetherite Diving Boots&r keep the seafloor walk of copper and survive fire. Wear the full netherite set if you are working in the Nether."
	]
	quest.5731A22D8497D62A.title: "Netherite Diving Boots"
	quest.5731A22D8497D62A.quest_subtitle: "An upgraded version of the &6Copper Diving Boots&r"
	quest.576DB3753456355E.quest_desc: [
		"At low movement speeds, &bLevitite&r significantly resists motion. This resistance drops at higher movement speeds"
	]
	quest.576DB3753456355E.quest_subtitle: "&bLevitite&r can help keep contraptions afloat, but additional forces are required to gain altitude"
	quest.576DB3753456355E.title: "Levitite"
	quest.5788996A8A73DB96.quest_desc: [
		"The &ePotato Cannon&r launches food as ammo. Different crops hit differently — a silly sidegrade you mechanical-craft after the crafters are up."
	]
	quest.5788996A8A73DB96.title: "Potato Cannon"
	quest.5788996A8A73DB96.quest_subtitle: "Simply a Potato Cannon"
	quest.57BCCCFE5454E008.quest_desc: [
		"Faces a block and outputs redstone while that block is oxygenated. Wire it to alarms or doors so a leak does not kill everyone inside."
	]
	quest.57BCCCFE5454E008.quest_subtitle: "Outputs redstone when a room loses its air."
	quest.57BCCCFE5454E008.title: "&bOxygen Detector"
	quest.58C92788CE923241.quest_desc: [
		"Place an &eAdvanced Display&r at the station and link it to your network."
		"It needs named stations and running schedules, same as the Navigator."
	]
	quest.58C92788CE923241.quest_subtitle: "Advanced display boards show the next trains, platforms and delays at a station."
	quest.58C92788CE923241.title: "&aDeparture Boards"
	quest.58E50A870CDEBD40.quest_desc: [
		"Lay track into a Nether (or other) portal so the train follows you through."
		"Stations on both sides make it a proper interdimensional commute."
	]
	quest.58E50A870CDEBD40.quest_subtitle: "Ride a &bTrain&r through a portal"
	quest.58E50A870CDEBD40.title: "&dDimensional Commuter"
	quest.5912B0FF5824D8FD.quest_desc: [
		"Grab &ePrismarine&r from reefs or an Ocean Monument, plus copper nuggets. Mix or craft them into &ePrismarine Alloy&r."
	]
	quest.5912B0FF5824D8FD.quest_subtitle: "Can be found in the ocean and at Ocean Monuments."
	quest.5912B0FF5824D8FD.title: "&aGather Materials "
	quest.5983516F879F51CA.quest_desc: [
		"Superheat rutile, &eSodium Catalyst&r, zinc and carbon in a mixer. This fluid is the Earth-side route to your first titanium ingots."
	]
	quest.5983516F879F51CA.quest_subtitle: "Mix rutile, sodium catalyst, zinc and carbon in a heated basin. Carbon is compacted from coal or biofuel."
	quest.5983516F879F51CA.title: "&7Titanium Tetrachloride"
	quest.59BADF38D316E33E.quest_desc: [
		"Build a tower of &eFluid Tanks&r, put water inside and heat under the bottom tank, then attach &eSteam Engines&r to the sides."
		"Keep it fed and it is Create's densest stress source. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.59BADF38D316E33E.quest_subtitle: "The densest kinetic source and endgame of regular Create for Stress Unit generation, although it also has the highest complexity, requiring a steady source of &9water&r and &6heat&r"
	quest.59BADF38D316E33E.title: "Steam Engine"
	quest.59BF777461296B9A.quest_desc: [
		"Wait for the &eChicken Roost&r to lay, or speed it up with a bit of seed. Take the egg from its output."
		"Hopper or arm the eggs out if you're automating sandwiches next."
	]
	quest.59BF777461296B9A.quest_subtitle: "Wait for the &eChicken Roost&r to lay, or speed it up with a bit of seed. Take the egg from its output."
	quest.59BF777461296B9A.title: "&eObtain Eggs From the &bChicken Roost"
	quest.59D1636F8843063E.quest_desc: [
		"Mix sugar, &eCinder Flour&r, &eWheat Flour&r and honey in a basin. No heat needed."
		"Bake the dough into gingerbread, or press it into a gingerbread man."
	]
	quest.59D1636F8843063E.title: "Gingerdough"
	quest.59D1636F8843063E.quest_subtitle: "Mix sugar, &eCinder Flour&r, &eWheat Flour&r and honey in a basin. No heat needed."
	quest.5A013800B7F1E4C1.quest_desc: [
		"Four candy canes in the hoe shape. That's the last of the candy tools."
		""
		"You need &6Candy Cane Hoe&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.5A013800B7F1E4C1.quest_subtitle: "Four candy canes in the hoe shape. That's the last of the candy tools."
	quest.5A013800B7F1E4C1.title: "&eCandy Cane Hoe"
	quest.5A1B67C68500F828.quest_desc: [
		"A powered &eAuger Shaft&r pulls items out of harvesting actors along its length and moves them. Wrench it to swap shaft and cog."
		"Encasing it in industrial iron is optional. You cannot insert or extract at the cog or either end. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5A1B67C68500F828.quest_subtitle: "A powered &eAuger Shaft&r pulls items out of harvesting actors along its length and moves them. Wrench it to swap shaft and cog."
	quest.5A1B67C68500F828.title: "Auger Blocks"
	quest.5A352C042058324D.quest_desc: [
		"Feed a spinning &eMillstone&r by dropping items on top or with a funnel. It is the cheap grinder for flour and dusts until you unlock crushing wheels."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5A352C042058324D.title: "Millstone"
	quest.5A352C042058324D.quest_subtitle: "Grinding it all down to dust"
	quest.5A384999FAD89C9B.quest_desc: [
		"On End highlands and midlands. The Ender Guardian lives in the ruin; the End must be opened first."
	]
	quest.5A384999FAD89C9B.quest_subtitle: "A ruined citadel on the outer End islands (highlands and midlands)."
	quest.5A384999FAD89C9B.title: "&6Ruined Citadel"
	quest.5A485ED6B4B014D0.quest_desc: [
		"&eAndesite&r hides in stone as pale gray blobs, easy to walk past. You can also craft it from diorite and cobblestone if the caves are dry."
		""
		"Stock a few stacks; &eAndesite Alloy&r eats it quickly."
	]
	quest.5A485ED6B4B014D0.quest_subtitle: "Everything that turns starts here."
	quest.5A485ED6B4B014D0.title: "&7Pale Stone"
	quest.5A576D629B37BEAF.quest_desc: [
		"Fill a Cake Base o' Enchanting at a Spout with liquid experience. Feed the cake to an Enchanter or Forger to make a Super Blaze — and brace that blaze so it doesn't pop."
	]
	quest.5A576D629B37BEAF.quest_subtitle: "This turns the Blaze into a Super Blaze. Just place 2 rods and 2 Blocks of Experience so it won’t explode."
	quest.5A576D629B37BEAF.title: "&2Craft Cake o' Enchanting"
	quest.5A5A789CF38BA336.quest_desc: [
		"Stack &eModular Accumulators&r into a bank (up to 3 wide and 5 tall) to store FE from an alternator. Each block holds 2,000,000 FE and moves energy at up to 5000 FE/t."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5A5A789CF38BA336.title: "Modular Accumulator"
	quest.5A5A789CF38BA336.quest_subtitle: "An &6Accumulator&r is a multi-block structure that lets you store large amounts of &6Energy (E)&r"
	quest.5A5B8770C80F7420.quest_desc: [
		"Its Garnishment Guide explains everything the mod adds."
		""
		"You need &6Almond&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.5A5B8770C80F7420.quest_subtitle: "Nuts, sweets and odd ingredients, processed with fans and machines."
	quest.5A5B8770C80F7420.title: "&eCreate: Garnished"
	quest.5A66873FA171E838.quest_desc: [
		"Find a Better Nether Fortress after you enter the Nether."
		""
		"Vanilla fortresses are replaced."
	]
	quest.5A66873FA171E838.quest_subtitle: "YUNG's Better Nether Fortresses"
	quest.5A66873FA171E838.title: "&6Nether Fortress"
	quest.5A6A73A6D4EACF86.quest_desc: [
		"This is the pack's other road into the sky. Rockets climb with steel and fuel; a &epower ring&r climbs with light — flight, hard light, a suit, and the &eLanterns x Northstar&r bridge that lets a lit ring leave a world the way a rocket does."
		""
		"Rings are not a first craft. At night a Lantern ship may crash nearby, its pilot's ring waiting in the wreck. Live in a way a light notices you, and one may come looking."
		""
		"Follow this chapter, or don't. The Corps does not conscript."
	]
	quest.5A6A73A6D4EACF86.quest_subtitle: "A ring chooses its bearer."
	quest.5A6A73A6D4EACF86.title: "&aThe Corps"
	quest.5A82E1993C9467B3.quest_desc: [
		"Craft a &eLever&r, &eTrain Casing&r and &ePrecision Mechanism&r."
		"Glue them to the locomotive, sit in a seat, and you can drive. You need this on the train before the station will assemble it."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5A82E1993C9467B3.quest_subtitle: "&2Train Controls&r allows you to control the train"
	quest.5A82E1993C9467B3.title: "&2Train Controls"
	quest.5A86AE1514DE9E08.quest_desc: [
		"A cold IDAS burial site. Dress warm, then get back to the Stronghold when you are ready for the End."
	]
	quest.5A86AE1514DE9E08.quest_subtitle: "A cold IDAS burial site. Dress warm, then get back to the Stronghold when you are ready for the End."
	quest.5A86AE1514DE9E08.title: "&bFrozen Crypt"
	quest.5AB8C0E0E3741E17.quest_desc: [
		"&eL_Ender's Cataclysm&r. Complete it by obtaining &6Flame Eye&r."
		""
		"Opens after Out There (Exploration) Cataclysm bosses cap the damage they take: about 20 per hit and 12-20 per second, per boss, no matter how many of you fight. A .50 BMG round still only lands ~22, and shots from beyond 12-38 blocks barely hurt. Fight up close, bring armour, and take turns. Their structures only generate in new terrain: the outer ring of the overworld, the Nether and the End.."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.5AB8C0E0E3741E17.quest_subtitle: "Eight bosses, each guarding its own structure. Every structure has an eye that leads you to it."
	quest.5AB8C0E0E3741E17.title: "&cL_Ender's Cataclysm"
	quest.5B1153E41E67209F.quest_desc: [
		"For our last step we will use a &6Spout filled with lava&r and fill up our &cBlaze core&r that's dropped onto a Depot underneath the Spout."
	]
	quest.5B1153E41E67209F.quest_subtitle: "Fuel used in well-done steak"
	quest.5B1153E41E67209F.title: "&9Superheated Blaze Core"
	quest.5B4791BA686AAD4E.quest_desc: [
		"Use the Stronghold portal after you have seen the Nether. The dragon is next; Cataclysm's Ruined Citadel is on the outer islands."
	]
	quest.5B4791BA686AAD4E.quest_subtitle: "Use the Stronghold portal after you have seen the Nether. The dragon is next; Cataclysm's Ruined Citadel is on the outer islands."
	quest.5B4791BA686AAD4E.title: "&5The End"
	quest.5B71A5D06F5FC8A0.quest_desc: [
		"Stonecut a zinc ingot into eight Copycat Boards."
		"Copycats+ cuts zinc into boards. Connected's copycat board also shapeless-converts into this one."
	]
	quest.5B71A5D06F5FC8A0.quest_subtitle: "Eight from one zinc ingot"
	quest.5B71A5D06F5FC8A0.title: "&eCopycat Board"
	quest.5B826E13BE0F7B0C.quest_desc: [
		"One thing not mentioned by &b&lponder&r is that the funnel can drop items on the ground when placed on an inventory and will only keep one item on the ground if it's close enough to the block the item lands on"
	]
	quest.5B826E13BE0F7B0C.title: "Andesite Funnel"
	quest.5B826E13BE0F7B0C.quest_subtitle: "A &6Funnel&r allows input and output of inventories one item at a time"
	quest.5B82C634CE484977.quest_desc: [
		"A &eRope Pulley&r lowers and raises a glued elevator of blocks, paying out rope as it goes. For passenger lifts with floors, wait for the brass &eElevator Pulley&r."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5B82C634CE484977.title: "Rope Pulley"
	quest.5B82C634CE484977.quest_subtitle: "A &6Rope Pulley&r allows for the creation of contraptions that move up and down"
	quest.5BB08263F2B5D7C3.quest_desc: [
		"Right-click a &eBrass Speaker&r to type an announcement. It plays over the area — station PA for arrivals, warnings, or whatever you want passengers to hear."
	]
	quest.5BB08263F2B5D7C3.title: "Brass Speaker"
	quest.5BB08263F2B5D7C3.quest_subtitle: "Right-click a &eBrass Speaker&r to type an announcement. It plays over the area — station PA for arrivals, warnings, or whatever you want..."
	quest.5C0A8337D2E92A0B.quest_desc: [
		"Opens with a &ePrecision Mechanism&r. Most of the book teaches one craft at a time; this chapter is optional finish-line work — goals that only make sense once two or more lines have already been lived."
		""
		"Each synergy is a checkmark when you have done it in the world — not a gate on the ages behind you. The last Illustrious goal waits on every synergy, for whoever wants a closing chord."
	]
	quest.5C0A8337D2E92A0B.quest_subtitle: "Precision in hand — where the chapters finally meet."
	quest.5C0A8337D2E92A0B.title: "&6Beyond One Mod"
	quest.5C179E93230EB007.quest_desc: [
		"Rings of Potential or Lesser Discount, amulets of mana boost or regen. Wear them so you can cast longer before the book runs dry."
	]
	quest.5C179E93230EB007.quest_subtitle: "More mana, faster regeneration, cheaper spells."
	quest.5C179E93230EB007.title: "&eMagical Jewellery"
	quest.5C251AB7110F0E5F.quest_desc: [
		"Bolts onto a Shaft instead of being a little generator block. Feed it fuel and the connected shaft becomes your power plant."
	]
	quest.5C251AB7110F0E5F.title: "Huge Diesel Engine"
	quest.5C251AB7110F0E5F.quest_subtitle: "&6Huge Diesel Engines&r connect to &6Shafts&r and will start generating kinetic energy once you give them some fuel"
	quest.5C3EBC32239E408E.quest_desc: [
		"Bores the inner diameter of a freshly cast barrel or chamber. Keep water on it while it runs or it overheats."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5C3EBC32239E408E.quest_subtitle: "Bores out freshly cast barrels and chambers. Cool it with water while it works."
	quest.5C3EBC32239E408E.title: "&6Cannon Drill"
	quest.5C57943A4AA32FB1.quest_desc: [
		"Glue a propeller onto this bearing and the blades can spin while they stay part of the bigger Simulated ship."
		"This is the mount Electric Flight will drive from an &eElectric Motor&r later. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5C57943A4AA32FB1.title: "Propeller Bearing"
	quest.5C57943A4AA32FB1.quest_subtitle: "A &6Propeller Bearing&r allows a propeller assembly to rotate and provide &6Propulsion&r while attached to a larger contraption"
	quest.5C61D230E8A41A99.quest_desc: [
		"Press brass ingots. Almost every Connected gadget in this chapter wants a sheet, a casing, or both."
	]
	quest.5C61D230E8A41A99.quest_subtitle: "Essential for everything we are about to craft"
	quest.5C61D230E8A41A99.title: "&6Brass Sheet"
	quest.5C90A411F6D30EE9.quest_desc: [
		"Apply Spring Alloy to an unfinished spring. As a block they store kinetic energy; as an item a charged spring can throw you or an entity, and it eats some fall damage."
	]
	quest.5C90A411F6D30EE9.quest_subtitle: "Apply Spring Alloy to an unfinished spring. As a block they store kinetic energy; as an item a charged spring can throw you or an entity,..."
	quest.5C90A411F6D30EE9.title: "&bSprings"
	quest.5C9C878E8C6DEEF7.quest_desc: [
		"Sneak-use faces to mark outputs and inputs, then put the linker in a controller so it can discover those blocks."
		"Open the board with sneak-use in air. Scope can be auto, whole block, or a single face."
	]
	quest.5C9C878E8C6DEEF7.title: "Contraption Network Linker"
	quest.5C9C878E8C6DEEF7.quest_subtitle: "Sneak-use faces to mark outputs and inputs, then put the linker in a controller so it can discover those blocks."
	quest.5CE4CA792328427A.quest_desc: [
		"Craft from a Stock Link, a gold ingot and glass. Right-click a Stock Link before placement to join its network. Seat a mob or Blaze Burner in front of it as the Stock Keeper, then right-click the keeper to order."
		"Submitted orders pack the items for transport. Set a target address on the request so Package Filters and Frogports know where to send them. Right-click the ticker itself to edit listing categories with attribute or list filters. Hold &eW&r over it in EMI."
	]
	quest.5CE4CA792328427A.quest_subtitle: "Order up from the network"
	quest.5CE4CA792328427A.title: "&eStock Ticker"
	quest.5CE618D90A0AF061.quest_desc: [
		"The other cut from crude. This is what the Diesel Engine, Modular Engine, and Huge Engine all want."
	]
	quest.5CE618D90A0AF061.title: "Diesel Bucket"
	quest.5CE618D90A0AF061.quest_subtitle: "The other cut from crude. This is what the Diesel Engine, Modular Engine, and Huge Engine all want."
	quest.5CFE7A2DE6EECBEA.quest_desc: [
		"Fuses two boss items into a stronger one: Infernal Forge plus Void Core becomes Void Forge, and so on. Beat more bosses to feed it."
	]
	quest.5CFE7A2DE6EECBEA.quest_subtitle: "Witherite, an anvil and redstone blocks. Fuses two boss weapons into a stronger one (Infernal Forge + Void Core = Void Forge, and more)."
	quest.5CFE7A2DE6EECBEA.title: "&8Mechanical Fusion Anvil"
	quest.5D0F32EAE81F9EF8.quest_desc: [
		"Upgrade the novice book at the apparatus for more slots and tier 2 glyphs. Mage armour and the Wilden fight sit behind this."
	]
	quest.5D0F32EAE81F9EF8.quest_subtitle: "Upgrade your book at the apparatus for more spell slots and tier 2 glyphs."
	quest.5D0F32EAE81F9EF8.title: "&dMage's Spell Book"
	quest.5D2866B8B177B27E.quest_desc: [
		"Stand a &eTesla Coil&r over a depot to charge energy items, or power it to shock nearby mobs. It drinks a lot of FE either way."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5D2866B8B177B27E.title: "Tesla Coil"
	quest.5D2866B8B177B27E.quest_subtitle: "Lets you charge certain items"
	quest.5D8770DD2177142F.quest_desc: [
		"The back of the gun. A cast-iron cannon end is simple; a sliding breech opens for mechanical reloading later."
	]
	quest.5D8770DD2177142F.quest_subtitle: "Closes the back of the cannon. A sliding breech can be reloaded by machine."
	quest.5D8770DD2177142F.title: "&8Breech"
	quest.5DC6203AE9661C6A.quest_desc: [
		"Nine Kindling Sticks in a square. Toss the bundle into a furnace or a &eBlaze Burner&r when you need a cheap, renewable shove of heat."
	]
	quest.5DC6203AE9661C6A.quest_subtitle: "Hey, it's better than coal at least."
	quest.5DC6203AE9661C6A.title: "&6Sticks Bundle"
	quest.5E5D62726D846A63.quest_desc: [
		"Potions now mix themselves. Feed them to a &eConduit Cage&r to grant or strip effects nearby — a conduit that works as a factory, not just a monument piece."
	]
	quest.5E5D62726D846A63.title: "Potions now mix themselves. Feed them"
	quest.5E5D62726D846A63.quest_subtitle: "Potions now mix themselves. Feed them to a &eConduit Cage&r to grant or strip effects nearby — a conduit that works as a factory, not jus..."
	quest.5E89E093362958B4.quest_desc: [
		"Click two corners to paint a glue box, then Ctrl-scroll to grow or shrink it. Hold Alt to plant a corner in mid-air."
		"It only joins Simulated assemblies, so Super Glue will not drag the wrong Create elevator into your hull. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5E89E093362958B4.title: "Honey Glue"
	quest.5E89E093362958B4.quest_subtitle: "&6Honey Glue&r is a convenient alternative to &aSuper Glue&r for simulated contraptions"
	quest.5EB05566545D1E5C.quest_desc: [
		"Place a &eTrain Station&r on the track under your glued locomotive, then assemble from its UI."
		"Craft two from a &eTrain Casing&r and a compass. A &eDeployer&r holding a wrench can assemble and disassemble for you."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5EB05566545D1E5C.quest_subtitle: "A &6Train Station&r is the block that deals with train assembly and disassembly"
	quest.5EB05566545D1E5C.title: "&6Train Station"
	quest.5ED5C71E8120C040.quest_desc: [
		"Starbuncles and Create belts share a floor with a Blaze Enchanter. Magic gathers the reagents; Enchantment Industry spends them."
		""
		"Tick this when an automated line has fed the enchanter at least once."
	]
	quest.5ED5C71E8120C040.quest_subtitle: "Ars feeding Create enchanting"
	quest.5ED5C71E8120C040.title: "&dSpellforged Factory"
	quest.5F161C9839C62F0C.quest_desc: [
		"A &eClutch&r disconnects the kinetic line while it has a redstone signal, so one machine can idle without stopping the factory."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.5F161C9839C62F0C.title: "Clutch"
	quest.5F161C9839C62F0C.quest_subtitle: "A &6Clutch&r allows you to stop rotational force from passing through when powered by a &credstone&r signal"
	quest.5F3FF42E32035B90.quest_desc: [
		"Compact the molten metal back into ingots, or pour it into sand moulds for barrels and breeches. This is your first cannon metal."
	]
	quest.5F3FF42E32035B90.quest_subtitle: "Compact molten cast iron back into ingots, or cast it straight into cannon parts."
	quest.5F3FF42E32035B90.title: "&8Cast Iron"
	quest.5F54692C554A45BE.quest_desc: [
		"Right-click a Diesel Engine with it. Same power, much less racket next to the base."
		""
		"You need &6Engine Silencer&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.5F54692C554A45BE.title: "Engine Silencer"
	quest.5F54692C554A45BE.quest_subtitle: "Use an &fEngine Silencer&r on a &6Diesel Engine&r to silence it"
	quest.5F699CBFE79E637E.quest_desc: [
		"&eLeather Strap&r. Complete it by obtaining &6Leather Strap&r."
		""
		"Opens after Ion Thrusters (Electric Flight) Simply Jetpacks 2 jetpacks run on Forge Energy (FE), the same power Create Crafts & Additions makes. A new jetpack is empty: charge it before you jump. Like Create Stuff 'n Additions' jetpacks, they're built in a Mechanical Crafter, and each tier is an upgrade of the one before. An upgrade starts with an empty battery. Hold Jump to fly. The engine and hover-mode keys are under Options > Controls.."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.5F699CBFE79E637E.quest_subtitle: "Every jetpack is built around one: leather and iron ingots."
	quest.5F699CBFE79E637E.title: "&bLeather Strap"
	quest.5F6C37E2546789BB.quest_desc: [
		"Press three coal (or charcoal) with clay and wheat in a basin. You get a stack of briquettes that outlast the raw fuel, and the clay often comes back."
	]
	quest.5F6C37E2546789BB.quest_subtitle: "Can be used as an efficient source of fuel"
	quest.5F6C37E2546789BB.title: "&8Coal Briquettes&r and&r &8Charcoal Briquettes "
	quest.601277C2004705B2.quest_desc: [
		"Bring water breathing; an Ars charm works. The Leviathan hunts the ruins."
		""
		"You need &6Sunken City&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.601277C2004705B2.quest_subtitle: "A drowned city on the floor of a deep ocean. Bring water breathing."
	quest.601277C2004705B2.title: "&6Sunken City"
	quest.601860A2654A4095.quest_desc: [
		"To make our &9Echo items&r we will need to upgrade them from Netherite items through the usage of a smithing table and an &3Echo Upgrade Smithing Template"
	]
	quest.601860A2654A4095.quest_subtitle: "To make our &9Echo items&r we will need to upgrade them from Netherite items through the usage of a smithing table and an &3Echo Upgrade ..."
	quest.601860A2654A4095.title: "&3Smithing Template"
	quest.603AAE60ABAEB20E.quest_desc: [
		"&eWelcome to Deep Dark&r. Complete it by obtaining &6Welcome to Deep Dark&r."
		""
		"Opens after Andesite, the Foundation (Andesite Age)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.603AAE60ABAEB20E.quest_subtitle: "Deep Dark is an addon for Create that introduces new end-game content inspired by the Deep Dark biome, featuring rare items, resources, and powerful gear to craft using Create’s mechanics!"
	quest.603AAE60ABAEB20E.title: "Welcome to Deep Dark"
	quest.60414BECF9CD697A.quest_desc: [
		"Burns furnace fuel into Source and dumps it into nearby jars. The simplest starter generator; crop, animal and potion links come after."
	]
	quest.60414BECF9CD697A.quest_subtitle: "Makes Source by burning fuel. The easiest Source to start with."
	quest.60414BECF9CD697A.title: "&6Volcanic Sourcelink"
	quest.6057AD45BCBCD504.quest_desc: [
		"A hotter, stronger source than the basic Optical Source. Needs both an Optical Device and a Polarizing Filter."
	]
	quest.6057AD45BCBCD504.quest_subtitle: "Much stronger than the normal &5Optical Device"
	quest.6057AD45BCBCD504.title: "&cThermal Optical Source"
	quest.606349BB488D2422.quest_desc: [
		"Now that you have the necessary materials we can start by crafting ourselves a couple of &bHypertube Block&r after you put down one of them you can &aright click it while having another one in your hand&r to extend the tube to wherever you please as long as the angle isn't too steep and that there aren't any blocks in between"
		""
		"Now that we have our tunnel we will need to connect a &bHypertube Entrance Block&r that is connected to a powered grid via a cogwheel to let ourself enter the tunnel, keep in mind though the speed at which you enter the tunnel is dependent on the &6RPM (Rounds per minute)&r that the cogwheel spins at so if you wan't to go &9sonic-speed&r you will need to crank that speed up to as high as it goes"
		""
		"And lastly we have the &bHypertube Accelerator Block&r which speeds up entities that passes through the block inside the tunnel to &ahigh speeds&r which increases it's speed depending on how much &6RPM&r it spins at"
		""
		"You can also right-click the block and put it on &aBrake Mode&r which will instead slow down entities, but who even wants to brake in the first place"
	]
	quest.606349BB488D2422.quest_subtitle: "Now that you have the necessary materials we can start by crafting ourselves a couple of &bHypertube Block&r after you put down one of th..."
	quest.606349BB488D2422.title: "&b&lThe Hypertube"
	quest.6063CF361CA2DAF7.quest_desc: [
		"Brick & Mortar adds coloured bricks and tiles fired in a Kiln. Fire a clay ball in the Kiln to get a Tan Brick."
		"Some firings require open doors."
	]
	quest.6063CF361CA2DAF7.quest_subtitle: "Fire clay in a Kiln"
	quest.6063CF361CA2DAF7.title: "&eBrick & Mortar"
	quest.606567FF7D0B81E1.quest_desc: [
		"Two marshmallows and a stick. Hold it over a campfire or run it through a smoker to caramelize it."
	]
	quest.606567FF7D0B81E1.title: "Marshmallow on a Stick"
	quest.606567FF7D0B81E1.quest_subtitle: "Two marshmallows and a stick. Hold it over a campfire or run it through a smoker to caramelize it."
	quest.60936D55394B8517.quest_desc: [
		"Power the &eMechanical Oven&r and use it with cake moulds. Cog, electron-tube and lava-tank cakes all bake here."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.60936D55394B8517.quest_subtitle: "From &eMechanical Confection&r: bake layer cakes in a mould."
	quest.60936D55394B8517.title: "&6Thermal Confection Oven"
	quest.60959BD560D5C3F6.quest_desc: [
		"Run gingerdough through a &eMechanical Press&r. One press, one little man."
		"That's the pressed cousin of baked gingerbread — same dough, different machine."
	]
	quest.60959BD560D5C3F6.title: "Gingerbread Man"
	quest.60959BD560D5C3F6.quest_subtitle: "Run gingerdough through a &eMechanical Press&r. One press, one little man."
	quest.6174776659022D6B.quest_desc: [
		"The book that ships with Create: Garnished. Craft the &eGarnishment Guide&r and keep it handy."
		"It explains the nuts, sweets and fan processing the mod adds."
	]
	quest.6174776659022D6B.quest_subtitle: "The book that ships with Create: Garnished. Craft the &eGarnishment Guide&r and keep it handy."
	quest.6174776659022D6B.title: "&eGarnishment Guide"
	quest.61C903CC178F7F32.quest_desc: [
		"It's crafted from a book and a sourceberry, or found in chests. Everything below is explained in it."
	]
	quest.61C903CC178F7F32.quest_subtitle: "Ars Nouveau is a magic mod where you design your own spells. This book is its complete guide."
	quest.61C903CC178F7F32.title: "&dThe Tattered Tome"
	quest.622B5B4CD721D8B8.quest_desc: [
		"Bounces the beam 90 degrees. Rotate the mirror to pick the outgoing face so you can snake light around corners."
	]
	quest.622B5B4CD721D8B8.quest_subtitle: "Propogate the beam perpendicularly and &arotate the mirror&r to choose where to propogate"
	quest.622B5B4CD721D8B8.title: "&6Encased Mirror"
	quest.6258271B8132C384.quest_desc: [
		"Build a portal and step through. Cataclysm's Soul Black Smith and Burning Arena generate here, in terrain nobody has visited yet."
	]
	quest.6258271B8132C384.quest_subtitle: "Build a portal and step through. Cataclysm's Soul Black Smith and Burning Arena generate here, in terrain nobody has visited yet."
	quest.6258271B8132C384.title: "&4The Nether"
	quest.6286DD80F462B1A9.quest_desc: [
		"Macaw's Bridges adds wooden bridges and matching bridge stairs. Start with an Oak Bridge."
		""
		"You need &6Macaw's Bridges&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.6286DD80F462B1A9.quest_subtitle: "Walkways over gaps"
	quest.6286DD80F462B1A9.title: "&eMacaw's Bridges"
	quest.628B4647AA410A19.quest_desc: [
		"A stationary &eMechanical Saw&r strips logs and cuts blocks; glued onto a contraption it fells whole trees. You will want one on the belt for sequenced recipes later."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.628B4647AA410A19.title: "Mechanical Saw"
	quest.628B4647AA410A19.quest_subtitle: "&6Mechanical Saws&r can fell trees or allow contraptions to fell trees, as well as perform recipes like cutting blocks or stripping &aLogs&r"
	quest.62A83DCB7F9DE4E2.quest_desc: [
		"An IDAS maze. Mark your path; getting lost is the point."
		""
		"You need &6Labyrinth&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.62A83DCB7F9DE4E2.quest_subtitle: "An IDAS maze. Mark your path; getting lost is the point."
	quest.62A83DCB7F9DE4E2.title: "&8Labyrinth"
	quest.62BC1FF3A591FAAF.quest_desc: [
		"Metal or wooden walkway steps. Power them with rotation for moving walkways and escalators through the factory."
	]
	quest.62BC1FF3A591FAAF.quest_subtitle: "From &eEscalated&r: moving walkways and escalators powered by rotation."
	quest.62BC1FF3A591FAAF.title: "&7Escalators"
	quest.62FFF70F855229CC.quest_desc: [
		"A lit ring can fuel hard-light constructs: engines, blaze burners, boilers and water wheels on the construct run without fuel or water."
		""
		"Tick this when you have flown a Create contraption off a ring construct. You need a Central Power Battery to keep the ring fed for that kind of work."
	]
	quest.62FFF70F855229CC.quest_subtitle: "Create machines lit by a ring"
	quest.62FFF70F855229CC.title: "&aHard-Light Engineering"
	quest.632D538462006E6D.quest_desc: [
		"Craft a &eSemaphore&r once you have brass and an electron tube, then sit it on a pole next to a working &eTrain Signal&r."
		"The arm copies that signal so you can read it from down the line. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.632D538462006E6D.quest_subtitle: "Place on a pole next to a train signal and the arm shows that signal's state. It's made with an electron tube, so you'll need brass first."
	quest.632D538462006E6D.title: "&eSemaphores"
	quest.634B2ED978962892.quest_desc: [
		"The pumpjack's product. Distill it — heated for a smaller split, superheated for more — into diesel and gasoline."
	]
	quest.634B2ED978962892.title: "Crude Oil Bucket"
	quest.634B2ED978962892.quest_subtitle: "The pumpjack's product. Distill it — heated for a smaller split, superheated for more — into diesel and gasoline."
	quest.639561EA12D5FADC.quest_desc: [
		"Set the output you want, then feed it analog redstone and it remaps that strength to the configured signal."
		"Handy when a sensor's 0–15 range is the wrong shape for a throttle or tilt adapter."
	]
	quest.639561EA12D5FADC.title: "Redstone Converter"
	quest.639561EA12D5FADC.quest_subtitle: "A &bRedstone Converter&r converts &credstone&r signal strength into a configurable &credstone&r output signal"
	quest.63ABA4CA92CAA675.quest_desc: [
		"The everyday all-terrain wheel: four rubber sheets around a shaft."
		"Sits on the same mount as the others. Use this size until you need clearance or a heavier footprint."
	]
	quest.63ABA4CA92CAA675.title: "Tire"
	quest.63ABA4CA92CAA675.quest_subtitle: "The everyday all-terrain wheel: four rubber sheets around a shaft."
	quest.63AFEFF942ED2C1B.quest_desc: [
		"A huge netherite golem. Fight up close; it caps damage and ignores shots from far away. It drops the Infernal Forge and a Monstrous Horn."
	]
	quest.63AFEFF942ED2C1B.quest_subtitle: "A huge netherite golem. Fight up close; it caps damage and ignores shots from far away. It drops the Infernal Forge and a Monstrous Horn."
	quest.63AFEFF942ED2C1B.title: "&c&lNetherite Monstrosity"
	quest.63C987F952F77C0E.quest_desc: [
		"First flight. The battery starts empty, so park it under a &eTesla Coil&r before you jump."
		"Hold Jump to fly. Engine and hover keys live under Options, Controls. Gold is the next hull."
	]
	quest.63C987F952F77C0E.quest_subtitle: "Built in a Mechanical Crafter: iron sheets, cogwheels, encased fans, an electric motor, copper wire and a capacitor around a leather strap. Slow, but it flies."
	quest.63C987F952F77C0E.title: "&7Iron Jetpack"
	quest.63D62E2A3E5FABD4.quest_desc: [
		"A whisk, a coupling, a Heat Engine, a cog, and zinc. Bring these back and the next quest crafts the grappling hook."
	]
	quest.63D62E2A3E5FABD4.quest_subtitle: "A whisk, a coupling, a Heat Engine, a cog, and zinc. Bring these back and the next quest crafts the grappling hook."
	quest.63D62E2A3E5FABD4.title: "Materials for the &dGrapplin Whisk"
	quest.64523E32C0CAD9C5.quest_desc: [
		"The &eThreshold Switch&r watches how full a chest, vault, or tank is and turns redstone on at the high mark, off at the low mark. That is your pump shutoff."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.64523E32C0CAD9C5.title: "Stockpile Switch"
	quest.64523E32C0CAD9C5.quest_subtitle: "A &cThreshold Switch&r can monitor the fill levels of inventories and tanks"
	quest.64D485944845F231.quest_desc: [
		"Heat it from below and it turns that heat into shaft rotation. No heat, no RPM."
		"The Solid and Liquid Burners next door are the heaters it wants. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.64D485944845F231.title: "Stirling Engine"
	quest.64D485944845F231.quest_subtitle: "Heat it from below and it turns that heat into shaft rotation. No heat, no RPM."
	quest.64D5A9E80FBEDC8C.quest_desc: [
		"Set a &eCampfire&r in the fan's blast so passing items smoke. Keep the soul, water, and lava setups next to it — each one changes the recipe table."
	]
	quest.64D5A9E80FBEDC8C.title: "Campfire"
	quest.64D5A9E80FBEDC8C.quest_subtitle: "When placed in front of the &6Encased Fan&r, a &6Campfire&r allows it to smoke items"
	quest.64F520643E1E82C9.quest_desc: [
		"Couples only above a speed you set. Leave a vehicle engine spinning and the wheels only bite once RPM is up."
	]
	quest.64F520643E1E82C9.quest_subtitle: "A clutch that is only coupled if the input RPM is faster than a configurable threshold. Useful for vehicles when you have engines always on but don't want to always be moving."
	quest.64F520643E1E82C9.title: "&6Centrifugal Clutch"
	quest.656260035FD165EA.quest_desc: [
		"Sequenced assembly on a &eSturdy Sheet&r: lava, tetrachloride and water, with presses in between. Moon, Mars and Venus ores smelt straight into ingots once you land."
	]
	quest.656260035FD165EA.quest_subtitle: "A sturdy sheet, assembled with lava, titanium tetrachloride and water: your first titanium. Once you reach the Moon or Mars you can mine and smelt it directly."
	quest.656260035FD165EA.title: "&fTitanium"
	quest.6582B638965D114F.quest_desc: [
		"Pair two &eRedstone Links&r on the same frequency and a signal jumps the gap. Set one as transmitter and one as receiver so you are not running dust across the base."
	]
	quest.6582B638965D114F.title: "Redstone Link"
	quest.6582B638965D114F.quest_subtitle: "Lets you transfer a redstone signal wirelessly within a range using a &cRedstone Link&r"
	quest.65D9E2BA22CC2DBC.quest_desc: [
		"Sequenced assembly on Andesite Alloy: copper sheets, a lava spout, and a press. Goes into the &eOptical Receptor&r."
	]
	quest.65D9E2BA22CC2DBC.quest_subtitle: "Sequenced assembly on Andesite Alloy: copper sheets, a lava spout, and a press. Goes into the &eOptical Receptor&r."
	quest.65D9E2BA22CC2DBC.title: "&6Copper Coil"
	quest.65E11DFFD2125089.quest_desc: [
		"Heat a mixer that is combining &6Copper&r and &7Zinc&r to make &eBrass&r."
		""
		"Fill an &6Empty Blaze Burner&r by right-clicking a &6Blaze Spawner&r or a &6Blaze&r, then park it under the basin."
	]
	quest.65E11DFFD2125089.quest_subtitle: "Copper and zinc only become brass when the fire is honest."
	quest.65E11DFFD2125089.title: "&6Kindle the Mixer"
	quest.66760C6B0C1DDDD0.quest_desc: [
		"A &eTrack Buffer&r goes on the last piece of rail so a runaway train hits a bumper, not air."
		"Glue a &eTrain Buffer&r onto the front of the locomotive if you want the crash to look the part."
	]
	quest.66760C6B0C1DDDD0.quest_subtitle: "A &eTrack Buffer&r goes on the last piece of rail so a runaway train hits a bumper, not air."
	quest.66760C6B0C1DDDD0.title: "&3Track and Train Buffers"
	quest.66C2E7174AD6111D.quest_desc: [
		"Andesite, iron, brass, and sturdy crates — compact storage dressed in your casings. Craft them from the casings and vaults you just gathered."
	]
	quest.66C2E7174AD6111D.quest_subtitle: "Andesite, iron, brass, and sturdy crates — compact storage dressed in your casings. Craft them from the casings and vaults you just gathe..."
	quest.66C2E7174AD6111D.title: "&3Crates"
	quest.66E5A95A785EE428.quest_desc: [
		"An Item Vault that stands up instead of lying down. Same capacity, better footprint in a tall room."
	]
	quest.66E5A95A785EE428.quest_subtitle: "Item vaults that stand upright, and shipping containers that hold a vault's worth."
	quest.66E5A95A785EE428.title: "&7Vertical Vaults"
	quest.66F79A7EDE20FDE5.quest_desc: [
		"Grab redstone and industrial plating. The magnet, inductor, and accumulator in this branch all want a redstone supply."
		"The magnet itself crafts from redstone, a copper sheet, and industrial iron."
	]
	quest.66F79A7EDE20FDE5.title: "Redstone"
	quest.66F79A7EDE20FDE5.quest_subtitle: "Grab redstone and industrial plating. The magnet, inductor, and accumulator in this branch all want a redstone supply."
	quest.66FCECE2CEA842D9.quest_desc: [
		"Right-click a Fluid Hatch with a &eBlock of Experience&r. Buckets and bottles can then tap the tank like a fluid hatch, but for liquid XP."
	]
	quest.66FCECE2CEA842D9.quest_subtitle: "Used for interacting with fluid tank directly with buckets and other player items."
	quest.66FCECE2CEA842D9.title: "&aCraft Expericence Hatch"
	quest.670EE1E72CCE9C2B.quest_desc: [
		"Park it where analog redstone needs a cockpit control: engine speed, burner heat, or thruster throttle."
		"Pair it with the inductor if you want the output to ramp instead of jumping. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.670EE1E72CCE9C2B.title: "Throttle Lever"
	quest.670EE1E72CCE9C2B.quest_subtitle: "A &6Throttle Lever&r allows precise control over its analog power output"
	quest.67E511B88ADFC5BC.quest_desc: [
		"Any potion counts. Feed it to the sprinkler and entities standing under the spray get that effect."
		"A drain can empty bottles into pipes if you'd rather not bucket the fluid by hand."
	]
	quest.67E511B88ADFC5BC.quest_subtitle: "Any potion counts. Feed it to the sprinkler and entities standing under the spray get that effect."
	quest.67E511B88ADFC5BC.title: "&dPotions"
	quest.68567D80BF886B45.quest_desc: [
		"Fill in stops, waits and conditions, then give the &eSchedule&r to whoever is sitting at the controls."
		"A seated mob or &eBlaze Burner&r will drive the route on its own. Name your stations first or the entries won't match."
	]
	quest.68567D80BF886B45.quest_subtitle: "A &6Schedule&r lets you schedule trains so that mobs or &6Blaze Burners&r can drive them"
	quest.68567D80BF886B45.title: "&6Train Schedule&r"
	quest.6860003BC3811B49.quest_desc: [
		"Craft Plane Parts from sticks, cardboard and a firework rocket, then deploy them onto a package (a Deployer can do this). Launch with an ejector, or right-click while holding the plane."
		"Planes fly to the player whose name matches the package address, skipping unloaded chunks and crossing dimensions. They can also land on a Depot whose sign matches, if that chunk is loaded. Hold &eW&r over the parts in EMI."
	]
	quest.6860003BC3811B49.quest_subtitle: "Wings on a package"
	quest.6860003BC3811B49.title: "&eCardboard Plane"
	quest.686C1705E2FEC061.quest_desc: [
		"Glue a &eFishing Net&r onto a moving contraption that passes through water."
		"It fishes as it goes and scoops up small aquatic mobs. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.686C1705E2FEC061.quest_subtitle: "The Fishing Net is a contraption component designed to catch small aquatic animals while also allowing fishing at the same time."
	quest.686C1705E2FEC061.title: "&eCraft &bFishing Net"
	quest.6892533F1AE22174.quest_desc: [
		"An End construct with a tight range cap, so stay in its face. It drops the Gauntlet of Guard."
	]
	quest.6892533F1AE22174.quest_subtitle: "An End construct with a tight range cap, so stay in its face. It drops the Gauntlet of Guard."
	quest.6892533F1AE22174.title: "&c&lEnder Guardian"
	quest.68AC478385F4DE6C.quest_desc: [
		"Congratulations! You have obtained &bSuper Experience&r, which can be used on the &6Blaze Forger&r or &6Enchanter&r to create even more powerful enchants."
	]
	quest.68AC478385F4DE6C.quest_subtitle: "Super-heated experience blocks"
	quest.68AC478385F4DE6C.title: "&bObtain Super Experience Block"
	quest.68C493A02440AF5A.quest_desc: [
		"Upgrade Arcanist pieces with 2 essences, a Brass Sheet and a Precision Mechanism. 20 armour and 8 toughness. Heavy armour waits on a Mark of Mastery."
	]
	quest.68C493A02440AF5A.quest_subtitle: "Upgrade Arcanist armour: 2 essences, a Brass Sheet and a Precision Mechanism. 20 armour and 8 toughness for the set."
	quest.68C493A02440AF5A.title: "&6Medium Elemental Armour"
	quest.68D9DC0A767F750F.quest_desc: [
		"Kill a Coconut Crab. Tropical Stew is crafted shapeless from a Coconut Slice and Crab Meat."
	]
	quest.68D9DC0A767F750F.quest_subtitle: "The beach has claws"
	quest.68D9DC0A767F750F.title: "&cCoconut Crab"
	quest.691B8A20556D43BB.quest_desc: [
		"Craft autocannon cartridges and an ammo container to feed the gun. Tracer tips make the rounds visible if you want to walk the fire."
	]
	quest.691B8A20556D43BB.quest_subtitle: "Craft autocannon cartridges and an ammo container to feed the gun. Tracer tips make the rounds visible if you want to walk the fire."
	quest.691B8A20556D43BB.title: "&7Autocannon Ammo"
	quest.6933441D38037E5A.quest_desc: [
		"Put a &eBlaze Burner&r under the basin, heat it, and Farmer's Delight cooking-pot meals mix themselves."
		"That's your automated kitchen stove. Next, bake a sweet berry cake with it."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.6933441D38037E5A.quest_subtitle: "All recipes from &dFarmer's Delight&r requiring the &dCooking Pot&r are added as heated mixing recipes"
	quest.6933441D38037E5A.title: "&eUse &6Mechanical Mixer&r &eto cook food"
	quest.6934E2BC749EB926.quest_desc: [
		"Same alloy you already live on. Optical coils all start as sequenced assembly on an Andesite Alloy blank."
	]
	quest.6934E2BC749EB926.quest_subtitle: "Surely you are familiar with it by now"
	quest.6934E2BC749EB926.title: "&7Andesite Alloy"
	quest.69519BFDAAA790DE.quest_desc: [
		"Heat a &eBasin&r from below, mix on top, and pump the fluid into a tank. You're brewing at industrial scale."
		"Hold &eW&r over the &eMechanical Mixer&r in EMI to see its Ponder."
	]
	quest.69519BFDAAA790DE.quest_subtitle: "Set up a Blaze Burner, Mechanical Mixer, and Basin to create potions. Place a Mechanical Pipe near the Basin to drain the potions into a Fluid Tank."
	quest.69519BFDAAA790DE.title: "&aSet up &6Mechanical Mixer &awith a &6Blaze burner"
	quest.697A75979171E953.quest_desc: [
		"Stock &eAndesite Alloy&r, &eAndesite Casing&r, iron, and brass. Almost every Simulated block starts from this pile."
		"With these in a chest you can branch into the assembler, the engine, and the control gadgets."
	]
	quest.697A75979171E953.quest_subtitle: "Stock &eAndesite Alloy&r, &eAndesite Casing&r, iron, and brass. Almost every Simulated block starts from this pile."
	quest.697A75979171E953.title: "Materials"
	quest.6980D94CDC9657E1.quest_desc: [
		"Bake any one of the three novelty cakes and take a slice."
		"That's the dessert half of Open a Café."
	]
	quest.6980D94CDC9657E1.quest_subtitle: "A cake shaped like a cog. Or an electron tube. Or a lava tank."
	quest.6980D94CDC9657E1.title: "&6Cogwheel Cake"
	quest.6997BE357A2624B1.quest_desc: [
		"Wear &eEngineer's Goggles&r on your head or in a Curios slot. Later they also overlay boiler heat and tank fill, not just stress."
		"Put them on before you start debugging stalled Andesite machines."
	]
	quest.6997BE357A2624B1.title: "Goggles"
	quest.6997BE357A2624B1.quest_subtitle: "Essential for anyone working with &6&lCreate&r. &6Engineer's Goggles&r allow you to see more information about blocks, such as stress impact or contents"
	quest.69A89636F2F4FCB2.quest_desc: [
		"Maybe the most tedious but also definitely the funnest &bthe Hypertube&r allows you to crawl inside the hypertunnel and zoom to the end of the tunnel at lightning speed &ano matter the shape of the tunnel&r "
		""
		"Come back once you've got all the ingredients and follow the next quest in line to build your very own &bHypertube&r"
	]
	quest.69A89636F2F4FCB2.quest_subtitle: "Maybe the most tedious but also definitely the funnest &bthe Hypertube&r allows you to crawl inside the hypertunnel and zoom to the end o..."
	quest.69A89636F2F4FCB2.title: "Materials for &l&bthe Hypertube"
	quest.69E94ABCEF133B0E.quest_desc: [
		"Collects oxygen or carbon from thin air when the planet has any. Pair it with the sealer so a Moon or Mars base does not depend on tanks shipped from Earth."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.69E94ABCEF133B0E.quest_subtitle: "Collects oxygen from thin atmospheres."
	quest.69E94ABCEF133B0E.title: "&bAtmospheric Concentrator"
	quest.6A281C3587EDE4E8.quest_desc: [
		"Craft four Brass Catwalks from Brass Bars and four brass plates, or stonecut four from a brass ingot."
		"Catwalk stairs craft from the catwalk. Bars, catwalk, railing and stairs are the brass walkway set."
	]
	quest.6A281C3587EDE4E8.quest_subtitle: "Plates around bars"
	quest.6A281C3587EDE4E8.title: "&eBrass Catwalk"
	quest.6A4CB4700F0082C6.quest_desc: [
		"The tutorial is now &afinished&r."
		""
		"To view the rest of the quests, put your cursor to the left of the screen and expand the &6Quest Groups&r."
		""
		"Feel free to join our &bDiscord &rfor any other questions you may have: https://discord.gg/5mJnYNMv6Q"
	]
	quest.6A4CB4700F0082C6.title: "The tutorial is now finished"
	quest.6A4CB4700F0082C6.quest_subtitle: "Read my description!"
	quest.6A52090D6BC064D7.quest_desc: [
		"This book is a map, not a leash. Follow it, wander off it, or ignore whole chapters — the world still runs."
		""
		"Click the checkmark under &9Tasks&r, claim the reward, and the next tutorial steps will appear."
		""
		"If nothing new shows up, rejoin the world. Save the bread until this short tutorial is done."
	]
	quest.6A52090D6BC064D7.quest_subtitle: "A factory, a forge of light, and the open sky — pick a road."
	quest.6A52090D6BC064D7.title: "Welcome to &b&lThe Illustrious MFPack&r!"
	quest.6A7CDF204DB01A20.quest_desc: [
		"Mount a powered &eMechanical Roller&r on the train and put the paving block you want in its filter."
		"A &eMechanical Plough&r out front shoves leftover blocks aside while you lay track from the cab."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.6A7CDF204DB01A20.quest_subtitle: "A &6Mechanical Roller&r lets you clear blocks in front and pave with desired blocks underneath the tracks while riding a train"
	quest.6A7CDF204DB01A20.title: "&6Mechanical Roller"
	quest.6A8B75454322572D.quest_desc: [
		"Rechiseled restyles vanilla blocks into beams, bricks, tiles and more. Craft a Chisel from iron and a stick."
		"In the chiseling screen you can turn connected textures on or off."
	]
	quest.6A8B75454322572D.quest_subtitle: "Connected textures on a chisel"
	quest.6A8B75454322572D.title: "&eRechiseled"
	quest.6ABABF2B012DB63F.quest_desc: [
		"Bulk fluid storage, and the walls of your distillery. Controller on a tank, heat below, crude in, diesel and gasoline out."
	]
	quest.6ABABF2B012DB63F.title: "Fluid Tank"
	quest.6ABABF2B012DB63F.quest_subtitle: "A &6Fluid Tank&r is the main block used for bulk fluid storage"
	quest.6AE9AF77572C3F74.quest_desc: [
		"Hold &eSuper Glue&r and drag across blocks to mark them as one piece. Anything glued (or grabbed by a chassis) moves together on a bearing, piston, or cart."
	]
	quest.6AE9AF77572C3F74.title: "Super Glue"
	quest.6AE9AF77572C3F74.quest_subtitle: "As the name implies, &aSuper Glue&r allows you to glue blocks together. Particularly useful when making contraptions"
	quest.6AFDA474C97CA327.quest_desc: [
		"In order to make a train, you're going to need at least:"
		""
		"- 1 &6Train Casing&r"
		"- 1 &6Train Station&r"
		"- Enough &6Train Tracks&r to make your railroad"
		""
		"In order to see how you assemble a train, &b&lponder&r the &6Train Station&r"
	]
	quest.6AFDA474C97CA327.quest_subtitle: "In order to make a train, you're going to need at least:"
	quest.6AFDA474C97CA327.title: "&bAssemble a train"
	quest.6B0E9E7992D52704.quest_desc: [
		"Smelt raw copper, or crush it first if you want the extra bits."
		""
		"Ingots unlock casings, fluid pipes, diving gear, and the rest of this chapter — still optional, still yours to rearrange."
	]
	quest.6B0E9E7992D52704.quest_subtitle: "Fluids, fans, and the first taste of pressure."
	quest.6B0E9E7992D52704.title: "&cCopper Vein"
	quest.6B22DEF8E5E314EB.quest_desc: [
		"Create Kitchen's heated Mixer, Create: Food cheese, Miner's Delight cave soup, and a Create: Garnished dish on one line."
		""
		"Tick this when a meal left the automatics without a cooking pot in your hand."
	]
	quest.6B22DEF8E5E314EB.quest_subtitle: "Dairy, cave soup, garnished plate"
	quest.6B22DEF8E5E314EB.title: "&aIndustrial Kitchen"
	quest.6B47359B7540AD2B.quest_desc: [
		"Stock TACZ ammo recipes live here. Create Armorer ammo is casing, primer and powder on a Create line instead; skip this bench if you are staying on that path."
	]
	quest.6B47359B7540AD2B.quest_subtitle: "Optional. Stock TACZ ammo recipes use this bench (Create Armorer ammo uses Create instead)."
	quest.6B47359B7540AD2B.title: "&7Ammo Workbench"
	quest.6B686D74C31D65EC.quest_desc: [
		"Shapeless-craft a Throwable Rope Connector from a Rope Coupling and a Rope Connector."
		"Throw it at a valid Simulated anchor. It will complain if the target is too far, there is no anchor, or Simulated integration is missing."
	]
	quest.6B686D74C31D65EC.quest_subtitle: "Toss a Simulated coupling"
	quest.6B686D74C31D65EC.title: "&eThrowable Rope Connector"
	quest.6B8F5271E2ABDB05.quest_desc: [
		"Flashjack, Firenando and Siren charms, summoned like Starbuncles. New helpers from Ars Elemental once you have a lesser focus."
	]
	quest.6B8F5271E2ABDB05.quest_subtitle: "Flashjack, Firenando and Siren: new helpers and familiars."
	quest.6B8F5271E2ABDB05.title: "&6Elemental Familiars"
	quest.6B9D82DE26A0CC56.quest_desc: [
		"Heated mix of sugar, cocoa butter, two cocoa beans and milk, then compact the fluid in a press and basin."
		"Spout that chocolate over marshmallows for the glazed variants later."
	]
	quest.6B9D82DE26A0CC56.quest_subtitle: "Heated mix of sugar, cocoa butter, two cocoa beans and milk, then compact the fluid in a press and basin."
	quest.6B9D82DE26A0CC56.title: "&6Bar of Dark Chocolate"
	quest.6BBA95BF47D9B2AC.quest_desc: [
		"Feed ingots into a spinning &eRolling Mill&r to draw them into rods and wires — the start of Create Crafts & Additions power."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.6BBA95BF47D9B2AC.title: "Rolling Mill"
	quest.6BBA95BF47D9B2AC.quest_subtitle: "A &6Rolling Mill&r is for milling raw materials into useful components, like rods and wires"
	quest.6BC0D978E293515F.quest_desc: [
		"Any colour works. Feed furnace fuel, or a &eBlaze Cake&r if you want it superheated for extra RPM and SU."
		"This is the on-board motor for Simulated ships, Off-Road chassis, and Aeronautics frames. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.6BC0D978E293515F.quest_subtitle: "Insert any furnace fuel to get the engine running. If that's not enough power for you, feed it some &6Blaze Cakes&r to superheat it and double its &6RPM&r and &6SU&r"
	quest.6BC0D978E293515F.title: "Engine"
	quest.6BD99B734B74E3EC.quest_desc: [
		"Cyan top head and orange bottom head, each driving its own assembly. That is how you flap two control surfaces from one bearing."
		"Put it after the servo bearing once you need ailerons rather than a single steered nozzle. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.6BD99B734B74E3EC.quest_subtitle: "Cyan top head and orange bottom head, each driving its own assembly. That is how you flap two control surfaces from one bearing."
	quest.6BD99B734B74E3EC.title: "Craft Aileron Bearing"
	quest.6BF926405F2D9D26.quest_desc: [
		"Spout liquid dark chocolate onto a marshmallow."
		"Same spout, different chocolate, for the ruby glaze next."
	]
	quest.6BF926405F2D9D26.quest_subtitle: "Spout liquid dark chocolate onto a marshmallow."
	quest.6BF926405F2D9D26.title: "&6Dark Chocolate Glazed Marshmallow"
	quest.6C3F8B6CBEB3E69F.quest_desc: [
		"Craft a Rivet from an Iron Sheet and an Iron Nugget."
		"It lets blocks sit at any angle or offset from the grid. During placement you can step 15 degrees, hold for free 360 degree rotation, or disable position snapping."
	]
	quest.6C3F8B6CBEB3E69F.quest_subtitle: "Place off the grid"
	quest.6C3F8B6CBEB3E69F.title: "&eRivet"
	quest.6CD9B818ACEC1EF6.quest_desc: [
		"All four shafts spin the same way, unlike Create's gearbox that reverses some faces. There's a vertical version for upright shafts."
	]
	quest.6CD9B818ACEC1EF6.quest_subtitle: "A gearbox with all 4 sides spinning in the same direction."
	quest.6CD9B818ACEC1EF6.title: "&6The Parallel Gearboxes"
	quest.6CDBE9BD511846ED.quest_desc: [
		"Upgrade Sorcerer pieces at the apparatus with 2 essences, Andesite Alloy and an Iron Sheet. 15 armour and a little toughness for the set. Medium tier uses Arcanist gear next."
	]
	quest.6CDBE9BD511846ED.quest_subtitle: "Upgrade Sorcerer armour at the Enchanting Apparatus: 2 essences, Andesite Alloy and an Iron Sheet. 15 armour for the set."
	quest.6CDBE9BD511846ED.title: "&eLight Elemental Armour"
	quest.6D8C2C446FB24B89.quest_desc: [
		"The coil needs FE itself: feed it from an Alternator or Accumulators (see the Brass Age chapter)."
		"Careful: a powered Tesla Coil also zaps players and mobs that stand near it."
	]
	quest.6D8C2C446FB24B89.quest_subtitle: "Drop the jetpack under a Tesla Coil, or on a depot or belt beneath it, and the coil fills it with FE."
	quest.6D8C2C446FB24B89.title: "&eCharging Up"
	quest.6DDA5CB8C103CCF4.quest_desc: [
		"Craft your first gun, run assembled ammo through the workbench, and keep Create Big Cannons' automatic loading fed from the same factory floor."
		""
		"Tick this when small arms and a cannon share one ammunition line."
	]
	quest.6DDA5CB8C103CCF4.quest_subtitle: "Guns, ammo, autocannon"
	quest.6DDA5CB8C103CCF4.title: "&cArmory"
	quest.6DDC8E408BE84968.quest_desc: [
		"A &eNixie Tube&r shows a short number or a few characters. Pair it with a Display Link on an elevator contact if you want a floor readout."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.6DDC8E408BE84968.title: "Nixie Tube"
	quest.6DDC8E408BE84968.quest_subtitle: "A &6Nixie Tube&r can display text or numbers. This would be useful for making elevators too."
	quest.6DE5C143971CCDC8.quest_desc: [
		"An IDAS haunted house. Bring light and a weapon; it is a step up from the castle."
		""
		"You need &6Haunted Manor&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.6DE5C143971CCDC8.quest_subtitle: "An IDAS haunted house. Bring light and a weapon; it is a step up from the castle."
	quest.6DE5C143971CCDC8.title: "&8Haunted Manor"
	quest.6DF1388101A98433.quest_desc: [
		"An iron sheet, deployed with polished amethyst, copper and gold, then engraved. You will want a pile for the &eTargeting Computer&r, Rocket Station and later machines."
	]
	quest.6DF1388101A98433.quest_subtitle: "Iron sheets, assembled and engraved."
	quest.6DF1388101A98433.title: "&dCircuits"
	quest.6EC126428FBB5E9D.quest_desc: [
		"Macaw's Windows adds window bases, four-pane and half-pane windows."
		"Right-click a window with the Window Hammer to change its shape."
	]
	quest.6EC126428FBB5E9D.quest_subtitle: "Panes, bars and a hammer"
	quest.6EC126428FBB5E9D.title: "&eMacaw's Windows"
	quest.6F5A9597B7259915.quest_desc: [
		"Mine platinum ore or deepslate platinum, then smelt or blast it. Crushing the raw ore works too."
		"Sheets, casings, tanks, cables, the converter, and the vector thruster all start from this ingot."
	]
	quest.6F5A9597B7259915.quest_subtitle: "Mine platinum ore or deepslate platinum, then smelt or blast it. Crushing the raw ore works too."
	quest.6F5A9597B7259915.title: "Platinum Ingot"
	quest.6F5D431065508C0B.quest_desc: [
		"Focus a beam onto a recipe or a meal. Faster, cheaper Optical Devices than full sequenced assembly — and a way to cook."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.6F5D431065508C0B.quest_subtitle: "Allows you to craft your &dOptical&r devices or &acook food&r faster and cheaper"
	quest.6F5D431065508C0B.title: "&6Beam Focuser"
	quest.6F761CEF7CF87194.quest_desc: [
		"A sea serpent with a long range cap, so get close anyway. It drops Tidal Claws and an Abyssal Egg."
	]
	quest.6F761CEF7CF87194.quest_subtitle: "A sea serpent with a long range cap, so get close anyway. It drops Tidal Claws and an Abyssal Egg."
	quest.6F761CEF7CF87194.title: "&c&lThe Leviathan"
	quest.6F7B8AD6377B3621.quest_desc: [
		"Mount a &eMechanical Roller&r on the front of a train or contraption. It paves with the blocks you give it and clears rubble so you can lay track as you ride."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.6F7B8AD6377B3621.title: "Mechanical Roller"
	quest.6F7B8AD6377B3621.quest_subtitle: "A &6Mechanical Roller&r lets you clear blocks in front and pave with desired blocks underneath the tracks while riding a train"
	quest.6F998D330698620F.quest_desc: [
		"Press cocoa beans into crushed cocoa, then run that through crushing wheels: cocoa powder plus a chance of butter."
		"Butter is the fat in dark and white chocolate."
	]
	quest.6F998D330698620F.title: "Cocoa Butter"
	quest.6F998D330698620F.quest_subtitle: "Press cocoa beans into crushed cocoa, then run that through crushing wheels: cocoa powder plus a chance of butter."
	quest.7003D050CAD2307C.quest_desc: [
		"This branch is Create's redstone toolkit: contacts, latches, pulses, and wireless links that talk to kinetics and contraptions."
		"Tick them off as you need them; none of these are required to leave Andesite Age."
	]
	quest.7003D050CAD2307C.quest_subtitle: "This branch is Create's redstone toolkit: contacts, latches, pulses, and wireless links that talk to kinetics and contraptions."
	quest.7003D050CAD2307C.title: "Redstone + Create"
	quest.7058C7040CC3A881.quest_desc: [
		"Obtain Hoglin Loin. A knife on a Cutting Board or Slicer cuts it into two Hoglin Sausage."
		""
		"Bullet Pepper is the hot spice this mod cooks with."
	]
	quest.7058C7040CC3A881.quest_subtitle: "The meat of the Nether kitchen"
	quest.7058C7040CC3A881.title: "&eHoglin Loin"
	quest.706439D7FCD17265.quest_desc: [
		"On snowy plains. Maledictus is locked inside."
		""
		"You need &6Frosted Prison&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.706439D7FCD17265.quest_subtitle: "A frozen prison on snowy plains."
	quest.706439D7FCD17265.title: "&6Frosted Prison"
	quest.708AB3D0AC844C2F.quest_desc: [
		"Same placement rules as a copper tank, twice the millibuckets per block. Press the ingot into sheets first."
		"Use them as the fuel or oxidizer reservoirs on long-range Propulsion ships."
	]
	quest.708AB3D0AC844C2F.title: "Platinum Fluid Tank"
	quest.708AB3D0AC844C2F.quest_subtitle: "A &bPlatinum Fluid Tank&r stores fluids like a &6Copper Fluid Tank&r, but with double the capacity per block"
	quest.709E90DDEFB25E66.quest_desc: [
		"The &eIndustrial Alternator&r turns shaft RPM into FE; the &eIndustrial Motor&r spends FE to spin a shaft. &eAndesite Cable&r is the cheap FE wire between them."
		"Heavier SU and FE numbers than Crafts & Additions' motor pair. Hold &eW&r over them in EMI to see their Ponder."
	]
	quest.709E90DDEFB25E66.quest_subtitle: "The &eIndustrial Alternator&r turns shaft RPM into FE; the &eIndustrial Motor&r spends FE to spin a shaft. &eAndesite Cable&r is the chea..."
	quest.709E90DDEFB25E66.title: "Craft Industrial Motor and Alternator"
	quest.70B08B5924AF5A89.quest_desc: [
		"Small, rapid-fire barrels with a recoil spring, fed from an ammo container. Steel autocannon barrels come off the Cannon Builder path."
	]
	quest.70B08B5924AF5A89.quest_subtitle: "Small, rapid-firing cannons with a recoil spring. They feed from an ammo container."
	quest.70B08B5924AF5A89.title: "&7Autocannons"
	quest.70D047BEA63EF3CF.quest_desc: [
		"Look at an Otter. Critters also adds Clams and Pearls if you want jewellery later."
		""
		"You need &6Otter&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.70D047BEA63EF3CF.quest_subtitle: "Rivers and clams"
	quest.70D047BEA63EF3CF.title: "&eOtter"
	quest.710E13E8B9129449.quest_desc: [
		"Supplementaries Squared adds extra pieces on top of Supplementaries, including daub slabs, coloured sacks and a Heavy Key."
	]
	quest.710E13E8B9129449.quest_subtitle: "Daub, sacks and a Heavy Key"
	quest.710E13E8B9129449.title: "&eSupplementaries Squared"
	quest.7123D5EC2157E788.quest_desc: [
		"A &eGearbox&r takes rotation on one face and sends it out the others, so you do not have to snake cogwheels around a wall."
		"From here you can add clutches, gearshifts, and chain drives. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.7123D5EC2157E788.title: "Gearbox"
	quest.7123D5EC2157E788.quest_subtitle: "The &6Gearbox&r is sort of like an extension cord, but for &6Shafts&r. It can change the direction of shafts, and can have more than one shaft attached to a different side of the gearbox"
	quest.7123F925F2A66D5B.quest_desc: [
		"Place it, then right-click with a Space Atlas to save the coordinates. Rockets can fly straight back to that pad."
	]
	quest.7123F925F2A66D5B.quest_subtitle: "Mark a landing spot and fly straight back to it."
	quest.7123F925F2A66D5B.title: "&8Rocket Waypoint"
	quest.714382D8E9E06DB7.quest_desc: [
		"Look at it to see what the beam actually is — type, strength, polarization — before you wire sensors."
	]
	quest.714382D8E9E06DB7.quest_subtitle: "Displays the properties of the incident beam"
	quest.714382D8E9E06DB7.title: "&aBeam Reader"
	quest.715B648D1C6D34C1.quest_desc: [
		"Give a &eMechanical Drill&r rotation and it chews the block in front. Glue it to a piston or cart and it becomes a quarry or tunnel bore."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.715B648D1C6D34C1.title: "Mechanical Drill"
	quest.715B648D1C6D34C1.quest_subtitle: "Lets you use &6SU&r to break blocks, and can also be attached to contraptions to make tunnel bores and other destructive machines"
	quest.71B1BAA207E6B417.quest_desc: [
		"&eGantry Shafts&r are the rail; the &eGantry Carriage&r is the trolley. Stack two axes and a glued farm can move both sideways and forward."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.71B1BAA207E6B417.title: "Gantry Carriage"
	quest.71B1BAA207E6B417.quest_subtitle: "A &6Gantry Carriage&r allows for contraptions that move across gantries. Multiple &6Gantry Carriages&r can be chained, allowing for muliple axes of movement"
	quest.71ECD7EE0270484A.quest_desc: [
		"One block, two independent kinetic lanes — or it can drive face-mounted servo bearings from orientation data."
		"Horizontal and vertical variants. Use it when a normal gearbox would mash two shafts together."
	]
	quest.71ECD7EE0270484A.quest_subtitle: "One block, two independent kinetic lanes — or it can drive face-mounted servo bearings from orientation data."
	quest.71ECD7EE0270484A.title: "Craft Smart Gearbox"
	quest.72198C23A0D07A3B.quest_desc: [
		"When the network overstresses, this clutch waits a bit then disconnects. Wrench it to reset once you've fixed the jam."
	]
	quest.72198C23A0D07A3B.quest_subtitle: "A clutch that uncouples after a set delay when the network is overstressed. Can be reset with a wrench."
	quest.72198C23A0D07A3B.title: "&6Overstress Clutch"
	quest.7236F44BE57B00C6.quest_desc: [
		"Spout liquid ruby chocolate onto a marshmallow, same setup as the dark glaze."
		"Mix ruby chocolate from sugar, dragon's breath, cocoa beans and milk if you haven't made any yet."
	]
	quest.7236F44BE57B00C6.quest_subtitle: "Spout liquid ruby chocolate onto a marshmallow, same setup as the dark glaze."
	quest.7236F44BE57B00C6.title: "&dRuby Chocolate Glazed Marshmallow"
	quest.723BC505B72493F0.quest_desc: [
		"Smith netherite armour with Cursium and a Cursium Upgrade template. Not as tanky as Ignitium, but a full netherite upgrade from this boss."
	]
	quest.723BC505B72493F0.quest_subtitle: "Maledictus's Cursium upgrades netherite armour with a Cursium Upgrade Smithing Template."
	quest.723BC505B72493F0.title: "&bCursium Armour"
	quest.726C3E3376580AF4.quest_desc: [
		"Fill the empty catalyst with a lava bucket, or spout lava into it. The fan bulk-blasts as if lava were sitting in front of it — without spilling."
	]
	quest.726C3E3376580AF4.quest_subtitle: "Fill the empty catalyst with a lava bucket, or spout lava into it. The fan bulk-blasts as if lava were sitting in front of it — without s..."
	quest.726C3E3376580AF4.title: "&cFan Blasting Catalyst"
	quest.72A508D87CAC0E4F.quest_desc: [
		"Apply a brass ingot to any glass block (or use a Deployer) to make Brass Glass Casing."
		"Prismatic Shine turns Create casings transparent so kinetic guts stay visible inside a factory wall."
	]
	quest.72A508D87CAC0E4F.quest_subtitle: "Brass on glass"
	quest.72A508D87CAC0E4F.title: "&eBrass Glass Casing"
	quest.72C5E74B15EFB67A.quest_desc: [
		"A &eSpout&r, a brass sheet, and an iron block. Pump in the right fluid and it copies written books, enchanted books, name tags, and train schedules."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.72C5E74B15EFB67A.quest_subtitle: "Copy your &awritten books, enchanted books, name tags, train schedules&r and more."
	quest.72C5E74B15EFB67A.title: "&6Printer"
	quest.7358B5B4BECE78E3.quest_desc: [
		"Open a player shop on the Logistics and Trade line, and finish Master Builder in the Builder's Guild."
		""
		"The factory that sells also has to look like someone lives there."
	]
	quest.7358B5B4BECE78E3.quest_subtitle: "Trade floor, builder's toolkit"
	quest.7358B5B4BECE78E3.title: "&bLedger and Chisel"
	quest.735BAD14F1FAC6AC.quest_desc: [
		"Stores assembled ammo in bulk once the sequenced assembly line is running. Guns chew through rounds; keep a box on you."
	]
	quest.735BAD14F1FAC6AC.quest_subtitle: "Bulk storage once you can assemble ammo on a Create line."
	quest.735BAD14F1FAC6AC.title: "&cAmmo Box"
	quest.73646CD6C89DDF7B.quest_desc: [
		"Place a &eCrossing&r where a road meets the rails, then power it — a &eTrain Observer&r is the usual trigger — so the arms drop when a train is coming."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.73646CD6C89DDF7B.quest_subtitle: "Place a &eCrossing&r where a road meets the rails, then power it — a &eTrain Observer&r is the usual trigger — so the arms drop when a tr..."
	quest.73646CD6C89DDF7B.title: "&aCrossing Gate"
	quest.73BD53E9130BA3C5.quest_desc: [
		"Run an iron sheet through sequenced assembly: a &eMechanical Saw&r and a &eMechanical Press&r, looping until the assembly finishes."
		"Wrap the finished part into a coloured &ePortable Engine&r next."
	]
	quest.73BD53E9130BA3C5.title: "Engine Assembly"
	quest.73BD53E9130BA3C5.quest_subtitle: "Run an iron sheet through sequenced assembly: a &eMechanical Saw&r and a &eMechanical Press&r, looping until the assembly finishes."
	quest.73C8DAA9A9CBC28B.quest_desc: [
		"Right-click a brass ingot on a stripped log for a &eBrass Casing&r. Smart logistics, crafters, and the electric machines in this chapter all want that casing."
	]
	quest.73C8DAA9A9CBC28B.title: "Brass Casing"
	quest.73C8DAA9A9CBC28B.quest_subtitle: "The basis for more advanced blocks"
	quest.73CA3C62CBC41E94.quest_desc: [
		"Put the &eConduit Cage&r in front of the fan instead of water. That's channeling: flint can become shards, glowstone dust becomes crystals, and Suspicious Rock can drop nautilus shells."
	]
	quest.73CA3C62CBC41E94.quest_subtitle: "This machine simplifies channeling setups."
	quest.73CA3C62CBC41E94.title: "&aActivate the &6Encased Fan&r &awith a &3Conduit Cage"
	quest.73CBEFC51D900FE3.quest_desc: [
		"A &eMinecart Coupling&r chains minecarts or cart contraptions so they pull as one consist."
		"Right-click two carts with it to join them. Furnace carts can then haul a whole string."
	]
	quest.73CBEFC51D900FE3.title: "Minecart Coupling"
	quest.73CBEFC51D900FE3.quest_subtitle: "A &eMinecart Coupling&r chains minecarts or cart contraptions so they pull as one consist."
	quest.742B53EF2F996E70.quest_desc: [
		"Sneak-scroll a &eWeighted Ejector&r to set the throw distance, then dump items onto it. Stacks land on another depot or belt without a long conveyor."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.742B53EF2F996E70.title: "Weighted Ejector"
	quest.742B53EF2F996E70.quest_subtitle: "&6Weighted Ejectors&r can launch items accurately over long distances"
	quest.74A663BECB035204.quest_desc: [
		"&eWelcome to Create: Propulsion!&r. Complete it by obtaining &6Welcome to Create: Propulsion!&r."
		""
		"Opens after Blaze Burner (Brass Age)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.74A663BECB035204.quest_subtitle: "&d&lCreate Propulsion: Simulated&r is an addon that introduces &6Propulsion&r-focused &6&lCreate&r gameplay to the &6Sable&r + &6Create Aeronautics&r ecosystem"
	quest.74A663BECB035204.title: "Welcome to &d&lCreate: Propulsion&r!"
	quest.74B65EACFD62BA44.quest_desc: [
		"A nether-wastes arena. Ignis is the boss; come with fire resistance and melee."
		""
		"You need &6Burning Arena&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.74B65EACFD62BA44.quest_subtitle: "A burning arena in the nether wastes."
	quest.74B65EACFD62BA44.title: "&6Burning Arena"
	quest.751D7BE5AB08E541.quest_desc: [
		"Craft a &eSteam Whistle&r, glue it onto the train, then honk while you're moving."
		"Hold &eW&r over the whistle in EMI to see its Ponder."
	]
	quest.751D7BE5AB08E541.quest_subtitle: "Assemble a &eSteam Whistle&r to your &bTrain&r and activate it while driving"
	quest.751D7BE5AB08E541.title: "&eChoo Choo!"
	quest.7540EBEF0F004A13.quest_desc: [
		"Build a long-distance line, sit down, and ride until the advancement pops."
		"A scheduled train counts as well as driving it yourself."
	]
	quest.7540EBEF0F004A13.quest_subtitle: "Leave a &fTrain Seat&r over 5000 blocks away from where you started travelling"
	quest.7540EBEF0F004A13.title: "&aField Trip"
	quest.754F9B65DF59C1C1.quest_desc: [
		"One beam in, two polarized beams out at right angles. Send each toward a different receptor or condenser."
	]
	quest.754F9B65DF59C1C1.quest_subtitle: "Split the beam in two and &bpolarize&r the resultant beams perpendicularly"
	quest.754F9B65DF59C1C1.title: "&9Polarizing Beam Splitter Block"
	quest.757AC0F85778164E.quest_desc: [
		"Spin an &eAlternator&r from your kinetic network and it outputs FE. Faster RPM means more energy; dump the surplus into an accumulator."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.757AC0F85778164E.title: "Alternator"
	quest.757AC0F85778164E.quest_subtitle: "An &6Alternator&r generates &6Energy (E)&r from kinetic energy. The amount generated is dependent on the &6RPM&r and caps at &6256 E/t&r"
	quest.75BA8D3D6C0B9D1C.quest_desc: [
		"Park a &eCutting Board&r next to a &eBamboo Basket&r and let a &eMechanical Arm&r move ingredients between them."
		"A &eMechanical Saw&r on a contraption can work a cutting board too. Hold &eW&r over the arm or saw in EMI to see its Ponder."
	]
	quest.75BA8D3D6C0B9D1C.quest_subtitle: "The Basket and Cutting Board can be supported by the Mechanical Arm and Mechanical saw to manage numerous tasks, including supplying ingredients and cooking."
	quest.75BA8D3D6C0B9D1C.title: "Craft Basket - Cutting Board and Mechanical Arm and Mechanical Saw"
	quest.75C7132B0B4C0CA2.quest_desc: [
		"A Package Filter matches packaged items by their targeted address and goes in Create filter slots. Use it with belts and funnels so Workshop and Factory boxes take different paths."
		"Frogports already sit on your chain: give each an address. A package whose address does not match is placed on the conveyor and finds a matching frog. Packages with no destination spin in place. Hold &eW&r over the Frogport in EMI."
	]
	quest.75C7132B0B4C0CA2.quest_subtitle: "Route boxes by the address on them"
	quest.75C7132B0B4C0CA2.title: "&ePackage Filter"
	quest.75CACD0EE12EFB13.quest_desc: [
		"Hold the &eExtendo Grip&r to place and break from several blocks further away. Mechanical-craft it once; wiring a big factory feels different afterwards."
	]
	quest.75CACD0EE12EFB13.title: "Extendo Grip"
	quest.75CACD0EE12EFB13.quest_subtitle: "A &6Extendo Grip&r allows for increased reach for block mining and entity striking"
	quest.75CFD6668679C928.quest_desc: [
		"Craft a &eTrain Station Clock&r and hang it where passengers can see it."
		"Pure décor, but it belongs next to the departure board."
	]
	quest.75CFD6668679C928.quest_subtitle: "No station is complete without one."
	quest.75CFD6668679C928.title: "&aStation Clock"
	quest.760251538F4200CF.quest_desc: [
		"Once Awkward is flowing, mix in the next ingredient to finish a potion. A &eConduit Cage&r can take that potion and apply — or strip — the effect in an area."
	]
	quest.760251538F4200CF.quest_subtitle: "Conduit Cage: a machine used for granting/removing effects in an area around itself."
	quest.760251538F4200CF.title: "&aObtain Any Potion on &6Mechanical Mixer "
	quest.7611AC5B2A3A96EF.quest_desc: [
		"A bearing, obsidian plate, shafts, spring-alloy sheets, and brass casing. Spins parts together to weld them — check EMI for what it joins."
	]
	quest.7611AC5B2A3A96EF.quest_subtitle: "A bearing, obsidian plate, shafts, spring-alloy sheets, and brass casing. Spins parts together to weld them — check EMI for what it joins."
	quest.7611AC5B2A3A96EF.title: "&bFriction Welder"
	quest.7640216D4CDF6C92.quest_desc: [
		"Spout liquid gunpowder or nitropowder onto Andesite Alloy. Every assembled cartridge needs one."
	]
	quest.7640216D4CDF6C92.quest_subtitle: "Filled with a spout."
	quest.7640216D4CDF6C92.title: "&6Primers"
	quest.764ED9E2580B8645.quest_desc: [
		"Reach Mars with the Interplanetary Navigator. Mine martian iron and volcanic ash for steel, then grow a garden and split water into hydrogen."
	]
	quest.764ED9E2580B8645.quest_subtitle: "Red dust, volcanic ash and martian iron."
	quest.764ED9E2580B8645.title: "&cMars"
	quest.76685EA6C13CDC38.quest_desc: [
		"A sea-lantern ingredient you no longer have to raid a monument for. Keep the Cage spinning and the glowstone coming."
	]
	quest.76685EA6C13CDC38.quest_subtitle: "They can be used as a light source or for crafting."
	quest.76685EA6C13CDC38.title: "&aObtain &bPrismarine Crystals"
	quest.768E90F9FA398E87.quest_desc: [
		"Outputs on every side. Use it when a normal or six-way gearbox still isn't enough faces."
		""
		"You need &6Omni Gearbox&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.768E90F9FA398E87.quest_subtitle: "A gearbox that outputs to every side."
	quest.768E90F9FA398E87.title: "&eOmni Gearbox"
	quest.769351E6B5091327.quest_desc: [
		"An &eAdjustable Chain Gearshift&r on a chain-drive row doubles or halves that line's speed while it is powered. Scroll the block to pick which."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.769351E6B5091327.title: "Adjustable Chain Gearshift"
	quest.769351E6B5091327.quest_subtitle: "An &6Adjustable Chain Gearshift&r can be used to halve or double the rotational speed of connected chain drives when receiving a &credstone&r signal"
	quest.76B9A5C1355E0C38.quest_desc: [
		"&eSturdy Sheets&r, blaze rods, cinder flour, and tinted glass. Mechanical Crafters turn that into an Inactive Blaze Core — the renewable superheat path."
	]
	quest.76B9A5C1355E0C38.quest_subtitle: "To craft an &2Inactive Blaze Core"
	quest.76B9A5C1355E0C38.title: "&eObtain Materials"
	quest.76D805D38E84858C.quest_desc: [
		"Same &ePortable Engine&r as Simulated. Bolt it to the airframe so the ship carries its own rotation for propellers and vents."
		"From here the chapter splits into goggles, flight hardware, and the Levitite line."
	]
	quest.76D805D38E84858C.quest_subtitle: "Same &ePortable Engine&r as Simulated. Bolt it to the airframe so the ship carries its own rotation for propellers and vents."
	quest.76D805D38E84858C.title: "Engine"
	quest.76D9D182704B7FC8.quest_desc: [
		"Macaw's Lights and Lamps adds tiki torches and other lamps. An Oak Tiki Torch is a cheap start."
	]
	quest.76D9D182704B7FC8.quest_subtitle: "Tiki torches and lamps"
	quest.76D9D182704B7FC8.title: "&eMacaw's Lights"
	quest.76DC400A6413BE5A.quest_desc: [
		"Hang a sail on the Industrial Fan for washing, blasting, smoking, haunting, freezing, sanding, seething, or dragon's breath — no lava or water sitting in the world."
	]
	quest.76DC400A6413BE5A.quest_subtitle: "Sails that give a fan its processing type without a block in front: washing, blasting, freezing, sanding and more."
	quest.76DC400A6413BE5A.title: "&eCatalyst Sails"
	quest.76E85F7EFA6EA920.quest_desc: [
		"Milling limestone mostly yields calcium powder, with a small chance of &eSuspicious Rock&r. Keep milling until one drops — you'll wash or channel it next."
	]
	quest.76E85F7EFA6EA920.quest_subtitle: "Suspicious indeed."
	quest.76E85F7EFA6EA920.title: "&aObtain Suspicious Rock"
	quest.76F48EB46CAF8A5D.quest_desc: [
		"Find a hostile mob on the tracks and don't brake. Passive animals don't count."
		""
		"You need &6Road Kill&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.76F48EB46CAF8A5D.quest_subtitle: "Run over an enemy with your &bTrain&r"
	quest.76F48EB46CAF8A5D.title: "&2Road Kill"
	quest.776D3E4656FECF89.quest_desc: [
		"A &eThruster Bearing&r turns the mounted assembly so you can redirect nozzles without rebuilding the ship."
		"Install a Gadgets thruster on it, then aim with redstone or the analogue controller. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.776D3E4656FECF89.quest_subtitle: "A &eThruster Bearing&r turns the mounted assembly so you can redirect nozzles without rebuilding the ship."
	quest.776D3E4656FECF89.title: "Craft Servo Bearing"
	quest.778CCF75E93579B4.quest_desc: [
		"On this pack, three &eRubber Sheets&r in a row craft a &eMechanical Belt&r — kelp is no longer the ingredient."
		"Stretch it between two shafts to move items under presses and saws. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.778CCF75E93579B4.quest_subtitle: "&6Mechanical Belts&r are useful for moving items either in a straight line or diagonally. Make sure to place a &6Shaft&r on each end so they can connect and work properly"
	quest.778CCF75E93579B4.title: "Mechanical Belt"
	quest.7826031A16D82432.quest_desc: [
		"String &eDisplay Boards&r into a wide sign. Faster rotation makes the text refresh sooner, which is why stations like them for arrivals."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.7826031A16D82432.title: "Display Board"
	quest.7826031A16D82432.quest_subtitle: "A &6Display Board&r is basically an advanced sign that updates faster if provided with higher &6RPM&r. It's like the bulletin boards you see in train stations"
	quest.7860AF137465560B.quest_desc: [
		"Explosive shells. They do nothing without a fuze on the front. Watch the crater, and keep the mount well away from your factory."
	]
	quest.7860AF137465560B.quest_subtitle: "Shells need a fuze to go off. Mind the crater."
	quest.7860AF137465560B.title: "&4High Explosive Shells"
	quest.78C5E467DE4EE68A.quest_desc: [
		"Place amethyst inside and keep Source Jars nearby. It slowly turns the shard into a Source Gem, the base of Ars crafting."
	]
	quest.78C5E467DE4EE68A.quest_subtitle: "Put amethyst in it and it slowly turns into Source Gems, fed by Source from nearby jars."
	quest.78C5E467DE4EE68A.title: "&5Imbuement Chamber"
	quest.78EA25B85A869DD3.quest_desc: [
		"Same idea as the Copper Coil, with zinc — check EMI for the sequence. Unlocks the Hologram Source."
	]
	quest.78EA25B85A869DD3.quest_subtitle: "Same idea as the Copper Coil, with zinc — check EMI for the sequence. Unlocks the Hologram Source."
	quest.78EA25B85A869DD3.title: "&aZinc Coil"
	quest.78F7924189EFC7A8.quest_desc: [
		"Undying, fall, void, fire, drowning, wither. Craft them at the apparatus. A Water Breathing Charm is worth bringing to the Leviathan."
	]
	quest.78F7924189EFC7A8.quest_subtitle: "Charms that save you from falls, the void, fire, drowning, withering or death. A Water Breathing Charm helps against the Leviathan."
	quest.78F7924189EFC7A8.title: "&aProtective Charms"
	quest.7971AD11B9C4EBE5.quest_desc: [
		"Stick an &eIron Handle&r on a block and you can grab that Simulated assembly and haul it by hand."
		"Handy for lining a hull up with the assembler or a dock before you add engines."
	]
	quest.7971AD11B9C4EBE5.title: "Iron Handle"
	quest.7971AD11B9C4EBE5.quest_subtitle: "Fuel can be inserted to activate the engine and produce rotational power until the fuel runs out"
	quest.7975D965D14D10BC.quest_desc: [
		"Gold, chiseled sandstone, emerald, dead bush, cactus, rotten flesh and bone around an Eye of Ender. It finds a Cursed Pyramid."
	]
	quest.7975D965D14D10BC.quest_subtitle: "Crafted at a crafting table around an Eye of Ender. Throw it and it flies toward the nearest Cursed Pyramid."
	quest.7975D965D14D10BC.title: "&eDesert Eye"
	quest.7986DE628299BE48.quest_desc: [
		"Analog redstone scales rotation through it from stopped to full speed, horizontally or vertically."
		"Use it as a smooth clutch for gantries, props, or anything a binary clutch would jerk. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.7986DE628299BE48.quest_subtitle: "Analog redstone scales rotation through it from stopped to full speed, horizontally or vertically."
	quest.7986DE628299BE48.title: "Craft Variable Tranmissions"
	quest.7993A52ED6910F60.quest_desc: [
		"Mechanical-craft an Ornithopter Glider from seven Wing Meshes, ropes, Cogwheels, Shafts, brass nuggets, wooden slabs and Andesite Casing."
		"It equips on the back (432 durability) as a Create-flavoured glider for when a full Simulated airship is more machine than you need."
	]
	quest.7993A52ED6910F60.quest_subtitle: "Back-slot Create glider"
	quest.7993A52ED6910F60.title: "&6Ornithopter Glider"
	quest.7A0E5258CC7059F9.quest_desc: [
		"Look up the empty iced cup in EMI, add ice, then spout coffee fluid into it."
		"The drink is caffeinated; banana, mint and caramel variants are extra spouting on top of this cup."
	]
	quest.7A0E5258CC7059F9.quest_subtitle: "Look up the empty iced cup in EMI, add ice, then spout coffee fluid into it."
	quest.7A0E5258CC7059F9.title: "&6Iced Coffee"
	quest.7A22F754E879815D.quest_desc: [
		"A brass gearbox whose four faces can each be reversed on their own. Use the vertical variant when the shafts need to stand up."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.7A22F754E879815D.title: "Brass Gearbox"
	quest.7A22F754E879815D.quest_subtitle: "A gearbox where the rotation direction of all 4 sides are independently configurable."
	quest.7A56250D2EBADD11.quest_desc: [
		"Run normal track through sequenced assembly again to widen it, then use a wide bogey."
		"Big locomotives look right on it, and it still connects to stations and signals."
	]
	quest.7A56250D2EBADD11.quest_subtitle: "Wide track is made from normal track, for big, heavy trains."
	quest.7A56250D2EBADD11.title: "&6Wide Gauge"
	quest.7A5E084AC28AD736.quest_desc: [
		"&eMechanical Crafter&r. Complete it by obtaining &6Mechanical Crafter&r."
		""
		"Opens after create:mechanical_crafter (Brass Age) Main path: Create: Immersive TaCZ + Create Armorer via Create machines. - Mechanical Crafter: gun parts, Create Armorer guns, and attachments. - Mixing / spout / saw / sequenced assembly: ammo. Optional side path: Gun Smith Table and TACZ workbenches for stock (non-Create) TACZ guns.."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.7A5E084AC28AD736.quest_subtitle: "Create Immersive TaCZ — guns, ammo and attachments are made with Create machines."
	quest.7A5E084AC28AD736.title: "&eMechanical Crafter"
	quest.7A6C4B3AAA08E85B.quest_desc: [
		"Place a &eTrain Signal&r beside the track to split the line into blocks. Trains wait at red instead of colliding."
		"Use them at junctions and single-track meets. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.7A6C4B3AAA08E85B.quest_subtitle: "A &6Track Signal&r is used to control the flow of trains across tracks and track intersections"
	quest.7A6C4B3AAA08E85B.title: "&cTrain Signal"
	quest.7A91C0779C004003.quest_desc: [
		"Players need a Location Transmitter in their inventory to be targeted by a plane. Craft from a Transmitter, a compass and Andesite Casing. Right-click to toggle it; it can sit on a belt curios slot."
		"An address inside <> overrides the plane's target when it launches, which is how a shop can print Sold <buyer> on the box."
	]
	quest.7A91C0779C004003.quest_subtitle: "So a plane can find you"
	quest.7A91C0779C004003.title: "&eLocation Transmitter"
	quest.7AD1FD132DAD2B56.quest_desc: [
		"Break clusters that grow on budding lunar sapphire, the same way you farm amethyst. Polish the shards next; they go into the Navigator and Auto-Landing Station."
	]
	quest.7AD1FD132DAD2B56.quest_subtitle: "Sapphire clusters grow on budding lunar sapphire, just like amethyst."
	quest.7AD1FD132DAD2B56.title: "&bLunar Sapphire"
	quest.7AD9B79EA9C173A9.quest_desc: [
		"Another Furniture adds sofas, lamps and similar pieces. It ships its own Hammer for furniture."
	]
	quest.7AD9B79EA9C173A9.quest_subtitle: "Sofas, lamps and a hammer"
	quest.7AD9B79EA9C173A9.title: "&eAnother Furniture"
	quest.7B0D85DA0CAD53C8.quest_desc: [
		"&eWelcome to Optical&r. Complete it by obtaining &6Welcome to Optical&r."
		""
		"Opens after Andesite, the Foundation (Andesite Age)."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.7B0D85DA0CAD53C8.quest_subtitle: "This addon is all about transferring &aRotational Force&r with the force of &dLight"
	quest.7B0D85DA0CAD53C8.title: "&5Welcome to Optical"
	quest.7B179AAB6FF5DA36.quest_desc: [
		"Right-click the powered &eSlicer&r with a Farmer's Delight knife to cut food, or with any axe to strip logs."
		"Drop items onto the depot (or belt) below it and it will process them automatically."
	]
	quest.7B179AAB6FF5DA36.quest_subtitle: "Useful for cutting food or stripping logs."
	quest.7B179AAB6FF5DA36.title: "&eInsert any axe or knife into the &6Slicer"
	quest.7B17ACDB9B2B94E5.quest_desc: [
		"The analogue controller maps flight keys, redstone, wireless frequencies, or blocks on the hull. The joystick splits stick motion into four 0–15 signals."
		"Double buttons are two wireless buttons in one block. The gyroscope link shares orientation with whatever is on the network."
	]
	quest.7B17ACDB9B2B94E5.quest_subtitle: "The analogue controller maps flight keys, redstone, wireless frequencies, or blocks on the hull. The joystick splits stick motion into fo..."
	quest.7B17ACDB9B2B94E5.title: "Craft All Controllers And Data Link"
	quest.7B203B70553A2B6C.quest_desc: [
		"Motor, shafts, optional gearboxes, then an Aeronautics &ePropeller Bearing&r. That is an electric airframe."
		"Ion thrusters can sit beside it if you want extra push with no shaft at all."
	]
	quest.7B203B70553A2B6C.quest_subtitle: "Drive a propeller bearing from the motor, directly or through shafts and gearboxes, and you have an electric plane or airship."
	quest.7B203B70553A2B6C.title: "&eElectric Propellers"
	quest.7B79C243857E090C.quest_desc: [
		"Crush Mars iron ore for the raw metal. Compact it with titanium and volcanic ash for &eMartian Steel&r."
	]
	quest.7B79C243857E090C.quest_subtitle: "Crush Mars iron ore."
	quest.7B79C243857E090C.title: "&cMartian Iron"
	quest.7BAC29E0C953238E.quest_desc: [
		"Obtain a Cave Carrot. Shear Wild Cave Carrots on a Cutting Board (shears or a Crab Claw) to get Cave Carrots and Gossypium."
		""
		"A Mechanical Mixer already lists Cave Soup among the heated recipes that use this crop."
	]
	quest.7BAC29E0C953238E.quest_subtitle: "Shear Wild Cave Carrots"
	quest.7BAC29E0C953238E.title: "&eCave Carrot"
	quest.7BB23F60649FAE70.quest_desc: [
		"Mechanical-craft this from circuits, a Targeting Computer, hardened mechanisms and a lot of titanium. Right-click it to assemble the rocket and pick a destination."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.7BB23F60649FAE70.quest_subtitle: "The heart of every rocket: it assembles the rocket, checks it and launches it."
	quest.7BB23F60649FAE70.title: "&9Rocket Station"
	quest.7BE8110B77ACE902.quest_desc: [
		"Unpowered, it behaves like an encased cogwheel. Analog redstone changes the ratio between the shaft and the cog."
		"Feed the cog instead of the shaft and the shaft speeds up. Full signal disconnects the two so they can spin apart. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.7BE8110B77ACE902.title: "Analog Transmission"
	quest.7BE8110B77ACE902.quest_subtitle: "Unpowered, it behaves like an encased cogwheel. Analog redstone changes the ratio between the shaft and the cog."
	quest.7C11C7027F18398C.quest_desc: [
		"Activate one, then teleport to it from any other waystone. They spawn in the world and you can craft more. Warp stones let you do it without standing at a stone."
	]
	quest.7C11C7027F18398C.quest_subtitle: "Activate a waystone and you can teleport back to it from any other."
	quest.7C11C7027F18398C.title: "&bWaystones"
	quest.7C268464F6DE1885.quest_desc: [
		"Sequenced assembly: amethyst, iron sheets, glass panes, water, then a press. Almost every Optical machine wants one; a Beam Focuser can assemble it faster later."
	]
	quest.7C268464F6DE1885.quest_subtitle: "Used in crafting a ton of integral machinery"
	quest.7C268464F6DE1885.title: "&5Optical Device"
	quest.7C26D6CEC3139342.quest_desc: [
		"Assemble a glued structure on a &eMechanical Bearing&r and it spins in place. That is the usual way to run a circle of harvesters."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.7C26D6CEC3139342.title: "Mechanical Bearing"
	quest.7C26D6CEC3139342.quest_subtitle: "A &6Mechanical Bearing&r allows for contraptions that rotate around a point in space, particularly useful for farms"
	quest.7C490456FC7E561C.quest_desc: [
		"Hang a &eSprinkler&r from a fluid pipe and pump into it. It rains that fluid onto the blocks below."
		"Water, lava, liquid fertilizer and potions each do something different — those quests are next."
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.7C490456FC7E561C.quest_subtitle: "The Sprinkler is a block that distributes fluid over a small area below when supplied via a pipe."
	quest.7C490456FC7E561C.title: "&eCraft a &bSprinkler"
	quest.7C50408E8C98AD23.quest_desc: [
		"Power it and it dumps a huge stress load, stopping the whole network on purpose. An emergency stop for a line you don't want to clutch."
	]
	quest.7C50408E8C98AD23.quest_subtitle: "A device that produces immense stress when powered, halting the network by overstressing it."
	quest.7C50408E8C98AD23.title: "&6Brake"
	quest.7C8E875B7CAC7984.quest_desc: [
		"Craft a Nether Bricks Stove from polished blackstone bricks, a campfire, and nether bricks."
		""
		"My Nether's Delight is hoglin and pepper cooking. This branch waits on the Exploration quest The Nether."
	]
	quest.7C8E875B7CAC7984.quest_subtitle: "Opens with the Nether"
	quest.7C8E875B7CAC7984.title: "&eNether Bricks Stove"
	quest.7CAF3997BAE2A67D.quest_desc: [
		"Dropped by the Wilden Chimera. The Tattered Tome tells you how to summon it; go in with Mage armour. You need the tribute for the Archmage book and, later, the Mark of Mastery."
	]
	quest.7CAF3997BAE2A67D.quest_subtitle: "Dropped by the Wilden Chimera, Ars Nouveau's boss. The tome explains how to summon it."
	quest.7CAF3997BAE2A67D.title: "&4Wilden Tribute"
	quest.7CF942B0092FB3D9.quest_desc: [
		"Place the core and follow the ghost preview: brass casing, pillars of the light's key block, framed glass, a glow block, a chain, and fluid tanks of that liquid light. Small, medium and biggest sizes."
		""
		"It recharges lanterns and rings in range, turns a shaft under the core, and keeps blaze burners lit with no fuel. Goggles show what is missing."
	]
	quest.7CF942B0092FB3D9.quest_subtitle: "Build it around the core"
	quest.7CF942B0092FB3D9.title: "&6Central Power Battery"
	quest.7CFE797B0EC4A6E7.quest_desc: [
		"Mechanical-craft the full-size &eThruster&r, or shapeless-convert it to the &eSmall Thruster&r that packs the same output into a tighter body."
		"Load solid or liquid fuel, throttle with redstone 0–15, and optionally sit it on a servo bearing. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.7CFE797B0EC4A6E7.quest_subtitle: "Mechanical-craft the full-size &eThruster&r, or shapeless-convert it to the &eSmall Thruster&r that packs the same output into a tighter ..."
	quest.7CFE797B0EC4A6E7.title: "Craft Thrusters"
	quest.7D20EAB7E4E34B45.quest_desc: [
		"A moving chest. Load it at one end of the line and unload with a hopper at the other."
		"Still the simplest way to send a delivery before you have trains."
	]
	quest.7D20EAB7E4E34B45.quest_subtitle: "A moving chest. Load it at one end of the line and unload with a hopper at the other."
	quest.7D20EAB7E4E34B45.title: "&6Minecart with Chest"
	quest.7D607C004797651F.quest_desc: [
		"Capture any allowed mob with the Empty Soul Catcher to fill it."
		"Right-click to release the soul, or keep it for the Mechanical Spawner. There must be room at the release spot."
	]
	quest.7D607C004797651F.quest_subtitle: "A mob in a bottle"
	quest.7D607C004797651F.title: "&eSoul Catcher"
	quest.7D638436555FE784.quest_desc: [
		"Channeling flint is the renewable route. Use the shards for prismarine blocks and anything else that still wants monument loot."
	]
	quest.7D638436555FE784.quest_subtitle: "They can be used for crafting."
	quest.7D638436555FE784.title: "&aObtain &bPrismarine Shards"
	quest.7D95DE32054DB741.quest_desc: [
		"Attaches to a sliding breech so you can reload cartridges quickly without a full loader contraption."
	]
	quest.7D95DE32054DB741.quest_subtitle: "Fit it to a sliding breech for fast reloading by hand."
	quest.7D95DE32054DB741.title: "&eQuick-Firing Mechanism"
	quest.7DBB2DA9E468940C.quest_desc: [
		"Craft the full set before Venus. It survives heat and pressure that would cook the iron suit."
	]
	quest.7DBB2DA9E468940C.quest_subtitle: "A tougher suit for harsher worlds."
	quest.7DBB2DA9E468940C.title: "&cMartian Steel Space Suit"
	quest.7DC6F687EB6A1139.quest_desc: [
		"It shines a pointer and outputs redstone from how far the first blocking block is. The value panel sets max range; a filter limits which blocks count."
		"Use it as a Simulated rangefinder for docks, ground proximity, or avoiding walls. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.7DC6F687EB6A1139.title: "Optical Sensor"
	quest.7DC6F687EB6A1139.quest_subtitle: "It shines a pointer and outputs redstone from how far the first blocking block is. The value panel sets max range; a filter limits which ..."
	quest.7E8F42F1D630BD88.quest_desc: [
		"Faster exhaust processing than T1, and propulsion T2 quadruples thrust with another fuel bump."
		"Keep the same three processing types plus propulsion. T3 widens the cooking area as well as the speed."
	]
	quest.7E8F42F1D630BD88.quest_subtitle: "Faster exhaust processing than T1, and propulsion T2 quadruples thrust with another fuel bump."
	quest.7E8F42F1D630BD88.title: "Craft All Tier 2 on Thrusters"
	quest.7EB6B6A390A7574A.quest_desc: [
		"Build something that actually runs using parts from three of this chapter's mods — gears, presses or fans, springs, or the rest. Tick this off when the machine is spinning."
	]
	quest.7EB6B6A390A7574A.quest_subtitle: "Build a machine that uses parts from three different mods in this chapter. Tick this off when it runs."
	quest.7EB6B6A390A7574A.title: "&e&lWorkshop"
	quest.7F6EFBBE2DB05D4B.quest_desc: [
		"Crying obsidian and obsidian around an Eye of Ender. It leads to a Sunken City on a deep ocean floor."
	]
	quest.7F6EFBBE2DB05D4B.quest_subtitle: "Crafted at a crafting table around an Eye of Ender. Throw it and it flies toward the nearest Sunken City."
	quest.7F6EFBBE2DB05D4B.title: "&eAbyss Eye"
	quest.7FA7A9FB1C9F951C.quest_desc: [
		"Craft a Wrench Cog Augment from two copper plates and any smithing trim template."
		"The cog piece is the same swap system as the handle: copper sheets plus a template, then material-swap recipes."
	]
	quest.7FA7A9FB1C9F951C.quest_subtitle: "Copper plates on a trim"
	quest.7FA7A9FB1C9F951C.title: "&eWrench Cog Augment"
	quest.7FBEC721845974E4.quest_desc: [
		"Craft it from a book and one iron of each tool. Press C to open the book, pick a glyph, and cast. Archwood, gems and the Scribe's Table unlock more glyphs."
	]
	quest.7FBEC721845974E4.quest_subtitle: "A book and one iron of each tool. Your first spellbook: press &eC&r to open it and make a spell."
	quest.7FBEC721845974E4.title: "&dNovice Spell Book"
	quest.8080A41AED9B47ED.quest_desc: [
		"Craft a Windchest Controller from Oak Planks, a Spruce Slab, Redstone Dust and zinc ingots."
		"Point each Windchest's red arrow at the Controller, blow an Encased Fan into it, then power the Controller with redstone so attached pipes sound."
	]
	quest.8080A41AED9B47ED.quest_subtitle: "Fan in, redstone on"
	quest.8080A41AED9B47ED.title: "&eWindchest Controller"
	quest.83D8627300B71AC2.quest_desc: [
		"Craft Red Wrapping Paper from eight Paper around Red Dye."
		"It is a 24-use tool tagged as wrapping paper; other colours use the same pattern with their dye."
	]
	quest.83D8627300B71AC2.quest_subtitle: "Paper dyed, 24 uses"
	quest.83D8627300B71AC2.title: "&eRed Wrapping Paper"
	quest.8554358921388984.quest_desc: [
		"Macaw's Paths and Pavings adds flagstones and plank paths. An Oak Planks Path is a cheap walkway."
	]
	quest.8554358921388984.quest_subtitle: "Flagstone and plank paths"
	quest.8554358921388984.title: "&eMacaw's Paths"
	quest.85798D47B2C887B8.quest_desc: [
		"You already have a Robo Bee and Bee Port. Craft a Mobile Packager from two brass sheets, a Packager, cardboard and sticks to wrap items by hand: use it to pack, sneak-use it to edit a package."
		"A Bee Port sends a package whose address matches a player, or to another Port with the same address. Put a Robo Bee in the port's bee slot. Hold &eW&r over the Bee Port in EMI."
	]
	quest.85798D47B2C887B8.quest_subtitle: "Pack on the go, then let the bees fly"
	quest.85798D47B2C887B8.title: "&eMobile Packager"
	quest.85816F0D3B1B5EDB.quest_desc: [
		"Craft from three copper sheets, a lightning rod and redstone. Combined with an Item Vault it becomes a Stock Link, the block that founds a logistics network."
		"The same Transmitter is later used in a Location Transmitter so cardboard planes can find a player."
	]
	quest.85816F0D3B1B5EDB.quest_subtitle: "The antenna every Stock Link needs"
	quest.85816F0D3B1B5EDB.title: "&eTransmitter"
	quest.89B07B50FD3F39D5.quest_desc: [
		"Craft a Control Desk from Brass Casing, a Redstone Link, a Transmitter, an Electron Tube and a Precision Mechanism."
		"Aeroworks adds cockpit furniture that talks to Create's redstone links, so your Simulated airship can be flown from a proper helm."
	]
	quest.89B07B50FD3F39D5.quest_subtitle: "A brass station for airship controls"
	quest.89B07B50FD3F39D5.title: "&eControl Desk"
	quest.8A2AA6D21CE33746.quest_desc: [
		"Okaara is a little heavier than Earth. Violet light. Optional chart jump."
		""
		"You need &6Okaara&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.8A2AA6D21CE33746.quest_subtitle: "Love's world"
	quest.8A2AA6D21CE33746.title: "&dOkaara"
	quest.8AD6F3746C853B7E.quest_desc: [
		"Kill a Lion. Naturalist's predators are the dangerous side of this wildlife pass."
		""
		"You need &6Lion&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.8AD6F3746C853B7E.quest_subtitle: "A hunt worth the scars"
	quest.8AD6F3746C853B7E.title: "&cLion"
	quest.8CBA9DD5C5D6C963.quest_desc: [
		"Craft a Copycat Catwalk from three Copycat Boards."
		"Three Copycat Boards in a V make a Copycat Catwalk."
	]
	quest.8CBA9DD5C5D6C963.quest_subtitle: "Three boards"
	quest.8CBA9DD5C5D6C963.title: "&eCopycat Catwalk"
	quest.8F06D1E57CCAD230.quest_desc: [
		"Bind &eRing On / Off&r under Controls (this pack leaves Create: Lanterns on &eG&r). Lighting it never opens the star chart; that is a separate key, default &eN&r, and only works in orbit."
		""
		"Double-jump to take off. Double-tap forward to shift up, tap back to shift down. A lit ring also lets you breathe underwater. Hold the Construct Wheel for hard-light copies of what you look at."
	]
	quest.8F06D1E57CCAD230.quest_subtitle: "Double-jump to fly"
	quest.8F06D1E57CCAD230.title: "&aLight the Ring"
	quest.8F44276950CE5ED7.quest_desc: [
		"Craft an Iron Fishing Rod from two iron ingots, a stick and two string."
		""
		"The existing Aquaculture quest still wants a Neptunium Ingot. This branch is the road that gets you fishing before that."
	]
	quest.8F44276950CE5ED7.quest_subtitle: "Aquaculture's first upgrade"
	quest.8F44276950CE5ED7.title: "&eIron Fishing Rod"
	quest.8F917FE9AD7713F1.quest_desc: [
		"Macaw's Stairs and Balconies adds bulk stairs, loft stairs, balconies, platforms and railings."
	]
	quest.8F917FE9AD7713F1.quest_subtitle: "Bulk stairs, lofts and balconies"
	quest.8F917FE9AD7713F1.title: "&eMacaw's Stairs"
	quest.8FF0498EC9AD13A8.quest_desc: [
		"Craft from a Clipboard, Redstone Link, Stock Ticker and Andesite Casing. Sneak-click a Stock Link or Stock Ticker to bind it to that network, then use it to open a mobile Stock Keeper menu."
		"Order from the field; the network still packs at the linked inventories and the bees, chains or planes still have to carry the boxes."
	]
	quest.8FF0498EC9AD13A8.quest_subtitle: "A Stock Keeper in your pocket"
	quest.8FF0498EC9AD13A8.title: "&ePortable Stock Ticker"
	quest.904F9907B902E168.quest_desc: [
		"Craft from a Stock Link, an iron ingot and redstone. Bind it like a ticker: right-click a Stock Link before placement."
		"Right-click to set the order, or right-click a Stock Keeper with the requester in hand to configure it first. Every redstone pulse submits that order. Hold &eW&r over it in EMI."
	]
	quest.904F9907B902E168.quest_subtitle: "The same order, on a pulse"
	quest.904F9907B902E168.title: "&eRedstone Requester"
	quest.927478C226F2747D.quest_desc: [
		"Craft a Mechanical Servo from a Sequenced Gearshift, a Precision Mechanism, an Electron Tube and brass ingots."
		"It reports current angle, target angle, sweep range and CW/CCW, so control surfaces on a Simulated contraption can stop where you point them."
	]
	quest.927478C226F2747D.quest_subtitle: "Sweep to a target angle"
	quest.927478C226F2747D.title: "&eMechanical Servo"
	quest.93DD434892DEFB3A.quest_desc: [
		"Fish up one of Aquaculture's fish. Atlantic Cod, Brown Trout, Carp, Perch and Smallmouth Bass are a fair start."
	]
	quest.93DD434892DEFB3A.quest_subtitle: "Not the vanilla cod"
	quest.93DD434892DEFB3A.title: "&eA Proper Catch"
	quest.97460F85E7C36CE0.quest_desc: [
		"Design n' Decor adds Create-styled beams, lamps, stone and containers. Stonecut a Beam from an iron ingot."
	]
	quest.97460F85E7C36CE0.quest_subtitle: "Beams, lamps and stone"
	quest.97460F85E7C36CE0.title: "&eDesign n' Decor"
	quest.9921431009CCBF01.quest_desc: [
		"A Mechanical Mixer with salt and Heavy Cream makes Butter. It is an ingredient in Butter Dough, frostings and a long list of mixer recipes."
	]
	quest.9921431009CCBF01.quest_subtitle: "Salt and Heavy Cream in a mixer"
	quest.9921431009CCBF01.title: "&eButter"
	quest.99321C0755AE100A.quest_desc: [
		"A heated Mechanical Mixer cooks Fried Hoglin Chop from Hoglin Loin, wheat, a Bullet Pepper, a bowl, milk and egg."
		""
		"Hold &eW&r over the Mixer in EMI to see its Ponder."
	]
	quest.99321C0755AE100A.quest_subtitle: "Heated mixer, loin, pepper, milk, egg"
	quest.99321C0755AE100A.title: "&6Fried Hoglin Chop"
	quest.9D2BD899DC946AB7.quest_desc: [
		"Craft a Portable Structure Container from iron ingots, four Transmitters and a Nether Star."
		"Right-click a physical structure to store it in the item, then right-click a block face to place it. Sneak-right-click the ground with an empty one to set down a blueprint printer."
	]
	quest.9D2BD899DC946AB7.quest_subtitle: "Pack the whole airship"
	quest.9D2BD899DC946AB7.title: "&6Portable Structure Container"
	quest.9DD3EE6DADFC26BF.quest_desc: [
		"Sequenced-assemble Coaster Track from a Metal Girder: deploy iron or zinc nuggets twice, then press."
		"Simulated Coasters uses this rail as physics track for carts, not Create train track."
	]
	quest.9DD3EE6DADFC26BF.quest_subtitle: "Girders on a sequenced line"
	quest.9DD3EE6DADFC26BF.title: "&eCoaster Track"
	quest.A040BDC35835DC92.quest_desc: [
		"Craft a Magnetic Gun from copper sheets, brass blocks, Rose Quartz, Electron Tubes, Precision Mechanisms and planks."
		"Hold right-click to pull a Simulated structure up to 24 blocks away, scroll to change distance, and left-click to launch it. Hold Tab while dragging to rotate."
	]
	quest.A040BDC35835DC92.quest_subtitle: "Drag a physical structure"
	quest.A040BDC35835DC92.title: "&eMagnetic Gun"
	quest.A3976C030EB9ED90.quest_desc: [
		"Do the charging ritual at a Lantern of your light. Stay within a few blocks while it fills. An empty ring fills in a couple of seconds once the link forms."
		""
		"A lantern holds about ten full rings and only refills at a &eCentral Power Battery&r. Indigo bearers can charge from a lantern of any colour."
	]
	quest.A3976C030EB9ED90.quest_subtitle: "Stay close to your lantern"
	quest.A3976C030EB9ED90.title: "&aCharge"
	quest.A62C252EFB0AD04C.quest_desc: [
		"Obtain Shulker Meat. Eating it applies Levitation. A heated Mixer uses it in Ender Noodle; a Cooking Pot also makes Shulker Soup and Stir Fried Shulker Meat."
	]
	quest.A62C252EFB0AD04C.quest_subtitle: "Levitates when eaten"
	quest.A62C252EFB0AD04C.title: "&eShulker Meat"
	quest.A719DDD456CE6C23.quest_desc: [
		"Craft a Gyroscope from a Flywheel and a Gimbal Sensor."
		"Jade reports stability, stiffness on X and Z, and whether the gyro is Level, Steady, Underpowered or Unstable, so you can trim a Simulated hull that wants to roll."
	]
	quest.A719DDD456CE6C23.quest_subtitle: "Keep the hull steady"
	quest.A719DDD456CE6C23.title: "&eGyroscope"
	quest.A968B40C7CDF90ED.quest_desc: [
		"Stonecut Brass Glass Casing into Brass Clear Glass Casing."
		"The clear variant is the stepping stone to glowing casings."
	]
	quest.A968B40C7CDF90ED.quest_subtitle: "Stonecut the glass casing"
	quest.A968B40C7CDF90ED.title: "&eBrass Clear Glass Casing"
	quest.AC145C759C3F2F20.quest_desc: [
		"You've sampled shaping tools, Macaw's set, furniture, Create building blocks, framed glass, Quark, Supplementaries and the arts mods."
		"That's a builder's toolkit."
	]
	quest.AC145C759C3F2F20.quest_subtitle: "Every branch of the guild"
	quest.AC145C759C3F2F20.title: "&6Master Builder"
	quest.AC6D1144046E925C.quest_desc: [
		"Run the Wrapping Station with a gift (the recipe accepts examples like a Diamond, an Apple or Dirt) and Red Wrapping Paper."
		"The station outputs a Red Present. Dye the paper first if you want a different colour of box."
	]
	quest.AC6D1144046E925C.quest_subtitle: "Gift in, paper on"
	quest.AC6D1144046E925C.title: "&6Red Present"
	quest.ADD8605C314455A8.quest_desc: [
		"Korugar is hotter and heavier than Oa. Yellow light. The watchtower and fear spire are why you came."
		""
		"Optional. The same chart jump as Oa, paid from the ring."
	]
	quest.ADD8605C314455A8.quest_subtitle: "Sinestro's watchtower"
	quest.ADD8605C314455A8.title: "&eKorugar"
	quest.AFE9BC94ADB895CF.quest_desc: [
		"Find an upgraded Monster Room from YUNG's Better Dungeons."
		""
		"You need &6Monster Room&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.AFE9BC94ADB895CF.quest_subtitle: "YUNG's Better Dungeons"
	quest.AFE9BC94ADB895CF.title: "&eMonster Room"
	quest.B238629468C0C708.quest_desc: [
		"A lit ring leaves a world at the same height a Northstar rocket does. For a few seconds after you arrive in orbit you are held a hundred blocks above the floor so the climb cannot dump you back into loading terrain."
		""
		"The chart opens itself in orbit. Default key &eN&r brings it back. Hold a landable world for a second to jump; the hover text is the ring price. Earth, the Moon, Mercury, Venus, Mars, and the seven Lantern worlds have surfaces. Ganymede and the rest are telescope-only."
	]
	quest.B238629468C0C708.quest_subtitle: "Fly a lit ring into orbit"
	quest.B238629468C0C708.title: "&bThe Star Chart"
	quest.B2BA4FF8FF1745A3.quest_desc: [
		"Look at a Brown Bear. Give it room; this quest only asks you to see one."
		""
		"You need &6Brown Bear&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.B2BA4FF8FF1745A3.quest_subtitle: "Give it space"
	quest.B2BA4FF8FF1745A3.title: "&eBrown Bear"
	quest.B3A4EA50C7FC0B3A.quest_desc: [
		"Surround an Elytra Piece with eight Windmill Sails to make three Wing Meshes."
		"Dye the mesh if you want a coloured glider; you will need seven of them for the mechanical craft."
	]
	quest.B3A4EA50C7FC0B3A.quest_subtitle: "Sails around an Elytra Piece"
	quest.B3A4EA50C7FC0B3A.title: "&eWing Mesh"
	quest.B406538F83260261.quest_desc: [
		"Run a &eRing Blank&r through sequenced assembly: spout 30 mB molten gold, deploy a &ePolished Rose Quartz&r, press. Loop that three times."
		""
		"Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.B406538F83260261.quest_subtitle: "Gold, rose quartz, three loops"
	quest.B406538F83260261.title: "&eRing Band"
	quest.B7B9C5BB0AC8DBD3.quest_desc: [
		"Craft six Pipe Bases from a Fluid Pipe standing on a copper ingot."
		"Every Sound of Steam rank (Diapason, Gedeckt, Piccolo and the rest) sits on one of these."
	]
	quest.B7B9C5BB0AC8DBD3.quest_subtitle: "Copper on a fluid pipe"
	quest.B7B9C5BB0AC8DBD3.title: "&ePipe Base"
	quest.B8EAEA40968FD15A.quest_desc: [
		"Find a Better Desert Temple. Vanilla pyramids are replaced."
		""
		"You need &6Desert Temple&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.B8EAEA40968FD15A.quest_subtitle: "YUNG's Better Desert Temples"
	quest.B8EAEA40968FD15A.title: "&eDesert Temple"
	quest.B96B00AB1D920AAE.quest_desc: [
		"A heated Mechanical Mixer cooks Cave Soup from a Cave Carrot, a red mushroom, two brown mushrooms and a bowl."
		""
		"Hold &eW&r over the Mixer in EMI to see its Ponder."
	]
	quest.B96B00AB1D920AAE.quest_subtitle: "Heated mixer, mushrooms, a bowl"
	quest.B96B00AB1D920AAE.title: "&6Cave Soup"
	quest.BA80267E2152C1A5.quest_desc: [
		"You already placed a Market Terminal in To Know. Craft a Remote from that terminal, iron nuggets, redstone and an ender pearl to open the Stock Market from anywhere."
		"The terminal and remote list shops, prices, owners and dimensions from every Table Cloth and Tradeworks shelf the mod has scanned."
	]
	quest.BA80267E2152C1A5.quest_subtitle: "The stock exchange in your hand"
	quest.BA80267E2152C1A5.title: "&eMarket Remote"
	quest.BC307ABA2A7D93EA.quest_desc: [
		"The overworld has new animals to spot. Naturalist adds deer, bears, lions and more; Ecologics adds penguins, squirrels and coconut crabs."
		""
		"Look at them to log the sighting. Craft a Capture Net from bamboo and string when you want the tool."
	]
	quest.BC307ABA2A7D93EA.quest_subtitle: "Naturalist and Ecologics fill the biomes"
	quest.BC307ABA2A7D93EA.title: "&aNew Wildlife"
	quest.BC8C337551761EEA.quest_desc: [
		"Mechanical-craft a Mechanical Spawner from Brass Casings and sheets, Shafts, chains, Netherite, an End Crystal, a Totem of Undying and a Precision Mechanism."
		"It needs rotational force, a supply of Potion of Regeneration as liquid, and a Soul Catcher inside. Stress depends on the mob. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.BC8C337551761EEA.quest_subtitle: "Regen, rotation, soul"
	quest.BC8C337551761EEA.title: "&6Mechanical Spawner"
	quest.BE27AC4BFFA136BD.quest_desc: [
		"Craft a Tracker Bar from two Brass Casings, two Shafts and a Precision Mechanism."
		"Brass Casings, Shafts and a Precision Mechanism: the kinetic half of Sound of Steam, next to the brass speaker on this chapter."
	]
	quest.BE27AC4BFFA136BD.quest_subtitle: "Brass player for music rolls"
	quest.BE27AC4BFFA136BD.title: "&6Tracker Bar"
	quest.C1973FEE5FA9FC3D.quest_desc: [
		"Look at a Penguin. Ecologics also adds Squirrels and Coconut Crabs on this pass."
		""
		"You need &6Penguin&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.C1973FEE5FA9FC3D.quest_subtitle: "Ecologics on the ice"
	quest.C1973FEE5FA9FC3D.title: "&ePenguin"
	quest.C2EB2DEE1DD40D50.quest_desc: [
		"Mechanical-craft a Rope Connector Launcher from Polished Cut Asurine Slabs, Andesite Alloy, a Precision Mechanism and Fluid Pipes."
		"Keep a Throwable Rope Connector in the other hand as ammo; the launcher fires the coupling instead of throwing it by hand."
	]
	quest.C2EB2DEE1DD40D50.quest_subtitle: "Handheld grappling gun"
	quest.C2EB2DEE1DD40D50.title: "&eRope Connector Launcher"
	quest.C389B03709865706.quest_desc: [
		"Craft from a Large Cogwheel and four Andesite Casing. Right-click two conveyors with chains to connect them; they relay rotation and also take shafts above or below."
		"Frogports hang off a nearby conveyor. Right-click holding a wrench to travel on the chain; at a junction, face the chain you want to follow. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.C389B03709865706.quest_subtitle: "Power, packages, and a ride"
	quest.C389B03709865706.title: "&eChain Conveyor"
	quest.C3F56E25F5330A7F.quest_desc: [
		"Run sequenced assembly on a Kart Chassis: four Kart Wheels, a Bumper, a Kart Seat, four Kart Exhausts, then the Kart Motor."
		"The line always finishes a Red Kart; dye it on a Deployer or in a crafting grid if you want another colour."
	]
	quest.C3F56E25F5330A7F.quest_subtitle: "Eleven deployer steps"
	quest.C3F56E25F5330A7F.title: "&6Red Kart"
	quest.C4142315CB6C3603.quest_desc: [
		"Craft a Mechanical Insolator from Dirt (or another dirt block), Copper Casing and a Mechanical Pump."
		"Throw or insert plants at the top. Hold &eW&r over it in EMI to see its Ponder."
	]
	quest.C4142315CB6C3603.quest_subtitle: "Dirt, copper casing, pump"
	quest.C4142315CB6C3603.title: "&6Mechanical Insolator"
	quest.C67D9003C0121836.quest_desc: [
		"Mechanical-craft a Kart Motor from Pieces of Train Casing, a Steam Engine, a Vertical Gearbox, Cogwheels, a Shaft, Fluid Pipes, brass plates, glass and a Precision Mechanism."
		"It is the last deployer step on the kart assembly line."
	]
	quest.C67D9003C0121836.quest_subtitle: "Steam engine in a train casing"
	quest.C67D9003C0121836.title: "&eKart Motor"
	quest.C6B7DE33AECCB2B3.quest_desc: [
		"Create: Tradeworks adds wood and metal shelves (oak slabs plus Andesite Alloy for an Oak Shelf) and inverted table cloths stonecut from Create's cloths. They are table cloths, so they take the same shop trades."
		"Create: Stock Market scans Table Cloths and Tradeworks shelves for its live shop list. Stock a shelf the same way you stock a cloth."
	]
	quest.C6B7DE33AECCB2B3.quest_subtitle: "Shop displays that the market can see"
	quest.C6B7DE33AECCB2B3.title: "&eTradeworks Shelves"
	quest.C71C583226F93AD1.quest_desc: [
		"Craft six Windchests from Oak Planks, a Spruce Slab, Redstone Dust and a Fluid Pipe."
		"Pipes can sit on Windchests or Fluid Tanks. Hold &eW&r over a Windchest in EMI to see its Ponder."
	]
	quest.C71C583226F93AD1.quest_subtitle: "Toggle many pipes at once"
	quest.C71C583226F93AD1.title: "&eWindchest"
	quest.C7D69ABDC52B604C.quest_desc: [
		"Craft a Capture Net from three bamboo and three string. It is a tool with 64 uses."
		""
		"You need &6Capture Net&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.C7D69ABDC52B604C.quest_subtitle: "Bamboo, string, and a swing"
	quest.C7D69ABDC52B604C.title: "&eCapture Net"
	quest.C8806E26ACA02FED.quest_desc: [
		"Look at a Red Panda. Otters, Dragonflies and Jumping Spiders are other Critters sightings."
	]
	quest.C8806E26ACA02FED.quest_subtitle: "A quiet companion"
	quest.C8806E26ACA02FED.title: "&eRed Panda"
	quest.C9463CF0B2340410.quest_desc: [
		"Deep Dark gear, an Aquatic Ambitions Conduit Cage, and a Cataclysm boss down. Create's chain is how you got strong enough."
		""
		"Tick this when Cataclysm Conquered is done and the conduit cage has spun."
	]
	quest.C9463CF0B2340410.quest_subtitle: "Echo, ocean, Cataclysm"
	quest.C9463CF0B2340410.title: "&2Into the Deep"
	quest.CEB3AD57B7D4E9D6.quest_desc: [
		"Craft a &eLantern Frame&r from four brass sheets, a gold ingot and three &eFramed Glass&r."
		""
		"A spout can fill the frame with a bucket of that light's liquid to make the matching Lantern. You can also craft a Lantern whole at a table."
	]
	quest.CEB3AD57B7D4E9D6.quest_subtitle: "Brass, gold and framed glass"
	quest.CEB3AD57B7D4E9D6.title: "&eLantern Frame"
	quest.CEDFC674A03C855E.quest_desc: [
		"Copycats+ adds copycat stairs, doors, pipes and more that take another block's look. Stonecut a Copycat Block from a zinc ingot."
		"Right-click with a material to assign and rotate it; wrench to remove the material."
	]
	quest.CEDFC674A03C855E.quest_subtitle: "Zinc shapes that mimic any block"
	quest.CEDFC674A03C855E.title: "&eCopycats+"
	quest.CFE3DE0094FE5E20.quest_desc: [
		"Craft sixteen Brass Bars from six brass ingots, or stonecut four from one ingot."
		"Create Deco uses them as the lattice for catwalks, railings and stairs in brass."
	]
	quest.CFE3DE0094FE5E20.quest_subtitle: "Six ingots, sixteen bars"
	quest.CFE3DE0094FE5E20.title: "&eBrass Bars"
	quest.D2C578BE5932D540.quest_desc: [
		"Craft a Kart Wheel from a Cogwheel and a Mechanical Belt."
		"You will deploy four of them onto the chassis during sequenced assembly."
	]
	quest.D2C578BE5932D540.quest_subtitle: "Cogwheel plus belt"
	quest.D2C578BE5932D540.title: "&eKart Wheel"
	quest.D59506D6568E798B.quest_desc: [
		"Craft a Pneumatic Rod from two brass plates, a Fluid Pipe, a Shaft and a Fluid Tank."
		"It is a linear actuator for Simulated contraptions: Create fluid parts pushing a shaft instead of spinning it."
	]
	quest.D59506D6568E798B.quest_subtitle: "Pipe, shaft and tank"
	quest.D59506D6568E798B.title: "&ePneumatic Rod"
	quest.D80E6D08A324EDC6.quest_desc: [
		"Craft a Diapason from two zinc ingots over a Pipe Base, or stonecut it from a Prestant."
		"Place it on a configured Windchest; it sounds when that chest is active and the pipe itself is powered."
	]
	quest.D80E6D08A324EDC6.quest_subtitle: "The principal zinc rank"
	quest.D80E6D08A324EDC6.title: "&eDiapason"
	quest.D833332900D31618.quest_desc: [
		"Craft a Wrench Handle Augment from four Andesite Alloy around any smithing trim template."
		"Extended Wrenches swaps this onto a Create wrench so the handle can be wood, stone or Create materials."
	]
	quest.D833332900D31618.quest_subtitle: "Andesite around a trim"
	quest.D833332900D31618.title: "&eWrench Handle Augment"
	quest.D913C01BF5DC7ABE.quest_desc: [
		"Craft a Coaster Cart from a Shaft, a Block of Industrial Iron, four Dried Kelp and a wooden slab."
		"Ride it on Coaster Track. A Red Balloon can lift a sublevel slightly off the ground and stand it upright if you need to stage the ride."
	]
	quest.D913C01BF5DC7ABE.quest_subtitle: "Kelp seats on industrial iron"
	quest.D913C01BF5DC7ABE.title: "&6Coaster Cart"
	quest.D9C3393FFAD06343.quest_desc: [
		"Right-click a Train Station and place a Postbox nearby, then assign it an address. Trains collect packages that do not match and drop off ones that do."
		"Like trains, Postboxes keep working in unloaded chunks. Craft any colour from Andesite Alloy, a barrel and dye. Hold &eW&r over a Postbox in EMI to see its Ponder."
	]
	quest.D9C3393FFAD06343.quest_subtitle: "The same addresses, on a train"
	quest.D9C3393FFAD06343.title: "&ePostbox"
	quest.D9D1DBAE2462AA9A.quest_desc: [
		"Craft a Mechanical Composter from seven wooden slabs, a Cogwheel and Andesite Casing."
		"It runs Create composting recipes: leaves and seeds have a 30% chance to make Compost, cactus and vines 50%, cake or pumpkin pie 100%."
	]
	quest.D9D1DBAE2462AA9A.quest_subtitle: "Slabs around Andesite Casing"
	quest.D9D1DBAE2462AA9A.title: "&eMechanical Composter"
	quest.D9FE4B51CAA33441.quest_desc: [
		"A Mechanical Mixer over a superheated basin recasts a ring: the old ring, a &eRing Band&r, and 250 mB of that light's liquid. Forged too cool it comes out Flawed and holds less charge; white-hot it comes out Masterwork and holds more."
		""
		"You cannot mix a first ring from nothing. The first one still has to find you."
	]
	quest.D9FE4B51CAA33441.quest_subtitle: "Recast the ring you already have"
	quest.D9FE4B51CAA33441.title: "&6The Great Foundry"
	quest.DBE64D3FDFAD0004.quest_desc: [
		"Create Encased recases kinetic blocks in extra materials."
		"Craft or deploy a brass sheet onto an Encased Fan to make a Brass Encased Fan."
	]
	quest.DBE64D3FDFAD0004.quest_subtitle: "Recase fans and kinetics"
	quest.DBE64D3FDFAD0004.title: "&eCreate Encased"
	quest.DCFBD9CCB3B0B8DB.quest_desc: [
		"Exposure adds a Camera that exposes film frames. Sneak-use the Camera to configure it, then develop and print at a Lightroom."
	]
	quest.DCFBD9CCB3B0B8DB.quest_subtitle: "Camera, film and Lightroom"
	quest.DCFBD9CCB3B0B8DB.title: "&eExposure"
	quest.DDC7AE5135E98F4A.quest_desc: [
		"Ysmault's air is sulfuric acid at 45 °C. The ring covers the atmosphere while it is lit. Red light lives here."
	]
	quest.DDC7AE5135E98F4A.quest_subtitle: "Rage, acid air"
	quest.DDC7AE5135E98F4A.title: "&cYsmault"
	quest.DECC1D44AD96A123.quest_desc: [
		"&eLoot Chest&r. Complete it by obtaining &6Loot Chest&r."
		""
		"Look the item up in &dEMI&r (try @ and the mod id). For Create machines, hold &eW&r to ponder the setup."
		""
		"This chapter is optional — leave and come back whenever you want."
	]
	quest.DECC1D44AD96A123.quest_subtitle: "Your own loot, every time"
	quest.DECC1D44AD96A123.title: "&eLoot Chest"
	quest.E2F24F442A4E2E31.quest_desc: [
		"Craft an Empty Soul Catcher from four brass plates, two Shulker Shells, Brass Casing, a Nether Star and a Cogwheel."
		"Right-click a mob that has Weakness to capture its soul. Bosses, players, blacklisted mobs, and anything still too healthy will refuse."
	]
	quest.E2F24F442A4E2E31.quest_subtitle: "Weakness, then right-click"
	quest.E2F24F442A4E2E31.title: "&eEmpty Soul Catcher"
	quest.E3E16FF44675E8E7.quest_desc: [
		"Craft two Track Anchorpoints from a Metal Girder over a Block of Industrial Iron."
		"Pin the coaster rail to a Simulated structure so the track stays with the physics hull."
	]
	quest.E3E16FF44675E8E7.quest_subtitle: "Girder on industrial iron"
	quest.E3E16FF44675E8E7.title: "&eTrack Anchorpoint"
	quest.E4ADC4CC8A289E86.quest_desc: [
		"Find a Spider Cave, one of YUNG's larger dungeon types. A Zombie Catacomb and a Skeleton dungeon exist too if you keep exploring."
	]
	quest.E4ADC4CC8A289E86.quest_subtitle: "Cobweb entanglement"
	quest.E4ADC4CC8A289E86.title: "&eSpider Cave"
	quest.E4E7D06866377705.quest_desc: [
		"Craft a Mounted Rope Launcher from the handheld launcher, two Rope Couplings, a Rope Winch and Polished Cut Asurine Slabs."
		"Right-click with a Throwable Rope Connector to load, then mount it. Left-click fires, right-click releases the anchor, sneak dismounts. Redstone on the red marker fires saved aim; the amber marker releases."
	]
	quest.E4E7D06866377705.quest_subtitle: "Ship-mounted grapple"
	quest.E4E7D06866377705.title: "&6Mounted Rope Launcher"
	quest.E86772A38B213606.quest_desc: [
		"Craft a Pneumatic Regulator from four Brass Casings, a Chute, two Electron Tubes, an Encased Fan and a Precision Mechanism."
		"It sits with the rods as the control block for this pneumatic linkage set, using Create fans and chutes to meter the line."
	]
	quest.E86772A38B213606.quest_subtitle: "Fan, chute and brass casings"
	quest.E86772A38B213606.title: "&6Pneumatic Regulator"
	quest.E9B510AA45BA02FD.quest_desc: [
		"Mechanical-craft a Joystick from a Redstone Link, a Precision Mechanism, a Shaft and brass ingots."
		"It is the analogue stick for Aeroworks modules: hat switches and sockets live on the Control Desk beside it."
	]
	quest.E9B510AA45BA02FD.quest_subtitle: "Mechanical-crafted stick"
	quest.E9B510AA45BA02FD.title: "&eJoystick"
	quest.EA71BB321A31CC79.quest_desc: [
		"Look at a Ferret. Critters and Companions adds small friends and a few tools worth crafting once you have Silk."
	]
	quest.EA71BB321A31CC79.quest_subtitle: "Critters and Companions"
	quest.EA71BB321A31CC79.title: "&eFerret"
	quest.EB076E54F0BD26B2.quest_desc: [
		"Craft a Tackle Box from iron ingots, an iron block, a chest, and two green ingredients (green dye, kelp or Algae)."
	]
	quest.EB076E54F0BD26B2.quest_subtitle: "Hooks and bait in one block"
	quest.EB076E54F0BD26B2.title: "&eTackle Box"
	quest.EC3AB313CE118F29.quest_desc: [
		"Craft a Neptunium Fishing Rod once you have Neptunium. The Exploration quest Aquaculture is the ingot; this is the rod that uses it."
	]
	quest.EC3AB313CE118F29.quest_subtitle: "After the Neptunium Ingot"
	quest.EC3AB313CE118F29.title: "&6Neptunium Rod"
	quest.EC6C5A86F76335F0.quest_desc: [
		"Assemble a train, open Steam 'n' Rails schedules with a Navigator, and plant Waystones at the stations so the crew can jump the last mile."
		""
		"Tick this when two stations run on a schedule and a Waystone sits at each end."
	]
	quest.EC6C5A86F76335F0.quest_subtitle: "Trains, schedules, waystones"
	quest.EC6C5A86F76335F0.title: "&8The Iron Network"
	quest.ED1AC99019DB598F.quest_desc: [
		"Mix four pulpifiable items (bamboo, sugar cane or a sapling) with water in a Mechanical Mixer to make Pulp, then press it on a Mechanical Press."
		"A Packager given redstone power wraps the attached inventory into a cardboard package. Insert a package to unpack it; it will refuse a package it cannot fully unpack. Hold &eW&r over the Packager in EMI to see its Ponder."
	]
	quest.ED1AC99019DB598F.quest_subtitle: "The wrapping every package is made of"
	quest.ED1AC99019DB598F.title: "&eCardboard"
	quest.EE1C1EC8CF2DE3F4.quest_desc: [
		"Zamaron sits between Oa and Korugar in gravity. Indigo light. Optional chart jump."
		""
		"You need &6Zamaron&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.EE1C1EC8CF2DE3F4.quest_subtitle: "Compassion's world"
	quest.EE1C1EC8CF2DE3F4.title: "&5Zamaron"
	quest.EEBFF0EA2A349689.quest_desc: [
		"Craft two from a Stock Link and a Precision Mechanism. On a Packager it monitors that inventory and restocks it; on a board it monitors the whole network. Right-click with the item to watch, hold right-click to set the target amount."
		"Connect ingredient gauges in the UI, give them an address, and it ships inputs whenever stock is low. A detected crafting-table recipe can auto-arrange into a wrenched 3x3 of Mechanical Crafters. Send outputs back to a linked inventory; a Re-Packager keeps input boxes from fragmenting. Hold &eW&r over it in EMI."
	]
	quest.EEBFF0EA2A349689.quest_subtitle: "Keep stock, then craft by itself"
	quest.EEBFF0EA2A349689.title: "&aFactory Gauge"
	quest.F0CB884AF406AA84.quest_desc: [
		"Craft from planks, sticks and an emerald. Right-click it near villagers; if none are available it says it could not find a trader."
		"This is NPC trade, not a player shop. Keep it next to a village while your Table Cloths handle player-to-player sales."
	]
	quest.F0CB884AF406AA84.quest_subtitle: "Every nearby villager, one counter"
	quest.F0CB884AF406AA84.title: "&eTrading Post"
	quest.F11CE15E4648EC04.quest_desc: [
		"Apply Prismarine Crystals to Brass Clear Glass Casing (or use a Deployer)."
		"The block lights at level 15. Applying it onward with a Deployer makes Train Illumination Casing."
	]
	quest.F11CE15E4648EC04.quest_subtitle: "Light level 15"
	quest.F11CE15E4648EC04.title: "&6Brass Illumination Casing"
	quest.F1F89ECDA3D91B09.quest_desc: [
		"A heated Mechanical Mixer with salt, milk and Vinegar makes a Cheese Block. A heated Mechanical Press can compact the same three into a block."
		""
		"Cut the block on a Cutting Board or Slicer for slices."
	]
	quest.F1F89ECDA3D91B09.quest_subtitle: "Salt, milk and vinegar, heated"
	quest.F1F89ECDA3D91B09.title: "&6Cheese Block"
	quest.F450B24BA30E5A02.quest_desc: [
		"Wear any of the seven working lights: &aWill&r, &cRage&r, &6Avarice&r, &eFear&r, &bHope&r, &5Compassion&r or &dLove&r."
		""
		"An unbound ring in survival only stays on someone worthy of that light. A bound ring flies back to its bearer. Joke and unused lights exist as items; they are not a path here."
	]
	quest.F450B24BA30E5A02.quest_subtitle: "Taken from a wreck, or given"
	quest.F450B24BA30E5A02.title: "&eA Ring of Light"
	quest.F66DBD9272935ED1.quest_desc: [
		"Find a Ribbit village. Bring home a Swamp Lantern or a Toadstool if you like the look."
		""
		"You need &6Ribbit Village&r. Recipes and uses show up in &dEMI&r; Create machines ponder with &eW&r."
	]
	quest.F66DBD9272935ED1.quest_subtitle: "Toadstools and swamp lanterns"
	quest.F66DBD9272935ED1.title: "&6Ribbit Village"
	quest.F79ED2AC0EF56443.quest_desc: [
		"Craft a Wrapping Station from seven planks, Paper and an iron ingot."
		"Create: Wrapped's own text: it is used to wrap christmas presents, a kinetic-adjacent packing table rather than a processing machine."
	]
	quest.F79ED2AC0EF56443.quest_subtitle: "Used to wrap christmas presents"
	quest.F79ED2AC0EF56443.title: "&eWrapping Station"
	quest.F7A8760E689216C5.quest_desc: [
		"Craft a Copper Pot from copper ingots, a wooden shovel, and a Water Bucket or Water Cup."
		""
		"Miner's Delight is cave food: Cave Carrots, Copper Cups, and soups that also cook in a heated Mixer."
	]
	quest.F7A8760E689216C5.quest_subtitle: "A small cooking pot"
	quest.F7A8760E689216C5.title: "&eCopper Pot"
	quest.F80F6B4E304EC016.quest_desc: [
		"Craft a Survival Tool Gun around a Magnetic Gun with brass plates, two Electron Tubes and a Precision Mechanism."
		"Press Tab for the menu: save a physical structure to the shared blueprint folder, then use the Tools tab to weld, translate, rotate or disconnect. Load, Delete and No Collision stay locked on this variant."
	]
	quest.F80F6B4E304EC016.quest_subtitle: "Weld, rotate, save blueprints"
	quest.F80F6B4E304EC016.title: "&eSurvival Tool Gun"
	quest.F85BBF324DBD2447.quest_desc: [
		"Handcrafted adds desks, benches, cups and other furnishings. Its Hammer changes the look of blocks."
	]
	quest.F85BBF324DBD2447.quest_subtitle: "Desks, benches and a hammer"
	quest.F85BBF324DBD2447.title: "&eHandcrafted"
	quest.FB575138BF2DA541.quest_desc: [
		"Craft an Elytra Piece from four Phantom Membranes and Popped Chorus Fruit, or crush an Elytra on Crushing Wheels."
		"It is the uncommon core of Ornithopter wing fabric, sitting between Create sails and a wearable glider."
	]
	quest.FB575138BF2DA541.quest_subtitle: "Membrane and chorus"
	quest.FB575138BF2DA541.title: "&eElytra Piece"
	quest.FD27C78C7E8530B8.quest_desc: [
		"Sequenced-assemble a Wrench Head Augment from any smithing trim template: deploy two brass plates, then press."
		"Head, cog and handle augments are how Extended Wrenches restyles Create's wrench without replacing the tool itself."
	]
	quest.FD27C78C7E8530B8.quest_subtitle: "Sequenced brass plates"
	quest.FD27C78C7E8530B8.title: "&6Wrench Head Augment"
	quest.FE82E2E6510D2E19.quest_desc: [
		"Craft a Universal Joint Head from Brass Casing, a Shaft, a Precision Mechanism and two Dried Kelp."
		"Transmission & Linkage (the Aeronautics utility objects pack) uses this brass head so Simulated drivetrains can change angle without a straight shaft."
	]
	quest.FE82E2E6510D2E19.quest_subtitle: "Bend a shaft through kelp"
	quest.FE82E2E6510D2E19.title: "&eUniversal Joint Head"
	quest.FF0B24019FFDAE61.quest_desc: [
		"Place a sign on a Packager. Created packages carry those written lines as their address."
		"Right-click Frogports with a Clipboard to collect their address; clipboards with collected names auto-complete address fields in other UIs. Hold &eW&r over the Packager in EMI for the addressing Ponder."
	]
	quest.FF0B24019FFDAE61.quest_subtitle: "A sign on the Packager names the box"
	quest.FF0B24019FFDAE61.title: "&eAddresses"
	quest.FFADED292129CCCC.quest_desc: [
		"A heated Mechanical Mixer with two sugar, three fruit, a bucket and water makes a Vinegar Bucket. A Spout can fill bottles from the fluid."
		""
		"Slice and Dice is why Farmer's Delight cooking recipes also run in a heated Mixer."
	]
	quest.FFADED292129CCCC.quest_subtitle: "Sugar, fruit, water, heated mixer"
	quest.FFADED292129CCCC.title: "&eVinegar"
